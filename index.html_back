  "Travel旅行": ["travel|旅行","trip|旅程","journey|旅途","tour|观光","vacation|假期","holiday|假日","abroad|在国外","abroad|到国外","passport|护照","visa|签证","ticket|票","luggage|行李","suitcase|行李箱","backpack|背包","map|地图","guide|导游","guidebook|旅游指南","souvenir|纪念品","camera|相机","photo|照片","adventure|冒险","explore|探索","discover|发现","destination|目的地","arrival|到达","departure|出发","itinerary|行程","schedule|时间表","delay|延误","cancel|取消","book|预订","reserve|预约","check in|登记入住","check out|退房","reception|前台","lobby|大堂","elevator|电梯","corridor|走廊","balcony|阳台","view|风景","scenery|景色","landmark|地标","monument|纪念碑","souvenir shop|纪念品店","duty-free|免税的","currency|货币","exchange|兑换","tip|小费","abroad|海外","foreign|外国的","local|当地的","tourist|游客","sightseeing|观光","excursion|短途旅行","expedition|探险","voyage|航程","cruise|邮轮","hitchhike|搭便车","backpack|背包旅行","itinerary|行程表","time zone|时区","jet lag|时差"]
};

function buildCoreVocab(){
  let result = [];
  let id = 1;
  for(let cat in VOCAB_RAW){
    let catName = cat.replace(/[A-Za-z]+/, '').trim();
    VOCAB_RAW[cat].forEach(pair => {
      const parts = pair.split('|');
      const word = parts[0];
      const meaning = parts[1] || '';
      result.push({
        id: id++,
        word: word,
        meaning: meaning,
        category: catName || cat,
        example: `I know the word "${word}".`,
        exampleTrans: `我知道"${word}"这个词。`
      });
    });
  }
  return result;
}

const CORE_VOCAB = buildCoreVocab();

// --- 录音相关 ---
let erMediaRecorder = null;
let erAudioChunks = [];
let erRecognition = null;

function erStartRecording(){
  if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    toast('浏览器不支持录音功能', 'red');
    return;
  }
  navigator.mediaDevices.getUserMedia({ audio: true }).then(stream => {
    erMediaRecorder = new MediaRecorder(stream);
    erAudioChunks = [];
    erMediaRecorder.addEventListener('dataavailable', e => erAudioChunks.push(e.data));
    erMediaRecorder.addEventListener('stop', () => {
      const blob = new Blob(erAudioChunks, { type: 'audio/webm' });
      erState.recordedUrl = URL.createObjectURL(blob);
      stream.getTracks().forEach(t => t.stop());
      erState.recordingStory = false;
      renderModule();
    });
    erMediaRecorder.start();
    erState.recordingStory = true;
    renderModule();
  }).catch(() => {
    toast('无法访问麦克风，请检查权限', 'red');
  });
}

function erStopRecording(){
  if(erMediaRecorder && erMediaRecorder.state !== 'inactive'){
    erMediaRecorder.stop();
  }
}

function erPlayRecording(){
  if(erState.recordedUrl){
    const audio = new Audio(erState.recordedUrl);
    audio.play();
  }
}

function erStartVocabRecording(word){
  if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    toast('浏览器不支持录音功能', 'red');
    return;
  }
  navigator.mediaDevices.getUserMedia({ audio: true }).then(stream => {
    const recorder = new MediaRecorder(stream);
    const chunks = [];
    recorder.addEventListener('dataavailable', e => chunks.push(e.data));
    recorder.addEventListener('stop', () => {
      const blob = new Blob(chunks, { type: 'audio/webm' });
      erState.vocabRecording = { word: word, url: URL.createObjectURL(blob) };
      stream.getTracks().forEach(t => t.stop());
      if(!erState.starsAwarded['vocab_'+word]){
        erState.starsAwarded['vocab_'+word] = true;
        erState.stars += 1;
        addStars(1);
        toast('+1 星！跟读 ' + word + ' ⭐');
      }
      renderModule();
    });
    recorder.start();
    erState.vocabRecording = { word: word, recording: true };
    renderModule();
    setTimeout(() => recorder.stop(), 3000);
  }).catch(() => {
    toast('无法访问麦克风', 'red');
  });
}

// --- 语音输入（造句练习）---
function erStartVoiceInput(pIdx){
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if(!SR){
    toast('浏览器不支持语音输入', 'red');
    return;
  }
  if(erRecognition) erRecognition.stop();
  erRecognition = new SR();
  erRecognition.lang = 'en-US';
  erRecognition.interimResults = false;
  erRecognition.continuous = false;
  erState.patternVoiceListening = true;
  renderModule();
  erRecognition.onresult = (e) => {
    const text = e.results[0][0].transcript;
    erState.patternInput['p'+pIdx] = text;
    erState.patternVoiceListening = false;
    renderModule();
  };
  erRecognition.onerror = () => {
    erState.patternVoiceListening = false;
    renderModule();
    toast('语音识别失败，请重试', 'orange');
  };
  erRecognition.onend = () => {
    erState.patternVoiceListening = false;
    renderModule();
  };
  erRecognition.start();
}

// --- 故事音频 ---
function erPlayFull(){
  const story = ALL_ER_STORIES[erState.storyIdx];
  if(!story) return;
  erState.storyMode = 'full';
  erState.storyPlaying = true;
  if('speechSynthesis' in window){
    speechSynthesis.cancel();
    const text = story.text.replace(/\n/g, ' ');
    const utter = new SpeechSynthesisUtterance(text);
    utter.lang = 'en-US';
    utter.rate = 0.8;
    utter.onend = () => { erState.storyPlaying = false; renderModule(); };
    speechSynthesis.speak(utter);
  }
  renderModule();
}

function erPlaySentence(){
  erState.storyMode = 'sentence';
  erState.storyPlaying = true;
  erSpeakCurrentSent();
  renderModule();
}

function erSpeakCurrentSent(){
  const story = ALL_ER_STORIES[erState.storyIdx];
  if(!story) return;
  const sentences = story.text.split(/\n+/).filter(s => s.trim());
  if(sentences.length === 0) return;
  const idx = erState.storySentIdx % sentences.length;
  if('speechSynthesis' in window){
    speechSynthesis.cancel();
    const utter = new SpeechSynthesisUtterance(sentences[idx]);
    utter.lang = 'en-US';
    utter.rate = 0.75;
    utter.onend = () => {
      setTimeout(() => {
        erState.storySentIdx++;
        if(erState.storyPlaying) erSpeakCurrentSent();
        renderModule();
      }, 1500);
    };
    speechSynthesis.speak(utter);
  }
}

function erStopAudio(){
  erState.storyPlaying = false;
  if('speechSynthesis' in window) speechSynthesis.cancel();
  renderModule();
}

function erNextSent(){
  erState.storySentIdx++;
  if(erState.storyPlaying) erSpeakCurrentSent();
  renderModule();
}

function erPrevSent(){
  erState.storySentIdx = Math.max(0, erState.storySentIdx - 1);
  if(erState.storyPlaying) erSpeakCurrentSent();
  renderModule();
}

function erReplaySent(){
  if(erState.storyPlaying) erSpeakCurrentSent();
}

function erSpeakWord(word){
  if('speechSynthesis' in window){
    speechSynthesis.cancel();
    const utter = new SpeechSynthesisUtterance(word);
    utter.lang = 'en-US';
    utter.rate = 0.6;
    speechSynthesis.speak(utter);
  }
}

function erPlayVocabWord(word){
  erSpeakWord(word);
}

// --- 故事导航 ---
function erNextStory(){
  erState.storyIdx = (erState.storyIdx + 1) % ALL_ER_STORIES.length;
  erState.storySentIdx = 0;
  erState.storyPlaying = false;
  erState.recordedUrl = null;
  erState.recordingStory = false;
  if('speechSynthesis' in window) speechSynthesis.cancel();
  renderModule();
}

function erPrevStory(){
  erState.storyIdx = (erState.storyIdx - 1 + ALL_ER_STORIES.length) % ALL_ER_STORIES.length;
  erState.storySentIdx = 0;
  erState.storyPlaying = false;
  erState.recordedUrl = null;
  erState.recordingStory = false;
  if('speechSynthesis' in window) speechSynthesis.cancel();
  renderModule();
}

function erSwitchTab(tab){
  erState.tab = tab;
  if('speechSynthesis' in window) speechSynthesis.cancel();
  renderModule();
}

// --- 阅读理解答案 ---
function erToggleAnswer(qIdx){
  const key = 'a_' + erState.storyIdx + '_' + qIdx;
  erState.exerciseShown[key] = !erState.exerciseShown[key];
  renderModule();
}

// --- 造句练习 ---
function erSubmitPattern(pIdx){
  const key = 'p_' + erState.storyIdx + '_' + pIdx;
  if(!erState.starsAwarded[key] && erState.patternInput['p'+pIdx] && erState.patternInput['p'+pIdx].trim().length > 5){
    erState.starsAwarded[key] = true;
    erState.stars += 2;
    addStars(2);
    toast('+2 星！完成造句练习 ⭐⭐');
  }
  renderModule();
}

function erTogglePatternRef(pIdx){
  const key = 'r_' + erState.storyIdx + '_' + pIdx;
  erState.patternRefShown[key] = !erState.patternRefShown[key];
  renderModule();
}

// --- 词汇导航 ---
function erNextVocabPage(){
  const maxPage = Math.ceil(CORE_VOCAB.length / erState.vocabPageSize) - 1;
  if(erState.vocabPage < maxPage){
    erState.vocabPage++;
    renderModule();
  }
}

function erPrevVocabPage(){
  if(erState.vocabPage > 0){
    erState.vocabPage--;
    renderModule();
  }
}

function erLearnWord(word){
  if(!erState.vocabLearned[word]){
    erState.vocabLearned[word] = true;
    erState.stars += 1;
    addStars(1);
    toast('+1 星！学会 ' + word + ' ⭐');
  }
  renderModule();
}

// --- 主渲染函数 ---
function renderEngReading(stats, progRing){
  const rec = getModuleRecord(currentDate, 'eng_reading');
  let tasks = TASKS.eng_reading.map(t => {
    const done = !!rec[t.id];
    let extra = '';
    if(t.id === 'story_read' && erState.tab === 'stories'){
      extra = renderStoryTab();
    }
    if(t.id === 'vocab_learn' && erState.tab === 'vocab'){
      extra = renderVocabTab();
    }
    return `<div class="task-card ${done?'done':''}" onclick="toggleTask('eng_reading','${t.id}',${t.points},'${t.title}')">
      <div class="task-check">${done?'✓':''}</div>
      <div class="task-body">
        <div class="task-title">${t.icon} ${t.title}</div>
        <div class="task-desc">${t.desc}</div>
        <div class="task-tags">${t.tags.map(tag=>`<span class="tag">${tag}</span>`).join('')}</div>
        ${extra}
      </div>
      <div class="task-points">${t.points}分</div>
    </div>`;
  }).join('');

  let tabsHtml = `<div class="er-tabs">
    <button class="er-tab ${erState.tab==='stories'?'active':''}" onclick="erSwitchTab('stories')">📖 英文短文专区 (${ALL_ER_STORIES.length}篇)</button>
    <button class="er-tab ${erState.tab==='vocab'?'active':''}" onclick="erSwitchTab('vocab')">🔤 高频核心词汇 (${CORE_VOCAB.length}个)</button>
  </div>`;

  return `${stats}${progRing}
    <div class="module-header"><span class="m-icon">📘</span><div><div class="m-title">英语课外阅读</div><div class="m-desc">4-6年级经典英文短篇 · ${ALL_ER_STORIES.length}篇故事 + ${CORE_VOCAB.length}个核心词汇 · 积分与每日英语互通</div></div></div>
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;padding:8px 12px;background:#FFF9C4;border-radius:8px">
      <span style="font-size:16px">⭐</span><span style="font-size:13px;font-weight:600;color:#F57F17">英语课外阅读累计星星：${erState.stars}颗 ${D.stars?(' | 总星星：'+D.stars):''}</span>
    </div>
    ${tabsHtml}
    ${tasks}
  `;
}

// --- 故事Tab渲染 ---
function renderStoryTab(){
  const story = ALL_ER_STORIES[erState.storyIdx];
  if(!story) return '';
  const sentences = story.text.split(/\n+/).filter(s => s.trim());
  const isPlaying = erState.storyPlaying;
  const mode = erState.storyMode;

  // 生词注释
  const newWordsHtml = story.newWords.map(nw => {
    return `<span class="er-new-word" onclick="erSpeakWord('${nw.w}')" title="${nw.m}">${nw.w}<sup>${nw.m}</sup></span>`;
  }).join(' ');

  // 故事文本（高亮生词）
  let textHtml = story.text;
  story.newWords.forEach(nw => {
    const re = new RegExp('\\b' + nw.w.replace(/[.*+?^${}()|[\]\\]/g,'\\$&') + '\\b', 'gi');
    textHtml = textHtml.replace(re, `<span class="er-new-word-inline" onclick="erSpeakWord('${nw.w}')" title="${nw.m}">${nw.w}<sup class="er-word-note">${nw.m}</sup></span>`);
  });
  textHtml = textHtml.replace(/\n/g, '<br>');

  // 音频控件
  let audioBar = `<div class="er-audio-controls">
    <button class="eng-audio-btn ${mode==='full'&&!isPlaying?'active':''}" onclick="erPlayFull()">🔊 全文音频</button>
    <button class="eng-audio-btn ${mode==='sentence'?'active':''}" onclick="erPlaySentence()">🔁 逐句循环</button>
    <button class="eng-audio-btn stop" onclick="erStopAudio()">⏹️ 停止</button>
    ${isPlaying?'<span class="eng-playing-indicator">▶ 播放中...</span>':''}
  </div>`;

  // 逐句视图
  let sentenceView = '';
  if(mode === 'sentence' && sentences.length > 0){
    const idx = erState.storySentIdx % sentences.length;
    sentenceView = `<div class="er-sentence-view">
      <div class="er-sent-current">📝 ${sentences[idx]}</div>
      <div class="er-sent-nav">
        <button class="er-sent-btn" onclick="erPrevSent()">‹ 上一句</button>
        <span class="er-sent-count">第 ${idx+1} / ${sentences.length} 句</span>
        <button class="er-sent-btn" onclick="erNextSent()">下一句 ›</button>
        <button class="er-sent-btn replay" onclick="erReplaySent()">🔁 重播本句</button>
      </div>
    </div>`;
  }

  // 录音跟读
  let recordingBar = '';
  if(erState.recordingStory){
    recordingBar = `<div class="er-recording-indicator">🔴 录音中... 点击停止 <button class="eng-audio-btn stop" onclick="erStopRecording()">⏹️ 停止录音</button></div>`;
  } else {
    recordingBar = `<div style="margin:8px 0">
      <button class="eng-audio-btn" onclick="erStartRecording()">🎤 录音跟读</button>
      ${erState.recordedUrl?'<button class="eng-audio-btn" onclick="erPlayRecording()">▶️ 播放录音</button>':''}
    </div>`;
  }

  // 阅读理解
  let exerciseHtml = `<div class="er-exercise">
    <div style="font-weight:700;color:var(--green-7);margin-bottom:10px">✅ 阅读理解习题（共${story.comprehension.length}题）</div>`;
  story.comprehension.forEach((ex, i) => {
    const key = 'a_' + erState.storyIdx + '_' + i;
    const shown = erState.exerciseShown[key];
    exerciseHtml += `<div class="er-exercise-item">
      <div class="er-exercise-q">${i+1}. ${ex.q}</div>
      <button class="er-toggle-btn" onclick="erToggleAnswer(${i})">${shown?'📦 收起答案':'📖 查看答案'}</button>
      ${shown?`<div class="er-exercise-a show">✅ ${ex.a}</div>`:''}
    </div>`;
  });
  exerciseHtml += `</div>`;

  // 造句练习
  let patternHtml = `<div class="er-exercise">
    <div style="font-weight:700;color:var(--blue-7);margin-bottom:10px">✏️ 经典句型模仿造句（共${story.patterns.length}个）</div>`;
  story.patterns.forEach((p, i) => {
    const pKey = 'p_' + erState.storyIdx + '_' + i;
    const rKey = 'r_' + erState.storyIdx + '_' + i;
    const awarded = erState.starsAwarded[pKey];
    const refShown = erState.patternRefShown[rKey];
    const inputVal = erState.patternInput['p'+i] || '';
    patternHtml += `<div class="er-pattern-card">
      <div class="er-pattern-formula">📌 ${p.formula}</div>
      <div class="er-pattern-example">原文：${p.example}</div>
      <textarea class="er-pattern-input" placeholder="模仿句型造一个新句子..." 
        oninput="erState.patternInput['p'+${i}]=this.value">${inputVal}</textarea>
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px">
        <button class="eng-audio-btn submit" onclick="erSubmitPattern(${i})">${awarded?'✅ 已完成':'✅ 提交造句'}</button>
        <button class="er-voice-btn ${erState.patternVoiceListening?'listening':''}" onclick="erStartVoiceInput(${i})">${erState.patternVoiceListening?'🎤 识别中...':'🎤 语音输入'}</button>
        <button class="er-toggle-btn" onclick="erTogglePatternRef(${i})">${refShown?'📦 收起参考':'📖 参考例句'}</button>
      </div>
      ${refShown?`<div class="er-pattern-ref show">参考例句：${p.ref.map(r=>'• '+r).join('<br>')}</div>`:''}
    </div>`;
  });
  patternHtml += `</div>`;

  // 导航
  let navBar = `<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
    <button class="eng-audio-btn" onclick="erPrevStory()">‹ 上一篇</button>
    <span style="font-size:12px;color:var(--text-l)">第 ${erState.storyIdx+1} / ${ALL_ER_STORIES.length} 篇</span>
    <button class="eng-audio-btn" onclick="erNextStory()">下一篇 ›</button>
  </div>`;

  return `<div class="tc-extra">
    ${navBar}
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
      <div style="font-size:16px;font-weight:700;color:#333">${story.title}</div>
      <div style="display:flex;gap:6px">
        <span class="er-story-level">${story.level}年级</span>
        <span class="er-story-level" style="background:#E3F2FD;color:#1565C0">${story.category}</span>
      </div>
    </div>
    <div class="er-story-text">${textHtml}</div>
    ${audioBar}
    ${sentenceView}
    ${recordingBar}
    <div class="eng-section">
      <div class="eng-sec-label">📝 生词注释（点击发音）</div>
      <div>${newWordsHtml}</div>
    </div>
    ${exerciseHtml}
    ${patternHtml}
  </div>`;
}

// --- 词汇Tab渲染 ---
function renderVocabTab(){
  const total = CORE_VOCAB.length;
  const start = erState.vocabPage * erState.vocabPageSize;
  const end = Math.min(start + erState.vocabPageSize, total);
  const learnedCount = Object.keys(erState.vocabLearned).length;
  const progress = Math.round(learnedCount / total * 100);

  let navBar = `<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
    <button class="eng-audio-btn" onclick="erPrevVocabPage()" ${erState.vocabPage===0?'disabled style="opacity:.4"':''}>‹ 上一页</button>
    <span style="font-size:12px;color:var(--text-l)">第 ${erState.vocabPage+1} / ${Math.ceil(total/erState.vocabPageSize)} 页 | 已学 ${learnedCount}/${total} (${progress}%)</span>
    <button class="eng-audio-btn" onclick="erNextVocabPage()" ${erState.vocabPage>=Math.ceil(total/erState.vocabPageSize)-1?'disabled style="opacity:.4"':''}>下一页 ›</button>
  </div>`;

  let progressBar = `<div class="er-progress-bar"><div class="er-progress-fill" style="width:${progress}%"></div></div>`;

  // 分类筛选
  let categories = [...new Set(CORE_VOCAB.map(v => v.category))];
  let currentWords = CORE_VOCAB.slice(start, end);

  let grid = `<div class="er-vocab-grid">`;
  currentWords.forEach(v => {
    const learned = erState.vocabLearned[v.word];
    const isRecording = erState.vocabRecording && erState.vocabRecording.word === v.word;
    grid += `<div class="er-vocab-card ${learned?'learned':''}">
      <div class="er-vocab-word">${v.word}</div>
      <div class="er-vocab-phonetic">${v.category}</div>
      <div class="er-vocab-meaning">${v.meaning}</div>
      <div class="er-vocab-example">${v.example}</div>
      <div class="er-vocab-actions">
        <button class="er-vocab-btn" onclick="erPlayVocabWord('${v.word}')">🔊 听</button>
        <button class="er-vocab-btn ${isRecording?'recording':''}" onclick="erStartVocabRecording('${v.word}')">${isRecording?'🔴 录中':'🎤 跟读'}</button>
        <button class="er-vocab-btn" onclick="erLearnWord('${v.word}')">${learned?'✅ 已学':'✓ 标记学会'}</button>
      </div>
    </div>`;
  });
  grid += `</div>`;

  return `<div class="tc-extra">
    ${progressBar}
    ${navBar}
    ${grid}
  </div>`;
}

init();
// PWA Service Worker 注册
if('serviceWorker' in navigator){
  window.addEventListener('load', ()=>{
    navigator.serviceWorker.register('sw.js').catch(()=>{});
  });
}
// 阻止双击缩放
let lastTouchEnd = 0;
document.addEventListener('touchend', e=>{
  const now = Date.now();
  if(now - lastTouchEnd <= 300){ e.preventDefault(); }
  lastTouchEnd = now;
}, { passive: false });
</script>
</body>
</html>
