      goodWords:["蕴含","奇妙","浩瀚","凭空","漫长","演化","自然选择","好奇心"],
      goodSentences:[`在浩瀚的宇宙中，每一个现象背后都有科学的解释。`,`让我们一起保持好奇心，用科学的眼光去观察这个奇妙的世界吧！`],
      corePara:`了解${topic}不仅能满足我们的好奇心，还能帮助我们更好地认识世界、保护环境。`,
      annot:`本文用通俗易懂的语言介绍科学知识，通过举例和解释让读者理解${topic}的奥秘，结尾呼吁保持好奇心。`,
      reflection:`科学真有趣！${topic}里藏着那么多秘密。我以后要多看科普书，多问为什么，用科学的眼光看世界。也许有一天，我也能成为科学家，发现新的奥秘！`
    })},
    {cat:"抒情",topics:["感恩的心","成长的烦恼","童年记忆","梦想的力量","友谊珍贵","家乡的味道","时间的礼物","勇敢的心","母爱如水","父爱如山","师恩难忘","书香伴我","音乐的魔力","画笔下的世界","运动的快乐","旅行的意义","读书的乐趣","写作的喜悦","数学之美","科学之梦","和平的呼唤","自然的恩赐","生命的力量","坚持的力量","失败是成功之母","诚实最可贵","宽容的力量","分享的快乐","帮助他人","团结就是力量","勤奋改变命运","细节决定成败","态度决定一切","学会感恩","珍惜当下","拥抱变化","不怕困难","勇往直前","追逐梦想","不忘初心","方得始终","热爱生活","微笑面对","永不放弃","心存善念"],builder:(topic)=>({
      title:`《${topic}》`,level:"★★",cat:"抒情",
      text:`每当夜深人静的时候，我总会想起关于${topic}的点点滴滴。
${topic}，是生命中最珍贵的礼物。它像一盏明灯，照亮了我前行的道路；它像一阵春风，温暖了我寒冷的心灵；它像一本厚重的书，教会了我人生的道理。
小时候，我不懂得${topic}的意义。随着年龄的增长，我渐渐明白了：${topic}不是理所当然的，它需要我们用心去感受、用行动去珍惜。
有时候，${topic}就在我们身边，只是我们太忙碌而没有注意到。等到失去了，才追悔莫及。所以，让我们从现在开始，好好珍惜身边的${topic}吧。
${topic}，感谢你让我的生命如此美好。`,
      goodWords:["点点滴滴","珍贵","明灯","照亮","春风","厚重","理所当然","追悔莫及","珍惜"],
      goodSentences:[`它像一盏明灯，照亮了我前行的道路；它像一阵春风，温暖了我寒冷的心灵；它像一本厚重的书，教会了我人生的道理。`,`让我们从现在开始，好好珍惜身边的${topic}吧。`],
      corePara:`${topic}不是理所当然的，它需要我们用心去感受、用行动去珍惜。`,
      annot:`本文用排比和比喻抒发对${topic}的感悟，语言优美，感情真挚。结尾呼吁珍惜，点明主题。`,
      reflection:`读完这篇文章，我想到了很多。${topic}确实很珍贵，我以前没有好好珍惜。从现在开始，我要用心感受生活中的每一份美好，不让时间白白流走。`
    })},
  ];
  const generated = [];
  templates.forEach(t=>{
    t.topics.forEach(topic=>{
      generated.push(t.builder(topic));
    });
  });
  return generated;
}

// 合并静态选文和生成选文
const ALL_READING_PASSAGES = [...READING_PASSAGES, ...generateMorePassages()];

function getReadingPassageCount(){
  return ALL_READING_PASSAGES.length;
}

// 阅读状态
let readingState = {dateKey:'', idx:0, reflection:'', showRef:false};

function getTodayPassage(){
  const today = todayStr();
  if(!readingState.dateKey || readingState.dateKey !== today){
    const dayOfYear = Math.floor((new Date(currentDate) - new Date(new Date(currentDate).getFullYear(),0,0)) / 86400000) + 1;
    readingState.idx = dayOfYear % ALL_READING_PASSAGES.length;
    readingState.dateKey = today;
    readingState.reflection = '';
    readingState.showRef = false;
  }
  return ALL_READING_PASSAGES[readingState.idx];
}

function saveReflection(){
  const el = document.getElementById('readingReflection');
  if(el) readingState.reflection = el.value;
}

function toggleReadingRef(){
  readingState.showRef = !readingState.showRef;
  renderModule();
}

function changeReadingPassage(dir){
  readingState.idx = (readingState.idx + dir + ALL_READING_PASSAGES.length) % ALL_READING_PASSAGES.length;
  readingState.reflection = '';
  readingState.showRef = false;
  renderModule();
}

// ===== 趣味游戏数据库（适合10岁儿童）=====
// 游戏状态 - 新的8款游戏
let gameIdx = {word:0, chain:0, sentence:0, numPuzzle:0, math24:0, sudoku:0, goose:0, mathRiddle:0};
let sudokuState = {puzzle:0, board:[], solution:[], given:[], selected:null};
let chainState = {current:'一心一意', input:'', history:['一心一意'], score:0};
let gooseState = {board:[], matched:[], flipped:[], attempts:0, pairs:0};

const GAMES_DATA = {
  word: {
    name: '字词闯关',
    icon: '🔤',
    desc: '形近字、同音字、多音字辨析',
    items: [
      {q:'"一波三___"应该填哪个字？', opts:['折','拆','析','斩'], a:0, explain:'一波三折：比喻事情进行得不顺利，变化很多。折（zhé）是弯曲的意思。'},
      {q:'"___然大悟"应该填哪个字？', opts:['焕','换','恍','晃'], a:2, explain:'恍然大悟：恍然是突然醒悟的样子。恍（huǎng），不是"换"也不是"焕"。'},
      {q:'"画蛇添___"的"添"是什么意思？', opts:['添东西','舔一舔','填进去','挑出来'], a:0, explain:'添（tiān）是增加的意思。画蛇添足=画完蛇又加上脚，比喻多此一举。'},
      {q:'下面哪个字是"安静"的意思？', opts:['躁','噪','燥','静'], a:3, explain:'躁=急躁，噪=吵闹，燥=干燥，静=安静。四个字读音相近但意思完全不同！'},
      {q:'"川流不___"应该填哪个字？', opts:['息','夕','惜','熄'], a:0, explain:'川流不息：息是停止。形容行人、车马等像水流一样连续不断。'},
      {q:'下面哪个词写对了？', opts:['迫不及待','迫不急待','破不及待','迫不及待'], a:0, explain:'迫不及待：及=来得及。意思是急迫得来不及等待。常被错写成"迫不急待"。'},
      {q:'"___雀无声"应该填哪个字？', opts:['雅','鸦','鸭','压'], a:1, explain:'鸦雀无声：鸦和雀都不叫了，形容非常安静。'},
      {q:'"守___待兔"应该填哪个字？', opts:['株','珠','柱','注'], a:0, explain:'守株待兔：株是树桩。守在树桩旁等兔子撞上来，比喻不劳而获。'},
      {q:'下面哪个是正确的？', opts:['名副其实','名符其实','明副其实','名副其实'], a:0, explain:'名副其实：副=相称、符合。名声和实际相符。'},
      {q:'"___苗助长"应该填哪个字？', opts:['拔','拨','泼','跋'], a:0, explain:'拔苗助长：拔（bá），把禾苗拔高帮助它长。比喻急于求成反而坏事。'},
      {q:'"再接再___"应该填哪个字？', opts:['励','厉','利','立'], a:0, explain:'再接再厉：接=接战，厉=奋勉。指继续努力，再加一把劲。'},
      {q:'"___身临其境"应该填哪个字？', opts:['设','色','是','时'], a:0, explain:'设身处地：设=设想，处=处身。指站在别人的立场和角度想问题。'},
      {q:'下面哪个读音错误？', opts:['模(mó)样','模(mú)样','模(mó)型','模(mó)糊'], a:1, explain:'"模样"的"模"读mú，"模型""模糊"的"模"读mó。'},
      {q:'"称___如意"应该填哪个字？', opts:['心','新','辛','欣'], a:0, explain:'称心如意：完全合心意。注意是"称(chèn)心"不是"称(chéng)心"。'},
      {q:'"美___美奂"应该填哪个字？', opts:['仑','轮','伦','论'], a:0, explain:'美轮美奂：轮=高大，奂=众多。形容房屋高大华丽。'}
    ]
  },
  numPuzzle: {
    name: '数字解谜',
    icon: '🔢',
    desc: '图形找规律、口算闯关',
    items: [
      {q:'2, 4, 6, 8, __, 12', a:'10', hint:'每个数比前一个大2'},
      {q:'1, 3, 6, 10, 15, __', a:'21', hint:'每次增加的数多1：+2,+3,+4,+5,+6'},
      {q:'1, 4, 9, 16, 25, __', a:'36', hint:'这些数都是完全平方数：1²,2²,3²,4²,5²,6²'},
      {q:'2, 6, 18, 54, __', a:'162', hint:'每个数是前一个的3倍'},
      {q:'1, 1, 2, 3, 5, 8, __', a:'13', hint:'斐波那契数列！每个数=前两个数之和'},
      {q:'3, 6, 12, 24, __', a:'48', hint:'每个数是前一个的2倍'},
      {q:'100, 95, 90, 85, __', a:'80', hint:'每个数比前一个少5'},
      {q:'1, 2, 4, 8, 16, __', a:'32', hint:'每个数是前一个的2倍'},
      {q:'25+37-12=?', a:'50', hint:'加法先算：25+37=62，再减12=50'},
      {q:'96÷8+5=?', a:'17', hint:'先算除法：96÷8=12，再加5=17'},
      {q:'12×5-30=?', a:'30', hint:'先算乘法：12×5=60，再减30=30'},
