// ===== 课外阅读选文库（4-6年级，300篇）=====
// 每篇包含：标题、难度、类别、正文、好词、好句、重点段落标记、批注、参考感悟
const READING_PASSAGES = [
  {title:"《荷塘月色》节选",level:"★★★",cat:"写景",text:"曲曲折折的荷塘上面，弥望的是田田的叶子。叶子出水很高，像亭亭的舞女的裙。层层的叶子中间，零星地点缀着些白花，有袅娜地开着的，有羞涩地打着朵儿的；正如一粒粒的明珠，又如碧天里的星星。微风过处，送来缕缕清香，仿佛远处高楼上渺茫的歌声似的。",goodWords:["曲曲折折","弥望","田田","亭亭","袅娜","羞涩","零星","缕缕清香","渺茫"],goodSentences:["叶子出水很高，像亭亭的舞女的裙。","正如一粒粒的明珠，又如碧天里的星星。","微风过处，送来缕缕清香，仿佛远处高楼上渺茫的歌声似的。"],corePara:"微风过处，送来缕缕清香，仿佛远处高楼上渺茫的歌声似的。",annot:"本文用比喻和通感手法，将荷叶比作舞女的裙，将清香比作渺茫的歌声，调动视觉和嗅觉，营造出宁静优美的意境。",reflection:"作者笔下的荷塘如梦如幻。我仿佛也站在了荷塘边，闻到了那缕缕清香。那亭亭的荷叶像舞女的裙，多美啊！这让我想到，生活中并不缺少美，而是缺少发现美的眼睛。只要用心感受，一池荷花也能成为最美的风景。"},
  {title:"《春》节选",level:"★★",cat:"写景",text:"盼望着，盼望着，东风来了，春天的脚步近了。一切都像刚睡醒的样子，欣欣然张开了眼。山朗润起来了，水涨起来了，太阳的脸红起来了。小草偷偷地从土里钻出来，嫩嫩的，绿绿的。园子里，田野里，瞧去，一大片一大片满是的。坐着，躺着，打两个滚，踢几脚球，赛几趟跑，捉几回迷藏。风轻悄悄的，草软绵绵的。",goodWords:["盼望","欣欣然","朗润","偷偷","嫩嫩","绿绿","轻悄悄","软绵绵"],goodSentences:["一切都像刚睡醒的样子，欣欣然张开了眼。","小草偷偷地从土里钻出来，嫩嫩的，绿绿的。","风轻悄悄的，草软绵绵的。"],corePara:"小草偷偷地从土里钻出来，嫩嫩的，绿绿的。",annot:"朱自清用拟人手法写春天，万物像刚睡醒一样欣欣然。叠词的运用（嫩嫩、绿绿、轻悄悄、软绵绵）让语言充满童趣和节奏感。",reflection:"读完这篇文章，我仿佛感受到了春天的气息。小草偷偷钻出来的样子多可爱啊！作者用了很多叠词，读起来像唱歌一样好听。春天真是一个充满希望的季节，万物复苏，生机勃勃。"},
  {title:"《背影》节选",level:"★★★",cat:"写人",text:"我说道：爸爸，你走吧。他往车外看了看说：我买几个橘子去。你就在此地，不要走动。我看那边月台的栅栏外有几个卖东西的等着顾客。走到那边月台，须穿过铁道，须跳下去又爬上去。父亲是一个胖子，走过去自然要费事些。我本来要去的，他不肯，只好让他去。我看见他戴着黑布小帽，穿着黑布大马褂，深青布棉袍，蹒跚地走到铁道边，慢慢探身下去，尚不大难。可是他穿过铁道，要爬上那边月台，就不容易了。他用两手攀着上面，两脚再向上缩；他肥胖的身子向左微倾，显出努力的样子。这时我看见他的背影，我的泪很快地流下来了。",goodWords:["蹒跚","探身","攀","缩","微倾","努力"],goodSentences:["他用两手攀着上面，两脚再向上缩；他肥胖的身子向左微倾，显出努力的样子。","这时我看见他的背影，我的泪很快地流下来了。"],corePara:"他用两手攀着上面，两脚再向上缩；他肥胖的身子向左微倾，显出努力的样子。",annot:"朱自清通过动作描写（攀、缩、倾）刻画父亲爬月台的艰难，用肥胖的身躯与笨拙的动作形成对比，深沉的父爱在细节中自然流露。",reflection:"读完这段文字，我很感动。父亲虽然胖，行动不便，却坚持要去买橘子给儿子。那些动作——攀、缩、倾——让我看到了一个父亲为了孩子不怕困难的样子。这让我想起我的爸爸，他也总是默默地为我做很多事情。父爱如山，深沉而伟大。"},
  {title:"《落花生》节选",level:"★★",cat:"叙事",text:"我们屋后有半亩隙地。母亲说：让它荒着怪可惜的，你们那么爱吃花生，就开辟出来种花生吧。我们姐弟几个都很高兴，买种，翻地，播种，浇水，没过几个月，居然收获了。母亲说：今晚我们过一个收获节，请你们的父亲也来尝尝我们的新花生，好不好？母亲把花生做成好几样食品，还吩咐就在茅亭里过这个节。那晚上天色不大好，可是父亲也来了，实在很难得。父亲说：你们爱吃花生么？我们都争着答应：爱！谁能把花生的好处说出来？姐姐说：花生的味美。哥哥说：花生可以榨油。我说：花生的价钱便宜，谁都可以买来吃，都喜欢吃。这就是它的好处。父亲说：花生的好处很多，有一样最可贵。它的果实埋在地里，不像桃子、石榴、苹果那样，把鲜红嫩绿的果实高高地挂在枝上，使人一见就生爱慕之心。你们看它矮矮地长在地上，等到成熟了，也不能立刻分辨出来它有没有果实，必须挖起来才知道。",goodWords:["隙地","开辟","播种","收获","爱慕","可贵"],goodSentences:["它的果实埋在地里，不像桃子、石榴、苹果那样，把鲜红嫩绿的果实高高地挂在枝上，使人一见就生爱慕之心。"],corePara:"花生的好处很多，有一样最可贵。它的果实埋在地里，不像桃子、石榴、苹果那样，把鲜红嫩绿的果实高高地挂在枝上，使人一见就生爱慕之心。",annot:"许地山借花生喻人，通过对比花生与桃子、石榴、苹果，突出花生不图虚名、默默奉献的品质，告诉我们要做有用的人，不要做只讲体面的人。",reflection:"花生虽然外表不起眼，但它很有用。这让我明白，做人不能只看外表，要做一个对社会有用的人。就像花生一样，虽然埋在土里不张扬，但果实饱满，价值很大。我以后也要做一个脚踏实地、不图虚名的人。"},
  {title:"《桂花雨》节选",level:"★★",cat:"抒情",text:"桂花盛开的时候，不说香飘十里，至少前后十几家邻居，都没有不浸在桂花香里的。桂花不与繁花斗艳，可是它的香气味儿真是迷人。迷人的不只是香气，还有那摇花的乐趣。摇花对我来说是件大事，所以时时缠着母亲问：妈，怎么还不摇桂花嘛？母亲说：还早呢，桂花不开，花不香，摇不下来的。可是母亲一看天上布满阴云，就知道来台风了，赶紧叫大家提前摇桂花。这下，我可乐了，帮着在桂花树下铺竹席，使劲地摇桂花。桂花纷纷落下来，落得我们满头满身。我喊着：啊！真像下雨！好香的雨呀！母亲突然说：这里的桂花再香，也比不上家乡院子里的桂花。",goodWords:["盛开","浸","迷人","缠","布满阴云","纷纷","满头满身"],goodSentences:["桂花纷纷落下来，落得我们满头满身。","啊！真像下雨！好香的雨呀！"],corePara:"母亲突然说：这里的桂花再香，也比不上家乡院子里的桂花。",annot:"琦君通过回忆童年摇桂花的快乐场景，以桂花为线索寄托思乡之情。最后母亲的一句话点题：他乡再好，也比不上家乡。",reflection:"读完这篇文章，我仿佛闻到了桂花的香气，也看到了桂花像雨一样飘落的场景。母亲最后说的那句话让我很感慨，家乡的东西总是最好的，因为那里有最珍贵的回忆。我也要珍惜家乡的一切。"},
  {title:"《白鹭》节选",level:"★★",cat:"写景",text:"白鹭是一首精巧的诗。色素的配合，身段的大小，一切都很适宜。白鹤太大而嫌生硬，即如粉红的朱鹭或灰色的苍鹭，也觉得大了一些，而且太不寻常了。然而白鹭却因为它的常见，而被人忘却了它的美。那雪白的蓑毛，那全身的流线型结构，那铁色的长喙，那青色的脚，增之一分则嫌长，减之一分则嫌短，素之一忽则嫌白，黛之一忽则嫌黑。在清水田里，时有一只两只白鹭站着钓鱼，整个的田便成了一幅嵌在玻璃框里的画面。田的大小好像有心人为白鹭设计出的镜匣。",goodWords:["精巧","适宜","生硬","寻常","蓑毛","流线型","铁色","青色"],goodSentences:["白鹭是一首精巧的诗。","增之一分则嫌长，减之一分则嫌短，素之一忽则嫌白，黛之一忽则嫌黑。","整个的田便成了一幅嵌在玻璃框里的画面。"],corePara:"那雪白的蓑毛，那全身的流线型结构，那铁色的长喙，那青色的脚，增之一分则嫌长，减之一分则嫌短，素之一忽则嫌白，黛之一忽则嫌黑。",annot:"郭沫若用精练的语言赞美白鹭，将其比作精巧的诗。通过对比和精确的描写，表现白鹭恰到好处的美——平凡中见不平凡。",reflection:"白鹭虽然常见，却美得像一首诗。作者说它增一分减一分都不行，这说明美在于恰到好处。生活中有很多美好的事物就在我们身边，只是我们太熟悉了反而忽略了。我要学会用心观察身边的一草一木。"},
  {title:"《海上日出》节选",level:"★★★",cat:"写景",text:"果然过了一会儿，在那个地方出现了太阳的小半边脸，红是真红，却没有亮光。这个太阳好像负着重荷似的一步一步、慢慢地努力上升，到了最后，终于冲破了云霞，完全跳出了海面，颜色红得非常可爱。一刹那间，这个深红的圆东西，忽然发出了夺目的亮光，射得人眼睛发痛，它旁边的云片也突然有了光彩。有时太阳走进了云堆中，它的光线却从云里射下来，直射到水面上。这时候要分辨出哪里是水，哪里是天，倒也不容易，因为我就只看见一片灿烂的亮光。",goodWords:["负着重荷","努力上升","冲破","跳出","夺目","射","灿烂"],goodSentences:["这个太阳好像负着重荷似的一步一步、慢慢地努力上升，到了最后，终于冲破了云霞，完全跳出了海面。","一刹那间，这个深红的圆东西，忽然发出了夺目的亮光，射得人眼睛发痛。"],corePara:"这个太阳好像负着重荷似的一步一步、慢慢地努力上升，到了最后，终于冲破了云霞，完全跳出了海面。",annot:"巴金用拟人手法写日出，太阳负着重荷努力上升，最终冲破云霞，象征着光明战胜黑暗的力量。动词的运用极其精准。",reflection:"太阳从海面升起的过程太壮观了！作者把太阳写成一个努力向上的人，一步一步地冲破困难。这让我明白，只要坚持不懈，就能突破困难，绽放光芒。就像我们的学习一样，虽然有时很辛苦，但只要坚持，就一定能成功。"},
  {title:"《繁星》节选",level:"★★",cat:"抒情",text:"我爱月夜，但我也爱星天。从前在家乡七八月的夜晚里，在庭院里纳凉的时候，我最爱看天上密密麻麻的繁星。三年前在南京，我住的地方有一道后门，每晚我打开后门，便看见一个静寂的夜。下面是一片菜园，上面是星群密布的蓝天。星光在我们的肉眼里虽然微小，然而它使我们觉得光明无处不在。如今在海上，每晚和繁星相对，我把它们认得很熟了。我躺在舱面上，仰望天空，深蓝色的天空里悬着无数半明半昧的星。船在动，星也在动，它们是这样低，真是摇摇欲坠呢！",goodWords:["纳凉","密密麻麻","静寂","星群密布","微小","半明半昧","摇摇欲坠"],goodSentences:["深蓝色的天空里悬着无数半明半昧的星。","船在动，星也在动，它们是这样低，真是摇摇欲坠呢！"],corePara:"星光在我们的肉眼里虽然微小，然而它使我们觉得光明无处不在。",annot:"巴金通过对不同时期看星空的回忆，表达了对星空的热爱和对光明的向往。半明半昧、摇摇欲坠等词语生动传神。",reflection:"巴金在不同地方看星星，每次都有不同的感受。星星虽然微小，却给人带来光明和希望。我以后也要多抬头看看星空，感受大自然的美好。"},
  {title:"《爬山虎的脚》节选",level:"★★",cat:"科普",text:"爬山虎刚长出来的叶子是嫩红的，不几天叶子长大，就变成嫩绿的。爬山虎的嫩叶，不大引人注意，引人注意的是长大了的叶子。那些叶子绿得那么新鲜，看着非常舒服。叶尖一顺儿朝下，在墙上铺得那么均匀，没有重叠起来的，也不留一点儿空隙。一阵风拂过，一墙的叶子就漾起波纹，好看得很。以前我只知道这种植物叫爬山虎，可不知道它怎么能爬。今年我注意了，原来爬山虎是有脚的。爬山虎的脚长在茎上。茎上长叶柄的地方，反面伸出枝状的六七根细丝，每根细丝像蜗牛的触角。细丝跟新叶子一样，也是嫩红的。这就是爬山虎的脚。",goodWords:["嫩红","嫩绿","新鲜","均匀","重叠","空隙","漾起波纹","枝状","细丝"],goodSentences:["一阵风拂过，一墙的叶子就漾起波纹，好看得很。","茎上长叶柄的地方，反面伸出枝状的六七根细丝，每根细丝像蜗牛的触角。"],corePara:"爬山虎的脚长在茎上。茎上长叶柄的地方，反面伸出枝状的六七根细丝，每根细丝像蜗牛的触角。",annot:"叶圣陶通过细致观察，用准确的语言描写爬山虎的叶子和脚。比喻生动（像蜗牛的触角），观察入微，是观察日记的典范。",reflection:"原来爬山虎真的有脚！作者观察得太仔细了，连细丝的颜色和形状都写得清清楚楚。这让我明白，写作文要仔细观察，才能写得生动。我以后也要像叶圣陶爷爷一样，用心观察身边的事物。"},
  {title:"《观潮》节选",level:"★★★",cat:"写景",text:"午后一点左右，从远处传来隆隆的响声，好像闷雷滚动。顿时人声鼎沸，有人告诉我们说：潮来了！我们踮着脚往东望去，江面还是风平浪静，看不出有什么变化。过了一会儿，响声越来越大，只见东边水天相接的地方出现了一条白线，人群又沸腾起来。那条白线很快地向我们移来，逐渐拉长，变粗，横贯江面。再近些，只见白浪翻滚，形成一堵两丈多高的水墙。浪潮越来越近，犹如千万匹白色战马齐头并进，浩浩荡荡地飞奔而来；那声音如同山崩地裂，好像大地都被震得颤动起来。",goodWords:["闷雷滚动","人声鼎沸","风平浪静","横贯","白浪翻滚","浩浩荡荡","山崩地裂","颤动"],goodSentences:["那条白线很快地向我们移来，逐渐拉长，变粗，横贯江面。","浪潮越来越近，犹如千万匹白色战马齐头并进，浩浩荡荡地飞奔而来。","那声音如同山崩地裂，好像大地都被震得颤动起来。"],corePara:"浪潮越来越近，犹如千万匹白色战马齐头并进，浩浩荡荡地飞奔而来；那声音如同山崩地裂，好像大地都被震得颤动起来。",annot:"本文按由远及近的顺序描写钱塘江大潮，运用比喻和夸张（千万匹白色战马、山崩地裂），从视觉和听觉两个角度展现大潮的壮观。",reflection:"钱塘江大潮太壮观了！作者从听到声音到看到白线，再到水墙和战马，一步步把大潮的气势写得淋漓尽致。我仿佛听到了那山崩地裂般的声音。大自然的力量真是伟大，让人敬畏！"},
  {title:"《鸟的天堂》节选",level:"★★",cat:"写景",text:"我们把手一拍，便看见一只大鸟飞了起来。我们继续拍掌，树上就变得热闹了。到处都是鸟声，到处都是鸟影。大的，小的，花的，黑的，有的站在树枝上叫，有的飞起来，有的在扑翅膀。我注意地看着，眼睛应接不暇，看清楚了这只，又错过了那只，看见了那只，另一只又飞起来了。一只画眉鸟飞了出来，被我们的掌声一吓，又飞进了叶丛，站在一根小枝上兴奋地叫着。那歌声真好听。当小船向着高塔下面的乡村划去的时候，我回过头来，看那被抛在后面的茂盛的榕树。我感到一点儿留恋。昨天是我的眼睛骗了我，那鸟的天堂的确是鸟的天堂啊！",goodWords:["热闹","应接不暇","扑翅膀","兴奋","留恋","茂盛"],goodSentences:["到处都是鸟声，到处都是鸟影。","看清楚了这只，又错过了那只，看见了那只，另一只又飞起来了。"],corePara:"到处都是鸟声，到处都是鸟影。大的，小的，花的，黑的，有的站在树枝上叫，有的飞起来，有的在扑翅膀。",annot:"巴金通过动态描写展现鸟的天堂的热闹景象，应接不暇一词生动表现了鸟多的场面。排比句式增强了节奏感。",reflection:"鸟的天堂真热闹！那么多鸟，看都看不过来。作者用到处都是这个词重复了两次，让我感受到了鸟的数量之多。我们也要保护鸟类，让它们有安全美丽的家园。"},
  {title:"《草原》节选",level:"★★★",cat:"写景",text:"那里的天比别处的天更可爱，空气是那么清鲜，天空是那么明朗，使我总想高歌一曲，表示我满心的愉快。在天底下，一碧千里，而并不茫茫。四面都有小丘，平地是绿的，小丘也是绿的。羊群一会儿上了小丘，一会儿又下来，走在哪里都像给无边的绿毯绣上了白色的大花。那些小丘的线条是那么柔美，就像只用绿色渲染，不用墨线勾勒的中国画那样，到处翠色欲流，轻轻流入云际。这种境界，既使人惊叹，又叫人舒服，既愿久立四望，又想坐下低吟一首奇丽的小诗。",goodWords:["清鲜","明朗","一碧千里","柔美","渲染","勾勒","翠色欲流","奇丽"],goodSentences:["羊群一会儿上了小丘，一会儿又下来，走在哪里都像给无边的绿毯绣上了白色的大花。","那些小丘的线条是那么柔美，就像只用绿色渲染，不用墨线勾勒的中国画那样，到处翠色欲流，轻轻流入云际。"],corePara:"这种境界，既使人惊叹，又叫人舒服，既愿久立四望，又想坐下低吟一首奇丽的小诗。",annot:"老舍用比喻将草原比作绿毯、将小丘比作中国画，展现草原的辽阔与柔美。排比和对偶的运用使语言富有韵律。",reflection:"草原太美了！一碧千里，到处都是绿色。老舍爷爷把羊群比作白花，把草原比作绿毯，让我仿佛看到了那幅画面。我真想去草原看看，呼吸那里的新鲜空气，感受大自然的辽阔。"},
  {title:"《猫》节选",level:"★★",cat:"写人",text:"猫的性格实在有些古怪。说它老实吧，它的确有时候很乖。它会找个暖和地方，成天睡大觉，无忧无虑，什么事也不过问。可是，决定要出去玩玩，就会出走一天一夜，任凭谁怎么呼唤，它也不肯回来。说它贪玩吧，的确是呀，要不怎么会一天一夜不回家呢？可是，它听到老鼠的一点响动，又多么尽职。它屏息凝视，一连就是几个钟头，非把老鼠等出来不可！它要是高兴，能比谁都温柔可亲：用身子蹭你的腿，把脖儿伸出来要求给抓痒，或是在你写作的时候，跳上桌来，在稿纸上踩印几朵小梅花。",goodWords:["古怪","无忧无虑","尽职","屏息凝视","温柔可亲","蹭"],goodSentences:["它屏息凝视，一连就是几个钟头，非把老鼠等出来不可！","或是在你写作的时候，跳上桌来，在稿纸上踩印几朵小梅花。"],corePara:"它要是高兴，能比谁都温柔可亲：用身子蹭你的腿，把脖儿伸出来要求给抓痒。",annot:"老舍用先贬后褒的手法写猫的古怪性格——既老实又贪玩，既贪玩又尽职。比喻生动（踩印小梅花），语言幽默亲切。",reflection:"老舍爷爷把猫写得真有趣！猫既乖巧又贪玩，还会在稿纸上踩小梅花，太可爱了。作者一定很喜欢猫，才能写出这么生动的文字。我也想养一只猫，观察它的各种有趣行为。"},
  {title:"《母鸡》节选",level:"★★",cat:"写人",text:"我一向讨厌母鸡。不知怎样受了一点惊恐，听吧，它由前院嘎嘎到后院，由后院再嘎嘎到前院，没结没完，而并没有什么理由，讨厌！有的时候，它不这样乱叫，可是细声细气的，有什么心事似的，颤颤巍巍的，顺着墙根，或沿着田坝，从哪儿扯到哪儿，如怨如诉，使人心中立刻结起个小疙瘩来。可是，现在我改变了心思，我看见一只孵出一群小雏鸡的母亲。不论是在院里，还是在院外，它总是挺着脖儿，表示出世界上并没有可怕的东西。一只鸟儿飞过，或者是什么东西响了一声，它立刻警戒起来，歪着头儿听；挺着身儿预备作战；看看前，看看后，咕咕地警告鸡雏要马上集合到它身边来！",goodWords:["惊恐","细声细气","颤颤巍巍","如怨如诉","警戒","作战","集合"],goodSentences:["它总是挺着脖儿，表示出世界上并没有可怕的东西。","挺着身儿预备作战；看看前，看看后，咕咕地警告鸡雏要马上集合到它身边来！"],corePara:"不论是在院里，还是在院外，它总是挺着脖儿，表示出世界上并没有可怕的东西。",annot:"老舍先写讨厌母鸡，后写敬佩母鸡，欲扬先抑。通过母鸡保护小鸡的动作描写，赞美母爱的伟大。",reflection:"母鸡做了妈妈后完全变了，变得勇敢了，什么都不怕。这让我想到我的妈妈，她也是为了保护我什么都不怕。母爱真伟大！我以后再也不说妈妈唠叨了，因为那都是爱。"},
  {title:"《卖火柴的小女孩》节选",level:"★★★",cat:"童话",text:"天冷极了，下着雪，又快黑了。这是一年的最后一天——大年夜。在这又冷又黑的晚上，一个乖巧的小女孩，赤着脚在街上走着。她的一双小脚冻得红一块青一块的。她从家里出来的时候还穿着一双拖鞋，但是有什么用呢？那是一双很大的拖鞋——那么大，一向是她妈妈穿的。她穿过马路的时候，两辆马车飞快地冲过来，吓得她把拖鞋跑掉了。一个怎么也找不着，另一个叫一个男孩捡起来拿着跑了。他说，将来他有了孩子可以拿它当摇篮。小女孩只好赤着脚走，一双小脚冻得红一块青一块的。她的旧围裙里兜着许多火柴，手里还拿着一把。这一整天，谁也没买过她一根火柴，谁也没给过她一个钱。",goodWords:["乖巧","赤着脚","红一块青一块","飞快","摇篮","兜着"],goodSentences:["这是一年的最后一天——大年夜。在这又冷又黑的晚上，一个乖巧的小女孩，赤着脚在街上走着。"],corePara:"这一整天，谁也没买过她一根火柴，谁也没给过她一个钱。",annot:"安徒生用大年夜的喜庆与小女孩的悲惨形成强烈对比，赤脚、寒冷、饥饿，渲染出令人心碎的氛围。",reflection:"读完这个故事我很难过。大年夜本来应该和家人团聚，吃好吃的，但小女孩却在寒冷的街上卖火柴，连鞋都没有。和她相比，我太幸福了。我要珍惜现在的幸福生活，也要关心身边需要帮助的人。"},
  {title:"《小王子》节选",level:"★★",cat:"童话",text:"小王子的星球上长出了一朵玫瑰花。那朵玫瑰花非常美丽，小王子从来没有见过这么美丽的花。他精心地照料她，给她浇水，给她盖上玻璃罩，为她挡风。可是玫瑰花很骄傲，总是对小王子提出各种要求。小王子虽然很爱她，但也被她弄得有些烦恼。有一天，小王子决定离开他的星球，去外面的世界看看。他去了很多星球，遇到了各种各样的人。最后，他来到了地球。在地球上，他看到了一座种满玫瑰花的花园，里面有五千朵和他的玫瑰花一模一样的花。他感到非常伤心，因为他以为自己的玫瑰花是独一无二的。",goodWords:["精心","照料","骄傲","烦恼","独一无二","伤心"],goodSentences:["他精心地照料她，给她浇水，给她盖上玻璃罩，为她挡风。"],corePara:"小王子虽然很爱她，但也被她弄得有些烦恼。",annot:"《小王子》通过玫瑰花的骄傲和小王子的离开，探讨了爱与责任的关系。正因为你为你的玫瑰花费了时间，才使你的玫瑰变得如此重要。",reflection:"小王子以为他的玫瑰是独一无二的，后来发现世界上有很多一样的玫瑰。但其实他的玫瑰还是特别的，因为他为她付出了时间和爱。这让我明白，正是因为我们为某件事或某个人付出了努力，才让他变得特别和重要。"},
  {title:"《草船借箭》节选",level:"★★★",cat:"叙事",text:"周瑜看到诸葛亮挺有才干，心里很妒忌。有一天，周瑜请诸葛亮商议军事，说：我们就要跟曹军交战。水上交战，用什么兵器最好？诸葛亮说：用弓箭最好。周瑜说：对，先生跟我想的一样。现在军中缺箭，想请先生赶造十万支。这是公事，希望先生不要推却。诸葛亮说：都督委托，当然照办。十万支箭，三天造好。周瑜说：军情紧急，可不能开玩笑。诸葛亮说：怎么敢跟都督开玩笑？我愿意立下军令状，三天造不好，甘受惩罚。",goodWords:["妒忌","商议","推却","军令状","甘受惩罚"],goodSentences:["周瑜看到诸葛亮挺有才干，心里很妒忌。"],corePara:"我愿意立下军令状，三天造不好，甘受惩罚。",annot:"本文通过对话推进情节，周瑜的妒忌和诸葛亮的从容形成对比。三天造十万支箭是不可能完成的任务，但诸葛亮胸有成竹。",reflection:"诸葛亮真聪明，他知道三天造十万支箭很难，但他有办法。他不怕困难，因为他心里已经有了计划。这让我明白，遇到困难不要怕，要多动脑筋想办法。"},
  {title:"《少年闰土》节选",level:"★★★",cat:"写人",text:"深蓝的天空中挂着一轮金黄的圆月，下面是海边的沙地，都种着一望无际的碧绿的西瓜。其间有一个十一二岁的少年，项带银圈，手捏一柄钢叉，向一匹猹尽力地刺去。那猹却将身一扭，反从他的胯下逃走了。这少年便是闰土。我认识他时，也不过十多岁，离现在将有三十年了；那时我的父亲还在世，家景也好，我正是一个少爷。那一年，我家是一件大祭祀的值年。正月里供祖像，供品很多，祭器也很讲究，拜的人也很多，祭器也很要防偷去。我家只有一个忙月（我们这里给人做工的分三种：整年给一定人家做工的叫长年；短日给人做工的叫短工；自己也种地，只在过年过节以及收租时候来给一定的人家做工的称忙月），忙不过来，他便对父亲说，可以叫他的儿子闰土来管祭器。",goodWords:["一望无际","碧绿","项带银圈","手捏钢叉","尽力","祭祀","讲究"],goodSentences:["深蓝的天空中挂着一轮金黄的圆月，下面是海边的沙地，都种着一望无际的碧绿的西瓜。","其间有一个十一二岁的少年，项带银圈，手捏一柄钢叉，向一匹猹尽力地刺去。"],corePara:"深蓝的天空中挂着一轮金黄的圆月，下面是海边的沙地，都种着一望无际的碧绿的西瓜。",annot:"鲁迅用景物描写渲染气氛，深蓝的天空、金黄的圆月、碧绿的西瓜构成一幅色彩鲜明的画面。少年闰土的形象英姿飒爽。",reflection:"闰土真厉害，敢拿钢叉刺猹！那段描写太精彩了，蓝色的天、金黄的月亮、绿色的西瓜，还有戴着银圈的少年，像一幅画。闰土懂得很多城里孩子不懂的东西，我真羡慕他的生活。"},
  {title:"《将相和》节选",level:"★★★",cat:"叙事",text:"蔺相如捧着璧，往后退了几步，靠着柱子站定。他理直气壮地说：我看大人并不想交付十五座城。现在璧在我手里，您要是逼我，我的脑袋和璧就一块儿撞碎在这柱子上！说着，他举起和氏璧就要向柱子上撞。秦王怕他把璧真的撞碎了，连忙说一切都好商量。蔺相如知道秦王没有拿城换璧的诚意，就上前一步说：这璧上有个小毛病，让我指给您看。秦王听他这么一说，就把璧交给了他。蔺相如接过璧，往后退了几步，靠着柱子站定，举起璧就要向柱子上撞。秦王怕他真的撞碎了璧，连忙向蔺相如道歉，并答应割给赵国十五座城。",goodWords:["理直气壮","诚意","道歉","割给"],goodSentences:["我看大人并不想交付十五座城。现在璧在我手里，您要是逼我，我的脑袋和璧就一块儿撞碎在这柱子上！"],corePara:"蔺相如捧着璧，往后退了几步，靠着柱子站定。他理直气壮地说。",annot:"本文通过完璧归赵的故事，展现蔺相如的勇敢和智慧。理直气壮一词表现了他的正义凛然，以命相搏的气势震慑了秦王。",reflection:"蔺相如真勇敢！他不怕强大的秦王，宁愿和璧一起撞碎也不屈服。这种勇气和智慧让我佩服。做人就应该有骨气，面对强权不低头。"},
  {title:"《北京的春节》节选",level:"★★",cat:"叙事",text:"按照北京的老规矩，过农历的新年（春节），差不多在腊月的初旬就开头了。腊七腊八，冻死寒鸦，这是一年里最冷的时候。可是，到了严冬，不久便是春天，所以人们并不因为寒冷而减少过年与迎春的热情。在腊八那天，人家里，寺观里，都熬腊八粥。粥是用各种米，各种豆，与各种干果熬成的。这不是粥，而是小型的农业展览会。到年底，蒜泡得色如翡翠，而醋也有些辣味，色味双美，使人忍不住要多吃几个饺子。在北京，过年时，家家吃饺子。",goodWords:["初旬","热情","熬","农业展览会","翡翠","色味双美"],goodSentences:["这不是粥，而是小型的农业展览会。","蒜泡得色如翡翠，而醋也有些辣味，色味双美，使人忍不住要多吃几个饺子。"],corePara:"到了严冬，不久便是春天，所以人们并不因为寒冷而减少过年与迎春的热情。",annot:"老舍用幽默的语言（小型的农业展览会）描写腊八粥的丰富，展现北京春节的传统习俗，充满了浓厚的生活气息。",reflection:"老舍把腊八粥比作农业展览会，太有趣了！北京春节的习俗真丰富。我也很期待过年，可以和家人团聚，吃好吃的。每个地方的年俗都不一样，但都充满了喜庆和温暖。"},
  {title:"《匆匆》节选",level:"★★★",cat:"抒情",text:"燕子去了，有再来的时候；杨柳枯了，有再青的时候；桃花谢了，有再开的时候。但是，聪明的，你告诉我，我们的日子为什么一去不复返呢？——是有人偷了他们罢：那是谁？又藏在何处呢？是他们自己逃走了罢：现在又到了哪里呢？我不知道他们给了我多少日子；但我的手确乎是渐渐空虚了。在默默里算着，八千多日子已经从我手中溜去；像针尖上一滴水滴在大海里，我的日子滴在时间的流里，没有声音，也没有影子。我不禁头涔涔而泪潸潸了。去的尽管去了，来的尽管来着；去来的中间，又怎样地匆匆呢？",goodWords:["一去不复返","空虚","溜去","针尖","涔涔","潸潸","匆匆"],goodSentences:["燕子去了，有再来的时候；杨柳枯了，有再青的时候；桃花谢了，有再开的时候。","像针尖上一滴水滴在大海里，我的日子滴在时间的流里，没有声音，也没有影子。"],corePara:"去的尽管去了，来的尽管来着；去来的中间，又怎样地匆匆呢？",annot:"朱自清用排比开头，将自然界的循环与时间的不可逆对比，引发对时光流逝的思考。比喻精妙（针尖上一滴水），充满哲理。",reflection:"时间真的过得很快，像水一样从手中溜走。读了这篇文章，我更加感受到了时间的珍贵。我以后不能再浪费时间了，要珍惜每一天，好好学习，做有意义的事。"},
  {title:"《卖油翁》节选",level:"★★",cat:"哲理",text:"陈康肃公尧咨善射，当世无双，公亦以此自矜。尝射于家圃，有卖油翁释担而立，睨之，久而不去。见其发矢十中八九，但微颔之。康肃问曰：汝亦知射乎？吾射不亦精乎？翁曰：无他，但手熟尔。康肃忿然曰：尔安敢轻吾射！翁曰：以我酌油知之。乃取一葫芦置于地，以钱覆其口，徐以杓酌油沥之，自钱孔入，而钱不湿。因曰：我亦无他，惟手熟尔。康肃笑而遣之。",goodWords:["自矜","家圃","释担","睨","微颔","忿然","酌","沥","遣"],goodSentences:["无他，但手熟尔。","自钱孔入，而钱不湿。"],corePara:"我亦无他，惟手熟尔。",annot:"本文通过卖油翁酌油的故事，说明熟能生巧的道理。陈尧咨善射自矜，卖油翁不以为然，用酌油证明一切技艺不过手熟而已。",reflection:"卖油翁真厉害，油从钱孔进去钱都不湿！他说没什么窍门，就是手熟。这让我明白，不管做什么事，只要多练就能做好。我以后练字、做题也要多练习，熟能生巧嘛。"},
  {title:"《狼牙山五壮士》节选",level:"★★★",cat:"叙事",text:"五位壮士屹立在狼牙山顶峰，眺望着群众和部队主力远去的方向。他们回头望望还在向上爬的敌人，脸上露出胜利的喜悦。班长马宝玉激动地说：同志们，我们的任务胜利完成了！说罢，他把那支从敌人手里夺来的枪砸碎了，然后走到悬崖边上，像每次发起冲锋一样，第一个纵身跳下深谷。战士们也昂首挺胸，相继从悬崖上往下跳。狼牙山上响起了他们的壮烈豪迈的口号声：打倒日本帝国主义！中国共产党万岁！这是英雄的中国人民坚强不屈的声音！这声音惊天动地，气壮山河！",goodWords:["屹立","眺望","喜悦","激动","纵身","昂首挺胸","壮烈豪迈","惊天动地","气壮山河"],goodSentences:["这是英雄的中国人民坚强不屈的声音！这声音惊天动地，气壮山河！"],corePara:"狼牙山上响起了他们的壮烈豪迈的口号声：打倒日本帝国主义！中国共产党万岁！",annot:"本文通过五位壮士跳崖的壮烈场景，歌颂了英雄们视死如归的精神。口号声惊天动地，气壮山河，震撼人心。",reflection:"五位壮士太勇敢了！他们为了保护群众和部队，宁愿跳崖也不投降。他们的口号声让我热血沸腾。我们今天的幸福生活是英雄们用生命换来的，我一定要好好学习，不辜负他们的牺牲。"},
  {title:"《十里长街送总理》节选",level:"★★★",cat:"抒情",text:"天灰蒙蒙的，又阴又冷。长安街两旁的人行道上，挤满了男女老少。路那样长，人那样多，向东望不见头，向西望不见尾。人们臂上都缠着黑纱，胸前都佩着白花，眼睛都望着周总理的灵车将要开来的方向。一位满头银发的老奶奶，双手拄着拐杖，背靠着一棵洋槐树，焦急而又耐心地等待着。一对青年夫妇，丈夫抱着小女儿，妻子领着儿子，他们挤下了人行道，探着身子张望。一群泪痕满面的红领巾，相互扶着肩，踮着脚望着，望着……",goodWords:["灰蒙蒙","挤满","缠着黑纱","佩着白花","满头银发","焦急","耐心","泪痕满面"],goodSentences:["路那样长，人那样多，向东望不见头，向西望不见尾。","一群泪痕满面的红领巾，相互扶着肩，踮着脚望着，望着……"],corePara:"人们臂上都缠着黑纱，胸前都佩着白花，眼睛都望着周总理的灵车将要开来的方向。",annot:"本文通过环境描写（天灰蒙蒙的）和人物群像（老奶奶、青年夫妇、红领巾）渲染悲壮氛围，表现人民对周总理的深切爱戴。",reflection:"那么多人自发来送周总理，可见人民多么爱戴他。天灰蒙蒙的，好像也在为总理哀悼。我要向周总理学习，做一个为人民服务的人。"},
  {title:"《桂林山水》节选",level:"★★★",cat:"写景",text:"人们都说：桂林山水甲天下。我们乘着木船荡漾在漓江上，来观赏桂林的山水。我看见过波澜壮阔的大海，玩赏过水平如镜的西湖，却从没看见过漓江这样的水。漓江的水真静啊，静得让你感觉不到它在流动；漓江的水真清啊，清得可以看见江底的沙石；漓江的水真绿啊，绿得仿佛那是一块无瑕的翡翠。船桨激起的微波扩散出一道道水纹，才让你感觉到船在前进，岸在后移。我攀登过峰峦雄伟的泰山，游览过红叶似火的香山，却从没看见过桂林这一带的山。桂林的山真奇啊，像老人，像巨象，像骆驼，奇峰罗列，形态万千；桂林的山真秀啊，像翠绿的屏障，像新生的竹笋，色彩明丽，倒映水中；桂林的山真险啊，危峰兀立，怪石嶙峋，好像一不小心就会栽倒下来。",goodWords:["波澜壮阔","水平如镜","无瑕","翡翠","峰峦雄伟","红叶似火","奇峰罗列","形态万千","危峰兀立","怪石嶙峋"],goodSentences:["漓江的水真静啊，静得让你感觉不到它在流动；漓江的水真清啊，清得可以看见江底的沙石；漓江的水真绿啊，绿得仿佛那是一块无瑕的翡翠。","桂林的山真奇啊，像老人，像巨象，像骆驼，奇峰罗列，形态万千。"],corePara:"漓江的水真静啊，静得让你感觉不到它在流动；漓江的水真清啊，清得可以看见江底的沙石；漓江的水真绿啊，绿得仿佛那是一块无瑕的翡翠。",annot:"本文用排比和比喻的手法描写桂林山水的特点——静、清、绿（水）和奇、秀、险（山），语言优美，节奏鲜明。",reflection:"桂林山水太美了！漓江的水静、清、绿，桂林的山奇、秀、险。作者的排比句读起来特别好听，让我仿佛看到了那幅美丽的山水画。大自然的鬼斧神工真是令人惊叹！"},
  {title:"《富饶的西沙群岛》节选",level:"★★",cat:"写景",text:"西沙群岛是南海上的一群岛屿，是我国的海防前哨。那里风景优美，物产丰富，是个可爱的地方。西沙群岛一带海水五光十色，瑰丽无比：有深蓝的，淡青的，绿的，淡绿的，杏黄的。一块块，一条条，相互交错着。因为海底高低不平，有山崖，有峡谷，海水有深有浅，从海面看，色彩就不同了。海底的岩石上长着各种各样的珊瑚，有的像绽开的花朵，有的像分枝的鹿角。海参到处都是，在海底懒洋洋地蠕动。大龙虾全身披甲，划过来，划过去，样子挺威武。",goodWords:["海防前哨","五光十色","瑰丽无比","交错","绽开","懒洋洋","蠕动","披甲","威武"],goodSentences:["西沙群岛一带海水五光十色，瑰丽无比：有深蓝的，淡青的，绿的，淡绿的，杏黄的。","大龙虾全身披甲，划过来，划过去，样子挺威武。"],corePara:"海底的岩石上长着各种各样的珊瑚，有的像绽开的花朵，有的像分枝的鹿角。",annot:"本文从海水颜色、海底生物两个角度描写西沙群岛的富饶。比喻生动（珊瑚像花朵和鹿角），色彩丰富。",reflection:"西沙群岛的海水有那么多颜色，太神奇了！海底有那么多有趣的生物——懒洋洋的海参、威武的大龙虾。我们的祖国真是地大物博，有那么美的地方。我长大了一定要去看看。"},
  {title:"《美丽的小兴安岭》节选",level:"★★",cat:"写景",text:"我国东北的小兴安岭，有数不清的红松、白桦、栎树……几百里连成一片，就像绿色的海洋。春天，树木抽出新的枝条，长出嫩绿的叶子。山上的积雪融化了，雪水汇成小溪，淙淙地流着。溪里涨满了春水。小鹿在溪边散步，它们有的俯下身子喝水，有的侧着脑袋欣赏自己映在水里的影子。夏天，树木长得葱葱茏茏，密密层层的枝叶把森林封得严严实实的，挡住了人们的视线，遮住了蓝蓝的天空。早晨，雾从山谷里升起来，整个森林浸在乳白色的浓雾里。",goodWords:["数不清","抽出","融化","汇成","淙淙","涨满","葱葱茏茏","密密层层","严严实实","浸"],goodSentences:["几百里连成一片，就像绿色的海洋。","小鹿在溪边散步，它们有的俯下身子喝水，有的侧着脑袋欣赏自己映在水里的影子。","整个森林浸在乳白色的浓雾里。"],corePara:"几百里连成一片，就像绿色的海洋。",annot:"本文按季节顺序描写小兴安岭，用拟人（小鹿欣赏影子）和比喻（绿色的海洋）展现四季变化之美。浸字用得妙，写出了雾的弥漫。",reflection:"小兴安岭真美！春天小鹿在水边照镜子，夏天森林浸在浓雾里，多有趣啊！作者按四季来写，让我看到了不同季节的不同美景。我真想走进那片绿色的海洋。"},
  {title:"《威尼斯的小艇》节选",level:"★★",cat:"写景",text:"小艇有二三十英尺长，又窄又深，有点像独木舟。船头和船艄向上翘起，像挂在天边的新月，行动轻快灵活，仿佛田沟里的水蛇。我们坐在船舱里，皮垫子软软的像沙发一般。小艇穿过一座座形式不同的石桥。我们打开窗帘，望望耸立在两岸的古建筑，跟来往的船只打招呼，有说不完的情趣。船夫的驾驶技术特别好。行船的速度极快，来往船只很多，他操纵自如，毫不手忙脚乱。不管怎么拥挤，他总能左拐右拐地挤过去。遇到极窄的地方，他总能平稳地穿过，速度非常快，还能作急转弯。",goodWords:["又窄又深","独木舟","翘起","操纵自如","手忙脚乱","左拐右拐","急转弯"],goodSentences:["船头和船艄向上翘起，像挂在天边的新月，行动轻快灵活，仿佛田沟里的水蛇。","不管怎么拥挤，他总能左拐右拐地挤过去。"],corePara:"船夫的驾驶技术特别好。行船的速度极快，来往船只很多，他操纵自如，毫不手忙脚乱。",annot:"马克·吐温用比喻（新月、水蛇）描写威尼斯小艇的外形和动作，通过船夫的驾驶技术展现威尼斯独特的风情。",reflection:"威尼斯的小艇好特别，像新月又像水蛇。船夫的技术太厉害了，在窄窄的水道里也能开得那么快。威尼斯是一座水上的城市，真想去看看！"},
  {title:"《记金华的双龙洞》节选",level:"★★",cat:"叙事",text:"一路迎着溪流。随着山势，溪流时而宽，时而窄，时而缓，时而急，溪声也时时变换调子。入山大约五公里就来到双龙洞口，那溪流就是从洞里出来的。在洞口抬头望，山相当高，突兀森郁，很有气势。洞口像桥洞似的，很宽。走进去，仿佛到了个大会堂，周围是石壁，头上是高高的石顶，在那里聚集一千或是八百人开个会，一定不觉得拥挤。泉水靠着洞口的右边往外流。这是外洞。在外洞找泉水的来路，原来从靠左边的石壁下方的孔隙流出。",goodWords:["突兀森郁","气势","孔隙","拥挤"],goodSentences:["随着山势，溪流时而宽，时而窄，时而缓，时而急，溪声也时时变换调子。","走进去，仿佛到了个大会堂，周围是石壁，头上是高高的石顶。"],corePara:"随着山势，溪流时而宽，时而窄，时而缓，时而急，溪声也时时变换调子。",annot:"叶圣陶按游览顺序写双龙洞，用排比（时而宽、时而窄、时而缓、时而急）描写溪流的变化，语言准确生动。",reflection:"作者按游览顺序写，让我跟着他一起游了双龙洞。溪流的声音时时变换调子，像音乐一样。大自然真是鬼斧神工，能造出这么奇特的溶洞。"},
  {title:"《Touch the Moon》",level:"★★",cat:"科普",text:"On July 20, 1969, millions of people watched their televisions. They were waiting to see the first men on the Moon. Neil Armstrong and Buzz Aldrin were astronauts. They flew to the Moon in a spaceship called Apollo 11. After four days, they landed on the Moon. Neil Armstrong was the first person to walk on the Moon. He said: That's one small step for a man, one giant leap for mankind. The astronauts collected rocks and soil from the Moon. They also planted a flag. They stayed on the Moon for about 21 hours. Then they flew back to Earth. The whole world celebrated their safe return.",goodWords:["astronauts","spaceship","landed","giant leap","mankind","collected","celebrated"],goodSentences:["That's one small step for a man, one giant leap for mankind.","The whole world celebrated their safe return."],corePara:"Neil Armstrong was the first person to walk on the Moon.",annot:"This passage tells the story of the first Moon landing in 1969. Key vocabulary includes astronauts, spaceship, and the famous quote by Armstrong.",reflection:"人类第一次登上月球真了不起！阿姆斯特朗说的那句话太经典了——个人的一小步，人类的一大步。科学的力量真伟大，我以后也要努力学习，探索未知的世界。"},
];

// 程序化生成更多阅读选文（通过主题变体扩展到300篇）
function generateMorePassages(){
  const templates = [
    {cat:"写景",topics:["秋天的校园","冬日的雪景","春天的公园","夏天的海边","山间的清晨","雨后的彩虹","夕阳西下","星空灿烂","湖边漫步","田野风光","校园的一角","公园的四季","河边的柳树","山顶的云海","沙漠的落日","森林的早晨","花海的芬芳","雪后的村庄","雨中的街道","月光下的荷塘","晨雾中的山峦","黄昏的沙滩","春天的田野","夏夜的萤火","秋日的枫林","冬晨的霜花","溪边的石头","竹林深处","海边礁石","山间小路","城市夜景","乡村黄昏","校园花坛","公园长椅","湖心小岛","山顶凉亭","林间小径","田野麦浪","河边芦苇","山脚梯田","海港码头","古巷幽深","广场喷泉","田园牧歌"],builder:(topic)=>({
      title:`《${topic}》`,level:"★★",cat:"写景",
      text:`${topic}是一幅美丽的画卷。清晨，薄雾笼罩着大地，仿佛披上了一层轻纱。阳光透过云层洒落下来，给万物镀上了一层金色。远处的山峦若隐若现，近处的花草上挂着晶莹的露珠，在阳光下闪闪发光。
微风轻轻吹过，带来了花草的清香。鸟儿在枝头欢快地歌唱，蝴蝶在花丛中翩翩起舞。这美景让人心旷神怡，仿佛置身于仙境之中。
${topic}的美，不仅在于它的外表，更在于它给人带来的宁静与愉悦。每当我置身其中，所有的烦恼都会烟消云散。`,
      goodWords:["薄雾笼罩","轻纱","镀上","若隐若现","晶莹","闪闪发光","心旷神怡","烟消云散"],
      goodSentences:[`薄雾笼罩着大地，仿佛披上了一层轻纱。`,`阳光透过云层洒落下来，给万物镀上了一层金色。`,`每当我置身其中，所有的烦恼都会烟消云散。`],
      corePara:`这美景让人心旷神怡，仿佛置身于仙境之中。`,
      annot:`本文通过视觉、嗅觉、听觉多角度描写${topic}的美，运用比喻（轻纱、仙境）和拟人（鸟儿歌唱）等手法。`,
      reflection:`${topic}真美啊！作者用了很多优美的词语，让我仿佛身临其境。我也想学会用这样的方式来描写身边的美景。生活中处处都有美景，只要我们用心去发现。`
    })},
    {cat:"写人",topics:["我的老师","我的妈妈","我的好朋友","我最敬佩的人","校园里的清洁工","勇敢的消防员","勤劳的农民","热心的邻居","我的爸爸","我的爷爷","我的奶奶","我的同桌","严厉的教练","和蔼的校长","辛勤的园丁","路口交警","医院护士","邮递员叔叔","公交司机","早餐摊阿姨","图书管理员","社区志愿者","建筑工人","快递小哥","理发师伯伯","修鞋匠爷爷","卖花姑娘","保安大叔","食堂师傅","宿管阿姨","钢琴老师","游泳教练","舞蹈老师","美术老师","足球教练","科学课老师","音乐课老师","隔壁小妹妹","楼下老爷爷","社区医生","消防队员","边防战士","航天英雄","支教老师","留守儿童"],builder:(topic)=>({
      title:`《${topic}》`,level:"★★",cat:"写人",
      text:`${topic}是一个普通而又不平凡的人。每天清晨，当第一缕阳光照进窗户时，${topic}已经开始了一天的忙碌。
${topic}的脸上总是挂着温暖的笑容。那笑容像春天的阳光，让人感到无比的温暖和安心。不管遇到什么困难，${topic}总是乐观地面对，从不抱怨。
