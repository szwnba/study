// 宠物状态
const PET_LEVELS = [
  { min:0,  max:20,  emoji:'🐶', mood:'😢', label:'饥饿', desc:'委屈耷拉，肚子好饿…', color:'#EF5350' },
  { min:21, max:40,  emoji:'🐶', mood:'🥺', label:'微饿', desc:'乖巧期待，等着吃饭呢', color:'#FF9800' },
  { min:41, max:60,  emoji:'🐶', mood:'😊', label:'温饱', desc:'平静可爱，感觉还不错', color:'#66BB6A' },
  { min:61, max:80,  emoji:'🐶', mood:'😄', label:'饱腹', desc:'开心微笑，心满意足', color:'#43A047' },
  { min:81, max:100, emoji:'🐶', mood:'🤩', label:'超饱', desc:'元气蹦跳，太幸福啦！', color:'#FFC107' },
];

// ============================================================
//  状态
// ============================================================
let currentDate = todayStr();
let currentModule = 'chinese';

// ============================================================
//  工具函数
// ============================================================
function toast(msg, type=''){
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = type;
  el.classList.add('show');
  setTimeout(()=>el.classList.remove('show'), 2200);
}
function fmtDate(d){
  const dt = new Date(d+'T00:00:00');
  const days = ['日','一','二','三','四','五','六'];
  return { str:`${dt.getMonth()+1}月${dt.getDate()}日`, weekday:`周${days[dt.getDay()]}` };
}
function getDayRecord(date){
  if(!D.dailyRecords[date]) D.dailyRecords[date] = {};
  return D.dailyRecords[date];
}
function getModuleRecord(date, module){
  const dr = getDayRecord(date);
  if(!dr[module]) dr[module] = {};
  return dr[module];
}
function isToday(){ return currentDate === todayStr(); }

// 计算连续打卡天数
function getStreak(){
  let streak = 0;
  let d = new Date();
  while(true){
    const ds = d.toISOString().slice(0,10);
    const dr = D.dailyRecords[ds];
    if(dr){
      let hasDone = false;
      for(const m in dr){
        for(const t in dr[m]){
          if(dr[m][t]){ hasDone = true; break; }
        }
        if(hasDone) break;
      }
      if(hasDone){ streak++; } else { break; }
    } else {
      if(streak === 0 && ds === todayStr()){ /* skip today if no records */ }
      else break;
    }
    d.setDate(d.getDate()-1);
  }
  return streak;
}

// 计算当日完成率
function getDayProgress(date){
  let total = 0, done = 0;
  for(const module in TASKS){
    TASKS[module].forEach(t=>{
      total++;
      const rec = getModuleRecord(date, module);
      if(rec[t.id]) done++;
    });
    D.customTasks[module]?.forEach(t=>{
      total++;
      const rec = getModuleRecord(date, module);
      if(rec['custom_'+t.id]) done++;
    });
  }
  return { total, done, pct: total>0 ? Math.round(done/total*100) : 0 };
}

// ============================================================
//  积分系统
// ============================================================
function addPoints(amount, desc){
  D.points.total += amount;
  D.points.history.unshift({
    date: todayStr(),
    time: new Date().toTimeString().slice(0,5),
    type:'earn', amount, description: desc
  });
  saveData();
  updateTopBar();
}
function spendPoints(amount, desc){
  if(D.points.total < amount){ toast('积分不足！', 'red'); return false; }
  D.points.total -= amount;
  D.points.history.unshift({
    date: todayStr(),
    time: new Date().toTimeString().slice(0,5),
    type:'spend', amount, description: desc
  });
  saveData();
  updateTopBar();
  return true;
}

// ============================================================
//  任务打卡
// ============================================================
function toggleTask(module, taskId, points, title){
  const rec = getModuleRecord(currentDate, module);
  const wasDone = !!rec[taskId];
  rec[taskId] = !wasDone;
  if(!wasDone){
    addPoints(points, `${getModuleName(module)}·${title}`);
    toast(`+${points} 积分！加油 💪`);
  } else {
    // 取消打卡，扣回积分
    D.points.total -= points;
    if(D.points.total < 0) D.points.total = 0;
    D.points.history.unshift({
      date: todayStr(), time: new Date().toTimeString().slice(0,5),
      type:'spend', amount: points, description:`取消·${title}`
    });
    saveData();
    updateTopBar();
    toast('已取消打卡', 'orange');
  }
  saveData();
  renderModule();
}

function getModuleName(m){
  const n = NAV.find(x=>x.id===m);
  return n ? n.name : m;
}

// ============================================================
//  自定义任务
// ============================================================
function addCustomTask(module){
  const input = document.getElementById('customTaskInput_'+module);
  const val = input.value.trim();
  if(!val){ toast('请输入任务名称', 'red'); return; }
  if(!D.customTasks[module]) D.customTasks[module] = [];
  const id = 'ct_'+Date.now();
  D.customTasks[module].push({ id, title:val, points:10 });
  input.value = '';
  saveData();
  renderModule();
  toast('任务已添加 ✅');
}
function deleteCustomTask(module, id){
  D.customTasks[module] = D.customTasks[module].filter(t=>t.id !== id);
  saveData();
  renderModule();
  toast('已删除', 'orange');
}

// ============================================================
//  背诵闯关
// ============================================================
function toggleRecitation(idx){
  if(!D.recitationProgress[idx]) D.recitationProgress[idx] = { dates:[], mastered:false };
  const prog = D.recitationProgress[idx];
  const today = currentDate;
  const i = prog.dates.indexOf(today);
  if(i >= 0){
    prog.dates.splice(i, 1);
    toast('已取消今日背诵', 'orange');
  } else {
    prog.dates.push(today);
    addPoints(10, `语文背诵·${RECITATION_LIST[idx].slice(0,12)}`);
    toast('背诵完成 +10分 🌟');
    if(prog.dates.length >= 3 && !prog.mastered){
      prog.mastered = true;
      toast('🎉 该篇目已熟练掌握！', 'orange');
    }
  }
  saveData();
  renderModule();
}

// ============================================================
//  错题台账
// ============================================================
let editLedgerId = null;
function showLedgerModal(id){
  editLedgerId = id || null;
  const item = id ? D.errorLedger.find(x=>x.id===id) : {};
  const modal = document.getElementById('modalBox');
  modal.innerHTML = `
    <div class="modal-head">
      <div class="mh-title">${id?'编辑错题':'添加错题'}</div>
      <button class="mh-close" onclick="closeModal()">×</button>
    </div>
    <div class="modal-body">
      <div class="form-group"><label>单词</label><input id="f_word" value="${item.word||''}" placeholder="如 building"></div>
      <div class="form-group"><label>错误写法</label><input id="f_wrong" value="${item.wrongSpelling||''}" placeholder="如 buliding"></div>
      <div class="form-group"><label>正确拼写</label><input id="f_correct" value="${item.correctSpelling||''}" placeholder="如 building"></div>
      <div class="form-group"><label>错误原因</label>
        <select id="f_reason">
          <option value="字母顺序颠倒">字母顺序颠倒</option>
          <option value="漏字母">漏字母</option>
          <option value="多字母">多字母</option>
          <option value="大小写错误">大小写错误</option>
          <option value="拼写记忆混淆">拼写记忆混淆</option>
          <option value="词义记错">词义记错</option>
          <option value="其他">其他</option>
        </select>
      </div>
      <div class="form-group"><label>记忆备注</label><textarea id="f_note" placeholder="如 i在l前面">${item.note||''}</textarea></div>
      <div class="form-group"><label>复习日期</label><input id="f_review" type="date" value="${item.reviewDate||todayStr()}"></div>
    </div>
    <div class="modal-foot">
      ${id?'<button class="btn btn-outline" style="color:var(--red);border-color:var(--red)" onclick="deleteLedger(\''+id+'\')">删除</button>':''}
      <button class="btn btn-outline" onclick="closeModal()">取消</button>
      <button class="btn btn-primary" onclick="saveLedger()">保存</button>
    </div>
  `;
  if(item.reason){ document.getElementById('f_reason').value = item.reason; }
  document.getElementById('modalOverlay').classList.add('show');
}
function saveLedger(){
  const data = {
    word: document.getElementById('f_word').value.trim(),
    wrongSpelling: document.getElementById('f_wrong').value.trim(),
    correctSpelling: document.getElementById('f_correct').value.trim(),
    reason: document.getElementById('f_reason').value,
    note: document.getElementById('f_note').value.trim(),
    reviewDate: document.getElementById('f_review').value,
  };
  if(!data.word || !data.correctSpelling){ toast('请填写单词和正确拼写', 'red'); return; }
  if(editLedgerId){
    const idx = D.errorLedger.findIndex(x=>x.id===editLedgerId);
    if(idx>=0) D.errorLedger[idx] = Object.assign(D.errorLedger[idx], data);
  } else {
    D.errorLedger.unshift(Object.assign({ id:'el_'+Date.now(), createdDate:todayStr() }, data));
  }
  saveData();
  closeModal();
  renderModule();
  toast('已保存 ✅');
}
function deleteLedger(id){
  D.errorLedger = D.errorLedger.filter(x=>x.id!==id);
  saveData();
  closeModal();
  renderModule();
  toast('已删除', 'orange');
}
function closeModal(){ document.getElementById('modalOverlay').classList.remove('show'); }

// ============================================================
//  积分兑换
// ============================================================
function exchange(type){
  if(D.points.total < 50){ toast('积分不足！需要50分', 'red'); return; }
  let desc = '';
  if(type==='tv') desc = '看电视20分钟';
  else if(type==='money') desc = '5元零花钱';
  if(spendPoints(50, desc)){
    toast(`兑换成功：${desc} 🎉`, 'orange');
    renderModule();
  }
}

// ============================================================
//  宠物系统
// ============================================================
function feedPet(){
  if(D.points.total < 30){ toast('积分不足！需要30分换1袋狗粮', 'red'); return; }
  if(D.pet.fullness >= 100){ toast('小狗已经超级饱了！不能再喂啦~', 'orange'); return; }
  if(spendPoints(30, '兑换1袋狗粮')){
    D.pet.fullness = Math.min(100, D.pet.fullness + 20);
    D.pet.feedHistory.unshift({ date:todayStr(), time:new Date().toTimeString().slice(0,5), foodCount:1, costPoints:30 });
    saveData();
    updateTopBar();
    renderModule();
    const lvl = getPetLevel();
    toast(`${D.pet.name}吃饱啦！${lvl.desc} 🐶`, 'orange');
  }
}
function getPetLevel(){
  return PET_LEVELS.find(l => D.pet.fullness >= l.min && D.pet.fullness <= l.max) || PET_LEVELS[0];
}
function renamePet(){
  const modal = document.getElementById('modalBox');
  modal.innerHTML = `
    <div class="modal-head"><div class="mh-title">给小狗起个名字</div><button class="mh-close" onclick="closeModal()">×</button></div>
    <div class="modal-body">
      <div class="form-group"><label>小狗名字</label><input id="f_petname" value="${D.pet.name}" placeholder="如小黄、旺财"></div>
    </div>
    <div class="modal-foot"><button class="btn btn-outline" onclick="closeModal()">取消</button><button class="btn btn-primary" onclick="doRename()">确定</button></div>
  `;
  document.getElementById('modalOverlay').classList.add('show');
}
function doRename(){
  const name = document.getElementById('f_petname').value.trim();
  if(!name){ toast('请输入名字', 'red'); return; }
  D.pet.name = name;
  saveData();
  closeModal();
  updateTopBar();
  renderModule();
  toast('改名成功！🐶');
}

// ============================================================
//  导航 & 渲染
// ============================================================
function navTo(module){
  currentModule = module;
  document.querySelectorAll('.nav-item').forEach(el=>el.classList.remove('active'));
  const navEl = document.querySelector(`[data-module="${module}"]`);
  if(navEl) navEl.classList.add('active');
  renderModule();
  if(window.innerWidth <= 768) closeSidebar();
}
function toggleSidebar(){
  document.getElementById('sidebar').classList.toggle('show');
  document.getElementById('sidebar-overlay').classList.toggle('show');
}
function closeSidebar(){
  document.getElementById('sidebar').classList.remove('show');
  document.getElementById('sidebar-overlay').classList.remove('show');
}
function changeDate(delta){
  const d = new Date(currentDate+'T00:00:00');
  d.setDate(d.getDate() + delta);
  currentDate = d.toISOString().slice(0,10);
  updateTopBar();
  renderModule();
}

function updateTopBar(){
  const fi = fmtDate(currentDate);
  const el = document.getElementById('dateDisplay');
  el.innerHTML = `${fi.str}<span class="weekday">${fi.weekday}</span>`;
  if(isToday()) el.innerHTML += '';
  document.getElementById('pointsPill').textContent = '⭐ ' + D.points.total;
  const lvl = getPetLevel();
  document.getElementById('petPill').innerHTML = `${lvl.emoji}${lvl.mood} ${D.pet.fullness}%`;
}

function renderSidebar(){
  const nav = document.getElementById('nav');
  nav.innerHTML = NAV.map(item=>{
    let badge = '';
    if(item.id === 'ledger' && D.points.history.length){
      badge = `<span class="badge">${D.points.history.length}</span>`;
    }
    return `<div class="nav-item ${currentModule===item.id?'active':''}" data-module="${item.id}" onclick="navTo('${item.id}')">
      <span class="icon">${item.icon}</span><span>${item.name}</span>${badge}
    </div>`;
  }).join('');

  // 动态渲染侧边栏底部按钮（根据身份控制权限）
  var footer = document.getElementById('sidebarFooter');
  if(footer){
    var isAdmin = PERM.currentUser && PERM.currentUser.isAdmin;
    var btns = [];
    // 管理员才显示导出数据、导出源代码
    if(isAdmin){
      btns.push('<button onclick="exportData()">📥 导出数据</button>');
      btns.push('<button onclick="exportSourceCode()" style="margin-top:6px">💻 导出源代码</button>');
    }
    // 所有人可见：会员充值（仅展示收款二维码+缴费指引，不能开通权限）
    btns.push('<button onclick="showUserRecharge()" style="margin-top:6px">💳 会员充值</button>');
    btns.push('<button onclick="showNamingGuide()" style="margin-top:6px">📋 命名说明</button>');
    btns.push('<button onclick="showAdminLogin()" style="margin-top:8px;font-size:13px;opacity:.85;padding:8px 0">🔧 管理后台</button>');
    footer.innerHTML = btns.join('');
  }
}

function renderModule(){
  // 鉴权拦截：所有学习模块统一鉴权
  const auth = checkAuth();
  if(auth === 'nologin'){ showLoginScreen(); return; }
  if(auth === 'banned'){ showBannedNotice(); return; }
  if(auth === 'unpaid'){
    // 显示等待开通页面（不弹窗，避免反复弹出）
    showWaitingNotice();
    return;
  }

  const content = document.getElementById('content');
  const progress = getDayProgress(currentDate);

  // 顶部统计
  let statsHtml = `
    <div class="stat-row">
      <div class="stat-box"><div class="s-icon">📊</div><div class="s-value">${progress.done}/${progress.total}</div><div class="s-label">今日完成</div></div>
      <div class="stat-box"><div class="s-icon">⭐</div><div class="s-value">${D.points.total}</div><div class="s-label">累计积分</div></div>
      <div class="stat-box"><div class="s-icon">🔥</div><div class="s-value">${getStreak()}</div><div class="s-label">连续天数</div></div>
    </div>
  `;

  // 进度环
  let progressHtml = `
    <div class="progress-section">
      <div class="progress-ring">
        <svg width="120" height="120">
          <circle class="ring-bg" cx="60" cy="60" r="50"></circle>
          <circle class="ring-fg" cx="60" cy="60" r="50" stroke-dasharray="${2*Math.PI*50}" stroke-dashoffset="${2*Math.PI*50*(1-progress.pct/100)}"></circle>
        </svg>
        <div class="ring-text"><div class="rt-num">${progress.pct}%</div><div class="rt-label">完成度</div></div>
      </div>
      <div style="font-size:13px;color:var(--text-l)">${isToday()?'今天加油！':fmtDate(currentDate).str+'的任务记录'}</div>
    </div>
  `;

  let moduleHtml = '';
  switch(currentModule){
    case 'chinese':     moduleHtml = renderChinese(progress, statsHtml, progressHtml); break;
    case 'math':        moduleHtml = renderMath(statsHtml, progressHtml); break;
    case 'english':     moduleHtml = renderEnglish(statsHtml, progressHtml); break;
    case 'eng_reading': moduleHtml = renderEngReading(statsHtml, progressHtml); break;
    case 'sports':      moduleHtml = renderSports(statsHtml, progressHtml); break;
    case 'reading':     moduleHtml = renderReading(statsHtml, progressHtml); break;
    case 'handwriting': moduleHtml = renderHandwriting(statsHtml, progressHtml); break;
    case 'science':     moduleHtml = renderScience(statsHtml, progressHtml); break;
    case 'housework':   moduleHtml = renderHousework(statsHtml, progressHtml); break;
    case 'games':       moduleHtml = renderGames(statsHtml, progressHtml); break;
    case 'ledger':      moduleHtml = renderLedger(statsHtml); break;
    case 'pet':         moduleHtml = renderPet(statsHtml); break;
  }
  content.innerHTML = moduleHtml;
}

// ===== 语文 =====
function renderChinese(progress, stats, progRing){
  const rec = getModuleRecord(currentDate, 'chinese');
  let tasks = TASKS.chinese.map(t=>{
    const done = !!rec[t.id];
    let extra = '';
    if(t.id === 'recite'){
      // 显示完整背诵闯关列表（含原文+注释+译文+中心思想）
      const contentList = CHINESE_CONTENT;
      extra = `<div class="tc-extra">
        <div style="font-size:13px;font-weight:600;color:var(--green-7);margin-bottom:10px;display:flex;align-items:center;gap:6px">
          <span>📜</span><span>课内必背16篇闯关（点击展开原文+注释+译文）</span>
        </div>
        <div class="recite-list">
          ${contentList.map((c, i)=>{
            const prog = D.recitationProgress[i] || { dates:[], mastered:false };
            const doneToday = prog.dates.includes(currentDate);
            const dayCount = prog.dates.length;
            return `<div class="recite-item ${doneToday?'done':''}" onclick="toggleRecitationExpand(${i})">
              <div class="ri-num">${i+1}</div>
              <div class="ri-title-wrap">
                <div class="ri-title">${c.title}</div>
                <div class="ri-meta">${c.unit} · ${c.author} · 已背${dayCount}次 ${prog.mastered?'· ✅已掌握':''}</div>
              </div>
              <div class="ri-status" onclick="event.stopPropagation();toggleRecitation(${i})">${doneToday?'✅':'⬜'}</div>
              <div class="ri-arrow">▶</div>
            </div>
            <div class="recite-detail" id="recite-detail-${i}" style="display:none">
              <div class="rd-block">
                <div class="rd-label">📖 原文</div>
                <div class="rd-content poem">${c.content.replace(/\n/g,'<br>')}</div>
              </div>
              <div class="rd-block">
                <div class="rd-label">📝 注释</div>
                <div class="rd-content">${c.notes.replace(/①/g,'<br>①').replace(/^<br>/,'')}</div>
              </div>
              <div class="rd-block">
                <div class="rd-label">💡 译文</div>
                <div class="rd-content translation">${c.translation}</div>
              </div>
              <div class="rd-block">
                <div class="rd-label">🎯 中心思想</div>
                <div class="rd-content theme">${c.theme}</div>
              </div>
              <div class="rd-block">
                <div class="rd-label">📋 背诵要求</div>
                <div class="rd-content req">流利无卡顿 · 无错字漏句 · 熟练默写</div>
              </div>
            </div>`;
          }).join('')}
        </div>
      </div>`;
    }
    if(t.id === 'reading'){
      // 阅读理解真题库
      const day = new Date(currentDate).getDate();
      const idx = day % READING_COMP.length;
      const r = READING_COMP[idx];
      extra = `<div class="tc-extra">
        <div style="font-size:13px;font-weight:600;color:var(--green-7);margin-bottom:10px;display:flex;align-items:center;gap:6px">
          <span>📖</span><span>今日阅读理解真题（难度${r.level}）</span>
        </div>
        <div class="reading-card">
          <div class="rc-title">${r.title}</div>
          <div class="rc-text">${r.text.replace(/\n/g,'<br>')}</div>
          <div class="rc-questions">
            <div class="rcq"><span class="rcq-num">1.</span>${r.q1}<div class="rcq-a">【参考答案】${r.a1}</div></div>
            <div class="rcq"><span class="rcq-num">2.</span>${r.q2}<div class="rcq-a">【参考答案】${r.a2}</div></div>
            <div class="rcq"><span class="rcq-num">3.</span>${r.q3}<div class="rcq-a">【参考答案】${r.a3}</div></div>
          </div>
        </div>
      </div>`;
    }
    return renderTaskCard('chinese', t, done, extra);
  }).join('');

  // 自定义任务
  let customHtml = renderCustomTasks('chinese');

  return `${stats}${progRing}
    <div class="module-header"><span class="m-icon">📖</span><div><div class="m-title">每日语文任务</div><div class="m-desc">四年级·人教版四上衔接 · 课内必背16篇+阅读理解+晚间阅读</div></div></div>
    ${tasks}${customHtml}
  `;
}

// 切换背诵内容展开
function toggleRecitationExpand(i){
  const el = document.getElementById('recite-detail-'+i);
  if(!el) return;
  const isOpen = el.style.display === 'block';
  // 关闭所有
  document.querySelectorAll('.recite-detail').forEach(d=>d.style.display='none');
  document.querySelectorAll('.ri-arrow').forEach(a=>a.textContent='▶');
  if(!isOpen){
    el.style.display='block';
    const arrow = el.previousElementSibling.querySelector('.ri-arrow');
    if(arrow) arrow.textContent='▼';
    setTimeout(()=>el.scrollIntoView({behavior:'smooth',block:'nearest'}),50);
  }
}

// ===== 数学 =====
let calcState = {problems:[], answers:[], started:false, finished:false, timer:null, timeLeft:1200, submitted:false};
let wpState = {questions:[], idx:0, seed:0, userAnswers:{}, submitted:{}};
let olyState = {questions:[], idx:0, seed:0, userAnswers:{}, submitted:{}};

function renderMath(stats, progRing){
  const rec = getModuleRecord(currentDate, 'math');
  let tasks = TASKS.math.map(t=>{
    const done = !!rec[t.id];
    let extra = '';
    if(t.id === 'calc'){
      extra = renderCalcExtra();
    }
    if(t.id === 'word_problems'){
      extra = renderWordProblemsExtra();
    }
    if(t.id === 'olympiad'){
      extra = renderOlympiadExtra();
    }
    return renderTaskCard('math', t, done, extra);
  }).join('');
  let customHtml = renderCustomTasks('math');
  return `${stats}${progRing}
    <div class="module-header"><span class="m-icon">🧮</span><div><div class="m-title">每日数学任务</div><div class="m-desc">海量速算 · 上千道应用题 · 上千道思维拓展 · 三大模块全面提升数学能力</div></div></div>
    ${tasks}${customHtml}
  `;
}

// ---- 计时速算训练 ----
function generateCalcProblems(){
  const probs = [];
  const types = [
    // 3-digit + 3-digit
    () => { const a=rand(100,499), b=rand(100,499); return {expr:`${a} + ${b}`, ans:a+b}; },
    // 3-digit - 3-digit
    () => { let a=rand(300,899), b=rand(100,a); return {expr:`${a} - ${b}`, ans:a-b}; },
    // 2-digit × 1-digit
    () => { const a=rand(12,89), b=rand(3,9); return {expr:`${a} × ${b}`, ans:a*b}; },
    // 3-digit ÷ 1-digit (exact)
    () => { const b=rand(3,9); const q=rand(20,120); const a=q*b; return {expr:`${a} ÷ ${b}`, ans:q}; },
    // 2-digit × 2-digit
    () => { const a=rand(11,49), b=rand(11,39); return {expr:`${a} × ${b}`, ans:a*b}; },
    // mixed: a × b + c
    () => { const a=rand(5,19), b=rand(3,9), c=rand(10,99); return {expr:`${a} × ${b} + ${c}`, ans:a*b+c}; },
    // mixed: a + b × c
    () => { const a=rand(10,99), b=rand(5,19), c=rand(3,9); return {expr:`${a} + ${b} × ${c}`, ans:a+b*c}; },
    // mixed: a × b - c (ensure non-negative)
    () => { const a=rand(8,19), b=rand(4,9); const p=a*b; const c=rand(5,p-1); return {expr:`${a} × ${b} - ${c}`, ans:p-c}; },
    // 4-digit + 4-digit
    () => { const a=rand(1000,4999), b=rand(1000,4999); return {expr:`${a} + ${b}`, ans:a+b}; },
    // 4-digit - 3-digit
    () => { let a=rand(2000,8999), b=rand(100,999); if(b>a) [a,b]=[b,a]; return {expr:`${a} - ${b}`, ans:a-b}; },
    // 3-digit ÷ 1-digit with remainder
    () => { const b=rand(4,9); const a=rand(100,899); return {expr:`${a} ÷ ${b} = ...余...`, ans:`${Math.floor(a/b)}余${a%b}`, isRemainder:true, q:a, d:b}; },
    // simple equation: x + a = b
    () => { const x=rand(10,89), a=rand(10,89); return {expr:`x + ${a} = ${x+a}, x=?`, ans:x}; },
    // simple equation: x - a = b
    () => { const x=rand(50,199), a=rand(10,49); return {expr:`x - ${a} = ${x-a}, x=?`, ans:x}; },
    // simple equation: ax = b
    () => { const x=rand(5,19), a=rand(3,9); return {expr:`${a}x = ${a*x}, x=?`, ans:x}; },
    // 3-digit + 2-digit
    () => { const a=rand(100,899), b=rand(10,99); return {expr:`${a} + ${b}`, ans:a+b}; },
    // 3-digit - 2-digit
    () => { let a=rand(200,999), b=rand(10,99); return {expr:`${a} - ${b}`, ans:a-b}; },
    // 2-digit × 2-digit (larger)
    () => { const a=rand(21,79), b=rand(21,79); return {expr:`${a} × ${b}`, ans:a*b}; },
    // 4-digit ÷ 1-digit (exact)
    () => { const b=rand(3,9); const q=rand(100,500); const a=q*b; return {expr:`${a} ÷ ${b}`, ans:q}; },
    // mixed: a + b ÷ c
    () => { const c=rand(3,9); const b=rand(3,9)*c; const a=rand(10,99); return {expr:`${a} + ${b} ÷ ${c}`, ans:a+b/c}; },
    // mixed: (a + b) × c
    () => { const a=rand(5,19), b=rand(5,19), c=rand(3,9); return {expr:`(${a} + ${b}) × ${c}`, ans:(a+b)*c}; },
    // mixed: a × b ÷ c (exact)
    () => { const c=rand(2,5); const b=rand(3,9); const a=c*rand(3,9); return {expr:`${a} × ${b} ÷ ${c}`, ans:a*b/c}; },
    // 3-digit ÷ 2-digit (exact)
    () => { const b=rand(11,29); const q=rand(5,20); const a=q*b; return {expr:`${a} ÷ ${b}`, ans:q}; },
    // 5-digit + 4-digit
    () => { const a=rand(10000,49999), b=rand(1000,9999); return {expr:`${a} + ${b}`, ans:a+b}; },
    // 5-digit - 4-digit
    () => { let a=rand(20000,59999), b=rand(1000,9999); return {expr:`${a} - ${b}`, ans:a-b}; },
    // 2-digit × 3-digit
    () => { const a=rand(12,49), b=rand(100,299); return {expr:`${a} × ${b}`, ans:a*b}; },
    // mixed: a × b - c × d
    () => { const a=rand(5,15), b=rand(3,7), c=rand(3,9), d=rand(2,6); const r=a*b-c*d; if(r<0) return {expr:`${c*d} - ${a} × ${b}`, ans:-r}; return {expr:`${a} × ${b} - ${c} × ${d}`, ans:r}; },
  ];
  for(let i=0; i<60; i++){
    const fn = types[i % types.length];
    probs.push(fn());
  }
  return probs;
}

function rand(min, max){ return Math.floor(Math.random()*(max-min+1))+min; }

function renderCalcExtra(){
  const today = todayStr();
  const seed = hashCode(today);
  // Generate based on date seed for consistency within a day
  Math.seedrandom && Math.seedrandom(seed);
  if(!calcState.problems.length || calcState.dateKey !== today){
    calcState.problems = generateCalcProblems();
    calcState.answers = new Array(60).fill('');
    calcState.started = false;
    calcState.finished = false;
    calcState.timeLeft = 1200;
    calcState.submitted = false;
    calcState.dateKey = today;
    if(calcState.timer){ clearInterval(calcState.timer); calcState.timer = null; }
  }
  let timerHtml = '';
  if(calcState.started && !calcState.finished){
    const m = Math.floor(calcState.timeLeft/60);
    const s = calcState.timeLeft%60;
    timerHtml = `<div class="calc-timer" id="calcTimerDisplay">⏱ ${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}</div>`;
  } else if(calcState.finished){
    timerHtml = `<div class="calc-timer done">✅ 已完成</div>`;
  } else {
    timerHtml = `<div class="calc-timer" style="color:var(--green-7);background:var(--green-1)">⏱ 20:00</div>`;
  }
  let resultHtml = '';
  if(calcState.submitted){
    let correct=0;
    calcState.problems.forEach((p,i)=>{
      const ua = (calcState.answers[i]||'').trim();
      if(p.isRemainder){
        if(ua === `${Math.floor(p.q/p.d)}余${p.q%p.d}`) correct++;
      } else {
        if(parseInt(ua) === p.ans) correct++;
      }
    });
    resultHtml = `<div class="calc-result">
      <div class="calc-result-score">🎯 ${correct} / 60</div>
      <div class="calc-result-detail">正确率 ${(correct/60*100).toFixed(1)}% · 用时 ${Math.floor((1200-calcState.timeLeft)/60)}分${(1200-calcState.timeLeft)%60}秒</div>
    </div>`;
  }
  let btns = '';
  if(!calcState.started){
    btns = `<button class="calc-btn start" onclick="startCalc()">▶️ 开始计时</button>`;
  } else if(calcState.started && !calcState.finished){
    btns = `<button class="calc-btn submit" onclick="submitCalc()">✅ 提交判分</button>
            <button class="calc-btn reset" onclick="resetCalc()">🔄 重新出题</button>`;
  } else {
    btns = `<button class="calc-btn start" onclick="resetCalc()">🔄 再来一组</button>`;
  }
  let grid = '';
  if(calcState.started || calcState.finished){
    grid = calcState.problems.map((p,i)=>{
      const ua = calcState.answers[i] || '';
      let cls = '';
      let ansHtml = '';
      if(calcState.submitted){
        const correct = p.isRemainder ? ua.trim()===`${Math.floor(p.q/p.d)}余${p.q%p.d}` : parseInt(ua)===p.ans;
        cls = correct ? 'correct' : 'wrong';
        ansHtml = `<div class="calc-ans ${correct?'':'wrong'}">${p.isRemainder?`${Math.floor(p.q/p.d)}余${p.q%p.d}`:p.ans}</div>`;
      }
      return `<div class="calc-item ${cls}">
        <div class="calc-expr">${p.expr} =</div>
        <input class="calc-input" type="text" inputmode="numeric" value="${ua}" placeholder="?" 
          oninput="calcState.answers[${i}]=this.value" 
          ${calcState.submitted?'disabled':''}
          onchange="saveCalcAnswers()">
      </div>`;
    }).join('');
  }
  let info = calcState.started && !calcState.finished ? '<span class="calc-info">📝 在输入框填写答案，完成后点击"提交判分"</span>' : '';
  if(!calcState.started) info = '<span class="calc-info">📋 点击"开始计时"生成60道随机计算题，限时20分钟</span>';
  if(calcState.finished) info = '<span class="calc-info">📊 绿色=正确，红色=错误（下方显示正确答案）</span>';
  return `<div class="tc-extra">
    <div class="calc-bar">${timerHtml}${info}</div>
    ${calcState.started||calcState.finished ? `<div class="calc-grid">${grid}</div>` : ''}
    ${resultHtml}
    <div class="calc-btns">${btns}</div>
  </div>`;
}

function hashCode(s){ let h=0; for(let i=0;i<s.length;i++){h=((h<<5)-h+s.charCodeAt(i))|0;} return h; }

function startCalc(){
  calcState.started = true;
  calcState.finished = false;
  calcState.timeLeft = 1200;
  calcState.submitted = false;
  if(calcState.timer) clearInterval(calcState.timer);
  calcState.timer = setInterval(()=>{
    calcState.timeLeft--;
    if(calcState.timeLeft <= 0){
      calcState.timeLeft = 0;
      submitCalc();
    } else {
      // 只更新计时器显示，不重渲染整个模块（避免输入框闪退）
      const timerEl = document.getElementById('calcTimerDisplay');
      if(timerEl){
        const m = Math.floor(calcState.timeLeft/60);
        const s = calcState.timeLeft%60;
        timerEl.textContent = '\u23F1 ' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
      }
    }
  }, 1000);
  renderModule();
}

function submitCalc(){
  if(calcState.timer){ clearInterval(calcState.timer); calcState.timer = null; }
  calcState.finished = true;
  calcState.submitted = true;
  saveCalcAnswers();
  renderModule();
}

function resetCalc(){
  if(calcState.timer){ clearInterval(calcState.timer); calcState.timer = null; }
  calcState.problems = generateCalcProblems();
  calcState.answers = new Array(60).fill('');
  calcState.started = false;
  calcState.finished = false;
  calcState.timeLeft = 1200;
  calcState.submitted = false;
  renderModule();
}

function saveCalcAnswers(){
  // answers are stored in calcState, no need to persist separately
}

// ---- 规范应用题训练 ----
function renderWordProblemsExtra(){
  const today = todayStr();
  if(!wpState.questions.length || wpState.dateKey !== today){
    wpState.questions = getAppProblems(5);
    wpState.idx = 0;
    wpState.userAnswers = {};
    wpState.submitted = {};
    wpState.dateKey = today;
  }
  const q = wpState.questions[wpState.idx];
  const qKey = 'q'+wpState.idx;
  const userAns = wpState.userAnswers[qKey] || '';
  const isSubmitted = wpState.submitted[qKey];
  // Check answer
  const correctAns = String(q.a).replace(/[^0-9A-Za-z\u4e00-\u9fff余,.]/g,'');
  const userClean = userAns.replace(/[^0-9A-Za-z\u4e00-\u9fff余,.]/g,'');
  const isCorrect = isSubmitted && (userClean === correctAns || String(q.a).includes(userClean) || userClean.includes(correctAns));
  let dots = wpState.questions.map((_,i)=>{
    let cls = i < wpState.idx ? 'done' : (i===wpState.idx ? 'current' : '');
    return `<div class="oly-prog-dot ${cls}"></div>`;
  }).join('');
  let nav = '';
  if(wpState.idx > 0){
    nav += `<button class="calc-btn reset" onclick="wpState.idx--;renderModule()">‹ 上一题</button>`;
  }
  if(wpState.idx < wpState.questions.length-1){
    nav += `<button class="calc-btn start" onclick="wpState.idx++;renderModule()">下一题 ›</button>`;
  } else {
    nav += `<button class="calc-btn submit" onclick="resetWordProblems()">🔄 重新组卷</button>`;
  }
  let answerSection = '';
  if(!isSubmitted){
    answerSection = `<div class="wp-answer-input-wrap">
      <div class="wp-answer-label">✍️ 在此输入你的答案：</div>
      <div class="wp-answer-input-row">
        <input class="wp-answer-input" type="text" placeholder="输入答案..." value="${userAns}"
          oninput="wpState.userAnswers['${qKey}']=this.value">
        <button class="calc-btn submit" onclick="submitWpAnswer(${wpState.idx})">✅ 提交答案</button>
      </div>
    </div>`;
  } else {
    answerSection = `<div class="wp-answer-result ${isCorrect?'correct':'wrong'}">
      <div class="wp-result-status">${isCorrect?'✅ 回答正确！':'❌ 答案不正确，再看看解析吧'}</div>
      <div class="wp-result-your">你的答案：${userAns || '（未作答）'}</div>
      <div class="wp-result-correct">正确答案：${q.a}</div>
    </div>
    <div class="oly-toggle show" onclick="this.nextElementSibling.classList.toggle('show')">💡 查看解题思路</div>
    <div class="wp-analysis show">${q.analysis}</div>`;
  }
  return `<div class="tc-extra">
    <div style="font-size:13px;font-weight:600;color:var(--green-7);margin-bottom:8px;display:flex;align-items:center;gap:6px">
      <span>✏️</span><span>应用题训练（第${wpState.idx+1}题/共${wpState.questions.length}题）</span><span style="font-size:11px;color:var(--green-5);background:var(--green-1);padding:2px 8px;border-radius:8px">题库${getAppTotal()}道</span>
    </div>
    <div class="oly-prog">${dots}</div>
    <div class="wp-card">
      <span class="wp-cat ${q.type}">${q.type}</span>
      <div class="wp-q">${q.q}</div>
      ${answerSection}
    </div>
    <div class="wp-nav"><div class="wp-nav-btns">${nav}</div></div>
  </div>`;
}

function submitWpAnswer(idx){
  wpState.submitted['q'+idx] = true;
  renderModule();
}

function resetWordProblems(){
  wpState.questions = getAppProblems(5);
  wpState.idx = 0;
  wpState.userAnswers = {};
  wpState.submitted = {};
  renderModule();
}

// ---- 浅奥思维拓展 ----
function renderOlympiadExtra(){
  const today = todayStr();
  if(!olyState.questions.length || olyState.dateKey !== today){
    olyState.questions = getOlympiadProblems(5);
    olyState.idx = 0;
    olyState.userAnswers = {};
    olyState.submitted = {};
    olyState.dateKey = today;
  }
  const q = olyState.questions[olyState.idx];
  const qKey = 'q'+olyState.idx;
  const userAns = olyState.userAnswers[qKey] || '';
  const isSubmitted = olyState.submitted[qKey];
  const correctAns = String(q.a).replace(/[^0-9A-Za-z\u4e00-\u9fff余,.]/g,'');
  const userClean = userAns.replace(/[^0-9A-Za-z\u4e00-\u9fff余,.]/g,'');
  const isCorrect = isSubmitted && (userClean === correctAns || String(q.a).includes(userClean) || userClean.includes(correctAns));
  let dots = olyState.questions.map((_,i)=>{
    let cls = i < olyState.idx ? 'done' : (i===olyState.idx ? 'current' : '');
    return `<div class="oly-prog-dot ${cls}"></div>`;
  }).join('');
  let nav = '';
  if(olyState.idx > 0){
    nav += `<button class="calc-btn reset" onclick="olyState.idx--;renderModule()">‹ 上一题</button>`;
  }
  if(olyState.idx < olyState.questions.length-1){
    nav += `<button class="calc-btn start" onclick="olyState.idx++;renderModule()">下一题 ›</button>`;
  } else {
    nav += `<button class="calc-btn submit" onclick="resetOlympiad()">🔄 重新抽取</button>`;
  }
  let answerSection = '';
  if(!isSubmitted){
    answerSection = `<div class="oly-toggle" onclick="this.nextElementSibling.classList.toggle('show')">💡 需要提示？点击查看</div>
      <div class="oly-hint">${q.hint}</div>
      <div class="wp-answer-input-wrap">
        <div class="wp-answer-label">✍️ 在此输入你的答案：</div>
        <div class="wp-answer-input-row">
          <input class="wp-answer-input" type="text" placeholder="输入答案..." value="${userAns}"
            oninput="olyState.userAnswers['${qKey}']=this.value">
          <button class="calc-btn submit" onclick="submitOlyAnswer(${olyState.idx})">✅ 提交答案</button>
        </div>
      </div>`;
  } else {
    answerSection = `<div class="wp-answer-result ${isCorrect?'correct':'wrong'}">
      <div class="wp-result-status">${isCorrect?'✅ 回答正确！':'❌ 答案不正确，看看解析吧'}</div>
      <div class="wp-result-your">你的答案：${userAns || '（未作答）'}</div>
      <div class="wp-result-correct">正确答案：${q.a}</div>
    </div>
    <div class="oly-a show">${q.a}${q.analysis?'<br><br>📌 解析：'+q.analysis:''}</div>`;
  }
  return `<div class="tc-extra">
    <div style="font-size:13px;font-weight:600;color:var(--green-7);margin-bottom:8px;display:flex;align-items:center;gap:6px">
      <span>🧠</span><span>浅奥思维题（第${olyState.idx+1}题/共${olyState.questions.length}题）</span><span style="font-size:11px;color:var(--green-5);background:var(--green-1);padding:2px 8px;border-radius:8px">题库${getOlympiadTotal()}道</span>
      <span class="oly-level L${q.level||1}">${['','基础','进阶','挑战','竞赛'][q.level||1]}</span>
    </div>
    <div class="oly-prog">${dots}</div>
    <div class="oly-card">
      <span class="oly-type ${q.type}">${q.type}</span>
      <div class="oly-q"><b>${q.title}：</b>${q.q}</div>
      ${answerSection}
    </div>
    <div class="wp-nav"><div class="wp-nav-btns">${nav}</div></div>
  </div>`;
}

function submitOlyAnswer(idx){
  olyState.submitted['q'+idx] = true;
  renderModule();
}

function resetOlympiad(){
  olyState.questions = getOlympiadProblems(5);
  olyState.idx = 0;
  olyState.userAnswers = {};
  olyState.submitted = {};
  renderModule();
}

// ===== 英语 =====
function renderEnglish(stats, progRing){
  const rec = getModuleRecord(currentDate, 'english');
  let tasks = TASKS.english.map(t=>{
    const done = !!rec[t.id];
    let extra = '';
    if(t.id === 'read_aloud'){
      const day = new Date(currentDate).getDate();
      const todayUnit = ((day - 1) % 8) + 1;

      // ===== 视图1：单元目录列表（首页，截图2样式）=====
      if(engView === 'home'){
        const unitListHtml = `<div class="eng-unit-list">
          <div class="eng-unit-list-title">📚 沪教版四上课本内容（点击单元展开跟读）<span class="hint">今日推荐：Unit ${todayUnit}</span></div>
          ${Object.entries(ENGLISH_PAGES).map(([unitNum, unitData])=>{
            const isToday = parseInt(unitNum) === todayUnit;
            return `<div class="eng-unit-item" onclick="engEnterUnit(${unitNum})">
              <div class="eng-unit-num">${unitNum}</div>
              <div class="eng-unit-title">Unit ${unitNum}: ${unitData.title}${isToday?'（今日跟读）':''}</div>
              ${isToday?'<span class="eng-unit-badge">⭐今日</span>':''}
              <div class="eng-unit-arrow">▶</div>
            </div>`;
          }).join('')}
        </div>`;
        extra = `<div class="tc-extra">
          <div style="font-size:13px;font-weight:600;color:var(--green-7);margin-bottom:10px;display:flex;align-items:center;gap:6px">
            <span>📖</span><span>选择单元开始跟读（沪教版四上英语电子课本）</span>
            <span style="font-size:11px;color:var(--orange);background:#FFF3E0;padding:2px 8px;border-radius:8px;margin-left:auto">⭐${D.stars||0}</span>
          </div>
          <div style="font-size:11px;color:var(--text-l);margin-bottom:10px;padding:6px 10px;background:#F5F5F5;border-radius:6px;line-height:1.6">
            📋 学习流程：① 首页选择要跟读的单元（8个单元任选）→ ② 进入单元翻页跟读（每单元5页）→ ③ 单句播放+录音跟读模仿发音、语调、停顿 → ④ 顶部 ⏱️ 自动累计30分钟学习时长 → ⑤ 完成所有页面后点击任务完成
          </div>
          ${unitListHtml}
        </div>`;
      }
      // ===== 视图2：单元内跟读页面（截图1样式，保留全部原功能）=====
      else {
      engPageInitState();
      const unitData = ENGLISH_PAGES[engSelectedUnit];
      const page = unitData.pages[engPageState.pageIdx];
      const u = ENGLISH_CONTENT[todayUnit];
      const totalPages = unitData.pages.length;

      // 返回单元目录按钮
      const backBtnHtml = `<button class="eng-back-btn" onclick="engBackToUnits()">‹ 返回单元目录</button>`;

      // 页面导航器（pill样式，对标截图）
      const pageNavHtml = `<div class="eng-page-nav">
        ${unitData.pages.map((p, i)=>`<button class="eng-page-pill ${i===engPageState.pageIdx?'active':''}" onclick="engPageGoTo(${i})">第${['一','二','三','四','五','六','七','八','九','十'][i]}页</button>`).join('')}
      </div>`;

      // 顶部统一控制栏：计时器 + 倍速选择器 + 转发按钮
      const studyTime = formatStudyTime(engPageState.studySeconds);
      const topControlsHtml = `<div class="eng-top-controls">
        <button class="eng-timer-btn ${engPageState.studying?'':'paused'}" onclick="engToggleStudy()" title="点击开始/暂停计时">
          ${engPageState.studying?'⏸️':'⏱️'} <span id="engTimerDisplay">${studyTime}</span> / 30:00
        </button>
        <div class="eng-speed-selector">
          <button class="eng-speed-btn ${engPageState.speed===0.75?'active':''}" onclick="engSetSpeed(0.75)">0.75x</button>
          <button class="eng-speed-btn ${engPageState.speed===1.0?'active':''}" onclick="engSetSpeed(1.0)">1X</button>
          <button class="eng-speed-btn ${engPageState.speed===1.25?'active':''}" onclick="engSetSpeed(1.25)">1.25x</button>
        </div>
        <button class="eng-forward-btn" onclick="engPageNext()" title="下一页">⏩</button>
      </div>`;

      // 页面标题
      const pageTitleHtml = `<div class="eng-page-title">
        <span class="eng-page-title-tag">第${['一','二','三','四','五','六','七','八','九','十'][engPageState.pageIdx]}页</span>
        ${page.title}
      </div>`;

      // 单句列表（英文+中文，对标截图）
      const sentListHtml = `<div class="eng-sent-list">
        ${page.pairs.map((pair, i)=>{
          const isPlaying = engPageState.currentSentIdx === i;
          const isRecording = engPageState.recordingSentIdx === i;
          return `<div class="eng-sent-pair">
            <div class="eng-sent-en ${isPlaying?'playing':''} ${isRecording?'recording':''}" onclick="engPlaySentPair(${JSON.stringify(pair[0]).replace(/"/g,'&quot;')},${i})">
              <span class="play-icon">${isRecording?'🔴':(isPlaying?'🔊':'▶')}</span>${pair[0]}
              <button style="margin-left:auto;background:none;border:none;font-size:13px;color:#E65100;cursor:pointer;padding:2px 6px" onclick="event.stopPropagation();engRecordSentPair(${JSON.stringify(pair[0]).replace(/"/g,'&quot;')},${i})" title="录音跟读">${isRecording?'⏹️':'🎤'}</button>
            </div>
            <div class="eng-sent-zh">${pair[1]}</div>
          </div>`;
        }).join('')}
      </div>`;

      // 底部页面操作
      const fullPlaying = engPageState.fullPlaying;
      const pageActionsHtml = `<div class="eng-page-actions">
        <button class="eng-page-btn secondary" onclick="engPagePrev()" ${engPageState.pageIdx===0?'disabled':''}>‹ 上一页</button>
        ${fullPlaying
          ? '<button class="eng-page-btn danger" onclick="engStopFullPage()">⏸ 暂停</button>'
          : '<button class="eng-page-btn primary" onclick="engPlayFullPage()">▶ 播放本页全文</button>'}
        <button class="eng-page-btn ${engPageState.loopMode?'danger':'record'}" onclick="engToggleLoop()">${engPageState.loopMode?'⏹ 停止循环':'🔁 逐句循环'}</button>
        <button class="eng-page-btn secondary" onclick="engPageNext()" ${engPageState.pageIdx>=totalPages-1?'disabled':''}>下一页 ›</button>
      </div>`;

      // 学习提示
      const tipHtml = `<div class="eng-study-tip">
        💡 学习流程：① 翻页选择要跟读的页面（每日5页）→ ② 点击英文句子单独播放或"逐句循环" → ③ 点击 🎤 录音跟读，模仿发音、语调、停顿 → ④ 顶部 ⏱️ 自动累计30分钟学习时长 → ⑤ 全部页面完成后点击任务完成
      </div>`;

      extra = `<div class="tc-extra">
        ${backBtnHtml}
        <div style="font-size:13px;font-weight:600;color:var(--green-7);margin-bottom:10px;display:flex;align-items:center;gap:6px;flex-wrap:wrap">
          <span>📚</span><span>Unit ${engPageState.unit}: ${unitData.title}</span>
          ${parseInt(engPageState.unit)===todayUnit?'<span style="font-size:11px;color:var(--orange);background:#FFF3E0;padding:2px 8px;border-radius:8px">（今日推荐）</span>':''}
          <span style="font-size:11px;color:var(--green-5);background:var(--green-1);padding:2px 8px;border-radius:8px">${totalPages}页</span>
          <span style="font-size:11px;color:var(--orange);background:#FFF3E0;padding:2px 8px;border-radius:8px;margin-left:auto">⭐${D.stars||0}</span>
        </div>
        <div class="eng-reader-new">
          ${pageNavHtml}
          ${topControlsHtml}
          ${pageTitleHtml}
          ${sentListHtml}
          ${pageActionsHtml}
          ${tipHtml}
        </div>
        <div class="eng-section" style="margin-top:12px">
          <div class="eng-sec-label">🔑 重点句型 · ${u.pattern}</div>
        </div>
        <div class="eng-section">
          <div class="eng-sec-label">📝 语法要点 · ${u.grammar}</div>
        </div>
      </div>`;
      }
    }
    if(t.id === 'dictation'){
      const day = new Date(currentDate).getDate();
      const todayUnit = ((day - 1) % 8) + 1;
      const u = ENGLISH_CONTENT[todayUnit];
      const startIdx = (day % u.words.length);
      const dictWords = [];
      for(let i=0;i<5;i++){ dictWords.push(u.words[(startIdx+i)%u.words.length]); }
      const today = todayStr();
      if(!engDictState.dateKey || engDictState.dateKey !== today){
        engDictState = {dateKey:today, inputs:['','','','',''], submitted:false, stars:0};
      }
      let dictContent = '';
      if(!engDictState.submitted){
        dictContent = `<div class="eng-word-dict-list">
          ${dictWords.map((w,i)=>`<div class="eng-word-dict-item">
            <button class="eng-word-play" onclick="engSpeakWord('${w.w}')">🔊</button>
            <span class="eng-word-meaning">${w.m}</span>
            <input class="eng-word-input" type="text" placeholder="拼写单词..." value="${engDictState.inputs[i]||''}"
              oninput="engDictState.inputs[${i}]=this.value">
          </div>`).join('')}
        </div>
        <button class="eng-audio-btn submit" onclick="engSubmitWordDict()" style="margin-top:10px">✅ 提交默写</button>`;
      } else {
        let correctCount = 0;
        const results = dictWords.map((w,i)=>{
          const userInput = (engDictState.inputs[i]||'').trim().toLowerCase();
          const isCorrect = userInput === w.w.toLowerCase();
          if(isCorrect) correctCount++;
          return `<div class="eng-word-dict-result ${isCorrect?'correct':'wrong'}">
            <span class="eng-word-play">🔊</span>
            <span class="eng-word-meaning">${w.m}</span>
            <span class="eng-word-user ${isCorrect?'':'wrong'}">${engDictState.inputs[i]||'（空）'}</span>
            <span class="eng-word-correct">${w.w}</span>
            <span class="eng-word-status">${isCorrect?'✅':'❌'}</span>
          </div>`;
        }).join('');
        const allCorrect = correctCount === 5;
        if(allCorrect && !engDictState.starsAwarded){
          engDictState.stars = 5;
          engDictState.starsAwarded = true;
          addStars(5);
        }
        dictContent = `<div class="eng-dict-result ${allCorrect?'pass':'fail'}" style="margin-bottom:10px">
          <div class="eng-dict-score">🎯 默写结果：${correctCount}/5 正确 ${allCorrect?'✅ 全对！获得 ⭐5 颗星星':'❌ 继续努力！'}</div>
        </div>
        <div class="eng-word-dict-list">${results}</div>
        <button class="eng-audio-btn" onclick="engDictState.submitted=false;renderModule()" style="margin-top:10px">🔄 重新默写</button>`;
      }
      extra = `<div class="tc-extra">
        <div style="font-size:13px;font-weight:600;color:var(--green-7);margin-bottom:8px;display:flex;align-items:center;gap:6px">
          <span>✍️</span><span>今日默写5词（Unit ${todayUnit}）</span>
          ${engDictState.stars?`<span style="font-size:11px;color:var(--orange);background:#FFF3E0;padding:2px 8px;border-radius:8px">⭐${engDictState.stars}</span>`:''}
        </div>
        <div style="font-size:11px;color:var(--text-l);margin-bottom:8px">💡 点击🔊听发音，在输入框拼写单词，提交后自动判分。错题将自动登记到下方台账，定期复盘</div>
        ${dictContent}
      </div>`;
    }
    return renderTaskCard('english', t, done, extra);
  }).join('');
  let customHtml = renderCustomTasks('english');

  // 单词表
  let vocabHtml = Object.entries(ENGLISH_VOCAB).map(([unit, words])=>{
    return `<div class="vocab-section">
      <div class="vs-title">${unit}</div>
      <div class="vocab-grid">
        ${words.map(w=>`<div class="vocab-card"><div class="vc-word">${w.word}</div><div class="vc-meaning">${w.meaning}</div></div>`).join('')}
      </div>
    </div>`;
  }).join('');

  // 错题台账
  let ledgerHtml = '';
  if(D.errorLedger.length > 0){
    ledgerHtml = `<div class="ledger-table-wrap">
      <table class="ledger-table">
        <thead><tr><th>单词</th><th>错误写法</th><th>正确拼写</th><th>错误原因</th><th>记忆备注</th><th>复习日期</th><th class="col-action">操作</th></tr></thead>
        <tbody>
          ${D.errorLedger.map(item=>`<tr>
            <td><b>${item.word}</b></td><td style="color:var(--red)">${item.wrongSpelling||'-'}</td><td style="color:var(--green-6)">${item.correctSpelling}</td>
            <td>${item.reason}</td><td>${item.note||'-'}</td><td>${item.reviewDate}</td>
            <td class="col-action"><button class="tc-btn" onclick="showLedgerModal('${item.id}')">编辑</button></td>
          </tr>`).join('')}
        </tbody>
      </table>
    </div>`;
  } else {
    ledgerHtml = `<div class="empty-state"><div class="es-icon">📝</div><div class="es-text">暂无错题记录。默写训练中的错题将自动登记到此，也可手动添加</div></div>`;
  }

  return `${stats}${progRing}
    <div class="module-header"><span class="m-icon">🗣️</span><div><div class="m-title">每日英语任务（附错题台账）</div><div class="m-desc">26秋沪教版四上英语电子课本 · 每日30分钟 · 课本跟读+单词默写+错题台账</div></div></div>
    ${tasks}${customHtml}
    <div class="section-title">📊 单词错题专属台账</div>
    <div style="margin-bottom:12px"><button class="btn btn-orange" onclick="showLedgerModal()">➕ 添加错题</button></div>
    ${ledgerHtml}
    <div class="section-title">📚 26秋沪教版四上单词表（点击🔊可跟读）</div>
    ${vocabHtml}
  `;
}
let engAudioState = {dateKey:'', unit:1, mode:'full', sentIdx:0, playing:false, dictText:'', dictSubmitted:false, stars:0, starsAwarded:false};
let engDictState = {dateKey:'', inputs:['','','','',''], submitted:false, stars:0, starsAwarded:false};

// 新版课本跟读状态（截图样式）
let engPageState = {dateKey:'', unit:1, pageIdx:0, speed:1.0, studying:false, studySeconds:0, currentSentIdx:-1, recordingSentIdx:-1, loopMode:false, fullPlaying:false, fullPageResumeIdx:-1};
let engStudyTimer = null;
let engRecordState = {mediaRec:null, stream:null, chunks:[], timer:null};
// 视图模式：'home'=单元目录列表（截图2），'reader'=跟读页面（截图1）
let engView = 'home';
let engSelectedUnit = 1;

function engPlayFull(){
  engAudioState.mode = 'full';
  engAudioState.playing = true;
  const u = ENGLISH_CONTENT[engAudioState.unit];
  if('speechSynthesis' in window){
    speechSynthesis.cancel();
    const utter = new SpeechSynthesisUtterance(u.text);
    utter.lang = 'en-US';
    utter.rate = 0.8;
    utter.onend = ()=>{ engAudioState.playing = false; renderModule(); };
    speechSynthesis.speak(utter);
  }
  renderModule();
}

function engPlaySentence(){
  engAudioState.mode = 'sentence';
  engAudioState.playing = true;
  engSpeakCurrentSent();
  renderModule();
}

function engSpeakCurrentSent(){
  const u = ENGLISH_CONTENT[engAudioState.unit];
  const sentences = u.text.split(/\n+/).filter(s=>s.trim());
  if(sentences.length === 0) return;
  const idx = engAudioState.sentIdx % sentences.length;
  if('speechSynthesis' in window){
    speechSynthesis.cancel();
    const utter = new SpeechSynthesisUtterance(sentences[idx]);
    utter.lang = 'en-US';
    utter.rate = 0.75;
    utter.onend = ()=>{
      setTimeout(()=>{
        engAudioState.sentIdx++;
        engSpeakCurrentSent();
        renderModule();
      }, 1500);
    };
    speechSynthesis.speak(utter);
  }
}

function engStopAudio(){
  engAudioState.playing = false;
  if('speechSynthesis' in window) speechSynthesis.cancel();
  renderModule();
}

// ===== 新版课本跟读（截图样式） =====
function engPageInitState(){
  const today = todayStr();
  if(!engPageState.dateKey || engPageState.dateKey !== today){
    const day = new Date(currentDate).getDate();
    const todayUnit = ((day - 1) % 8) + 1;
    engPageState = {dateKey:today, unit:todayUnit, pageIdx:0, speed:1.0, studying:false, studySeconds:0, currentSentIdx:-1, recordingSentIdx:-1, loopMode:false};
  }
}

// 进入指定单元的跟读页面
function engEnterUnit(unitNum){
  engSelectedUnit = parseInt(unitNum);
  engPageState.unit = parseInt(unitNum);
  engPageState.pageIdx = 0;
  engPageState.currentSentIdx = -1;
  engPageState.recordingSentIdx = -1;
  engView = 'reader';
  // 停止可能的录音/循环
  if(engStudyTimer){ clearInterval(engStudyTimer); engStudyTimer = null; }
  if('speechSynthesis' in window) speechSynthesis.cancel();
  renderModule();
}

// 返回单元目录首页
function engBackToUnits(){
  engView = 'home';
  // 停止计时器但保留累计时长
  if(engStudyTimer){ clearInterval(engStudyTimer); engStudyTimer = null; }
  engPageState.studying = false;
  if('speechSynthesis' in window) speechSynthesis.cancel();
  renderModule();
}

function engStopAllPlayback(){
  engPageState.fullPlaying = false;
  engPageState.loopMode = false;
  engPageState.currentSentIdx = -1;
  engPageState.fullPageResumeIdx = -1;
  if('speechSynthesis' in window) speechSynthesis.cancel();
}

function engPageGoTo(p){
  engPageState.pageIdx = p;
  engStopAllPlayback();
  renderModule();
}

function engPageNext(){
  const unitData = ENGLISH_PAGES[engPageState.unit];
  if(!unitData) return;
  if(engPageState.pageIdx < unitData.pages.length - 1){
    engPageState.pageIdx++;
    engStopAllPlayback();
    renderModule();
  }
}

function engPagePrev(){
  if(engPageState.pageIdx > 0){
    engPageState.pageIdx--;
    engStopAllPlayback();
    renderModule();
  }
}

function engSetSpeed(sp){
  engPageState.speed = sp;
  renderModule();
}

function engToggleStudy(){
  engPageState.studying = !engPageState.studying;
  if(engPageState.studying){
    if(!engStudyTimer){
      engStudyTimer = setInterval(()=>{
        if(engPageState.studying){
          engPageState.studySeconds++;
          // 30分钟提示
          if(engPageState.studySeconds === 30*60){
            toast('🎉 已学习30分钟！完成今日英语任务');
          }
          // 只更新计时器显示，不重渲染整个模块（避免输入框闪退）
          const timerEl = document.getElementById('engTimerDisplay');
          if(timerEl){
            timerEl.textContent = formatStudyTime(engPageState.studySeconds);
          }
        }
      }, 1000);
    }
  } else {
    if(engStudyTimer){
      clearInterval(engStudyTimer);
      engStudyTimer = null;
    }
  }
  renderModule();
}

function engResetTimer(){
  engPageState.studySeconds = 0;
  engPageState.studying = false;
  if(engStudyTimer){
    clearInterval(engStudyTimer);
    engStudyTimer = null;
  }
  renderModule();
}

function formatStudyTime(sec){
  const m = Math.floor(sec / 60);
  const s = sec % 60;
  return String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
}

function engPlaySentPair(enText, sentIdx){
  // 手动点击单句时，清除断点记录（脱离全文播放上下文）
  engPageState.fullPlaying = false;
  engPageState.fullPageResumeIdx = -1;
  engPageState.currentSentIdx = sentIdx;
  if('speechSynthesis' in window){
    speechSynthesis.cancel();
    const utter = new SpeechSynthesisUtterance(enText);
    utter.lang = 'en-US';
    utter.rate = engPageState.speed * 0.85;
    utter.onend = ()=>{
      engPageState.currentSentIdx = -1;
      // 循环模式：自动播放下一句
      if(engPageState.loopMode){
        const unitData = ENGLISH_PAGES[engPageState.unit];
        const page = unitData.pages[engPageState.pageIdx];
        const nextIdx = sentIdx + 1;
        if(nextIdx < page.pairs.length){
          setTimeout(()=>{ engPlaySentPair(page.pairs[nextIdx][0], nextIdx); }, 800);
        } else {
          setTimeout(()=>{ engPlaySentPair(page.pairs[0][0], 0); }, 1500);
        }
      }
      renderModule();
    };
    speechSynthesis.speak(utter);
  }
  renderModule();
}

function engToggleLoop(){
  // 先停止全文播放（包括断点记录）
  engPageState.fullPlaying = false;
  engPageState.fullPageResumeIdx = -1;
  engPageState.loopMode = !engPageState.loopMode;
  if(engPageState.loopMode){
    const unitData = ENGLISH_PAGES[engPageState.unit];
    const page = unitData.pages[engPageState.pageIdx];
    engPlaySentPair(page.pairs[0][0], 0);
  } else {
    engStopPageLoop();
  }
  renderModule();
}

function engStopPageLoop(){
  engPageState.loopMode = false;
  engPageState.currentSentIdx = -1;
  if('speechSynthesis' in window) speechSynthesis.cancel();
  renderModule();
}

function engPlayFullPage(){
  // 已经在播放中，不做处理
  if(engPageState.fullPlaying) return;
  // 先停止逐句循环
  if(engPageState.loopMode){
    engPageState.loopMode = false;
    if('speechSynthesis' in window) speechSynthesis.cancel();
  }
  const unitData = ENGLISH_PAGES[engPageState.unit];
  const page = unitData.pages[engPageState.pageIdx];
  engPageState.fullPlaying = true;
  // 如果有暂停记录，从断点继续；否则从头开始
  let idx = engPageState.fullPageResumeIdx >= 0 ? engPageState.fullPageResumeIdx : 0;
  engPageState.fullPageResumeIdx = -1; // 清除断点记录
  function speakNext(){
    if(!engPageState.fullPlaying) return;
    if(idx >= page.pairs.length){
      engPageState.fullPlaying = false;
      engPageState.currentSentIdx = -1;
      engPageState.fullPageResumeIdx = -1;
      renderModule();
      return;
    }
    engPageState.currentSentIdx = idx;
    renderModule();
    if('speechSynthesis' in window){
      speechSynthesis.cancel();
      const utter = new SpeechSynthesisUtterance(page.pairs[idx][0]);
      utter.lang = 'en-US';
      utter.rate = engPageState.speed * 0.85;
      utter.onend = ()=>{
        if(!engPageState.fullPlaying) return;
        idx++;
        setTimeout(speakNext, 600);
      };
      speechSynthesis.speak(utter);
    }
  }
  speakNext();
}

function engStopFullPage(){
  // 暂停：记住当前播放位置，不清除，以便续播
  if(engPageState.currentSentIdx >= 0){
    engPageState.fullPageResumeIdx = engPageState.currentSentIdx;
  }
  engPageState.fullPlaying = false;
  engPageState.currentSentIdx = -1; // 清除高亮（已保存到resumeIdx）
  if('speechSynthesis' in window) speechSynthesis.cancel();
  renderModule();
}

function engRecordSentPair(enText, sentIdx){
  // 如果正在录音，停止
  if(engRecordState.mediaRec && engRecordState.mediaRec.state === 'recording'){
    engRecordState.mediaRec.stop();
    engPageState.recordingSentIdx = -1;
    renderModule();
    return;
  }
  // 否则开始录音
  if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    toast('当前浏览器不支持录音功能');
    return;
  }
  navigator.mediaDevices.getUserMedia({audio:true}).then(stream => {
    engRecordState.stream = stream;
    engRecordState.chunks = [];
    engRecordState.mediaRec = new MediaRecorder(stream);
    engRecordState.mediaRec.ondataavailable = e => {
      if(e.data.size > 0) engRecordState.chunks.push(e.data);
    };
    engRecordState.mediaRec.onstop = ()=>{
      engRecordState.stream.getTracks().forEach(t=>t.stop());
      // 录音完成，给1颗星
      addStars(1);
      toast('录音完成 ⭐+1');
      engPageState.recordingSentIdx = -1;
      renderModule();
    };
    engRecordState.mediaRec.start();
    engPageState.recordingSentIdx = sentIdx;
    renderModule();
    toast('🎤 录音中... 再次点击停止');
    // 3秒自动停止
    engRecordState.timer = setTimeout(()=>{
      if(engRecordState.mediaRec && engRecordState.mediaRec.state === 'recording'){
        engRecordState.mediaRec.stop();
      }
    }, 3000);
  }).catch(err => {
    toast('麦克风权限被拒绝');
    console.error('录音失败:', err);
  });
}

function engNextSent(){
  engAudioState.sentIdx++;
  if(engAudioState.playing) engSpeakCurrentSent();
  renderModule();
}

function engPrevSent(){
  engAudioState.sentIdx = Math.max(0, engAudioState.sentIdx-1);
  if(engAudioState.playing) engSpeakCurrentSent();
  renderModule();
}

function engReplaySent(){
  if(engAudioState.playing) engSpeakCurrentSent();
}

function engSpeakWord(word){
  if('speechSynthesis' in window){
    speechSynthesis.cancel();
    const utter = new SpeechSynthesisUtterance(word);
    utter.lang = 'en-US';
    utter.rate = 0.7;
    speechSynthesis.speak(utter);
  }
}

function engCompareText(original, userInput){
  const origWords = original.split(/\s+/);
  const userWords = userInput.split(/\s+/);
  let html = '';
  const maxLen = Math.max(origWords.length, userWords.length);
  for(let i=0; i<maxLen; i++){
    const ow = (origWords[i]||'').toLowerCase().replace(/[^a-z]/g,'');
    const uw = (userWords[i]||'').toLowerCase().replace(/[^a-z]/g,'');
    if(!userWords[i]){
      html += `<span class="cmp-missed">${origWords[i]||''}</span> `;
    } else if(ow === uw){
      html += `<span class="cmp-correct">${userWords[i]}</span> `;
    } else {
      html += `<span class="cmp-wrong">${userWords[i]}</span><span class="cmp-correct-ans">(${origWords[i]||''})</span> `;
    }
  }
  return html;
}

function engCalcSimilarity(original, userInput){
  const orig = original.toLowerCase().replace(/[^a-z\s]/g,'').split(/\s+/).filter(w=>w);
  const user = userInput.toLowerCase().replace(/[^a-z\s]/g,'').split(/\s+/).filter(w=>w);
  if(orig.length === 0) return 0;
  let match = 0;
  const userSet = new Set(user);
  orig.forEach(w=>{ if(userSet.has(w)) match++; });
  return match / orig.length;
}

function engSubmitDict(){
  engAudioState.dictSubmitted = true;
  renderModule();
}

function engSubmitWordDict(){
  engDictState.submitted = true;
  // 自动将错题登记到台账
  const day = new Date(currentDate).getDate();
  const todayUnit = ((day - 1) % 8) + 1;
  const u = ENGLISH_CONTENT[todayUnit];
  const startIdx = (day % u.words.length);
  const dictWords = [];
  for(let i=0;i<5;i++){ dictWords.push(u.words[(startIdx+i)%u.words.length]); }
  let addedCount = 0;
  dictWords.forEach((w,i)=>{
    const userInput = (engDictState.inputs[i]||'').trim().toLowerCase();
    if(userInput && userInput !== w.w.toLowerCase()){
      // 检查是否已存在相同单词+错误写法的记录
      const existIdx = D.errorLedger.findIndex(x=>x.word===w.w && x.wrongSpelling===userInput);
      if(existIdx < 0){
        // 分析错误原因
        let reason = '其他';
        if(userInput.length < w.w.length) reason = '漏字母';
        else if(userInput.length > w.w.length) reason = '多字母';
        else {
          // 检查是否字母顺序颠倒
          const sorted1 = userInput.split('').sort().join('');
          const sorted2 = w.w.toLowerCase().split('').sort().join('');
          if(sorted1 === sorted2) reason = '字母顺序颠倒';
          else reason = '拼写记忆混淆';
        }
        D.errorLedger.unshift({
          id:'el_'+Date.now()+'_'+i,
          word:w.w,
          wrongSpelling:userInput,
          correctSpelling:w.w,
          reason:reason,
          note:w.m,
          reviewDate:todayStr(),
          createdDate:todayStr()
        });
        addedCount++;
      }
    }
  });
  if(addedCount > 0){
    saveData();
    toast(addedCount+'个错题已自动登记到台账 📝');
  }
  renderModule();
}

function addStars(n){
  if(!D.stars) D.stars = 0;
  D.stars += n;
  saveData();
}

function toggleEngUnit(k){
  const el = document.getElementById('eng-unit-'+k);
  if(!el) return;
  const isOpen = el.classList.contains('open');
  el.classList.toggle('open');
  const arrow = el.previousElementSibling.querySelector('.eng-unit-arrow');
  if(arrow) arrow.textContent = isOpen ? '▶' : '▼';
  if(!isOpen){
    setTimeout(()=>el.scrollIntoView({behavior:'smooth',block:'nearest'}),50);
  }
}

