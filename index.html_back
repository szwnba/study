// --- 辅助：随机数 ---
function erRand(min, max){ return Math.floor(Math.random()*(max-min+1))+min; }
function erPick(arr){ return arr[erRand(0, arr.length-1)]; }

// --- 故事数据：手工编写 ---
const ER_STORIES = [
{
  title:"The Ant and the Grasshopper", level:"4", category:"寓言",
  text:`It was a hot summer day.
An ant was working hard to gather food.
A grasshopper came by and laughed at the ant.
"Why are you working so hard?" asked the grasshopper.
"Come and play with me!"
The ant replied, "I am storing food for winter.
You should do the same."
The grasshopper said, "Winter is far away.
I will play now."
When winter came, the grasshopper was very hungry.
He had no food at all.
He went to the ant and asked for help.
The ant shared some food with him.
The grasshopper learned his lesson.
He promised to work hard next year.`,
  newWords:[{w:"gather",m:"收集"},{w:"store",m:"储存"},{w:"reply",m:"回答"},{w:"promise",m:"承诺"}],
  comprehension:[
    {q:"What was the ant doing on a hot summer day?",a:"The ant was working hard to gather food."},
    {q:"What did the grasshopper do when the ant was working?",a:"The grasshopper laughed and wanted to play."},
    {q:"What happened when winter came?",a:"The grasshopper was hungry and had no food."},
    {q:"What lesson did the grasshopper learn?",a:"He learned to work hard and prepare for the future."}
  ],
  patterns:[
    {formula:"Why are you + V-ing?",example:"Why are you working so hard?",ref:["Why are you running so fast?","Why are you crying?"]},
    {formula:"promise to + V",example:"He promised to work hard next year.",ref:["I promise to be a good student.","She promised to help me."]}
  ]
},
{
  title:"The Lion and the Mouse", level:"4", category:"寓言",
  text:`A lion was sleeping in the forest.
A little mouse ran over his nose.
The lion woke up and caught the mouse.
"Please let me go!" said the mouse.
"Maybe I can help you someday."
The lion laughed, "You are too small to help me."
But he let the mouse go.
A few days later, the lion was caught in a net.
He could not get free.
The little mouse heard him and came to help.
The mouse bit the ropes and set the lion free.
The lion said, "Thank you, little friend.
I was wrong about you."
From that day, they became good friends.`,
  newWords:[{w:"catch",m:"抓住"},{w:"net",m:"网"},{w:"rope",m:"绳子"},{w:"free",m:"自由的"}],
  comprehension:[
    {q:"What happened when the mouse ran over the lion's nose?",a:"The lion woke up and caught the mouse."},
    {q:"Why did the lion laugh at the mouse?",a:"Because the mouse was too small to help the lion."},
    {q:"How did the mouse help the lion later?",a:"The mouse bit the ropes and set the lion free."},
    {q:"What did the lion say at the end?",a:'The lion said, "Thank you, little friend. I was wrong about you."'}
  ],
  patterns:[
    {formula:"too + adj + to + V",example:"You are too small to help me.",ref:["The box is too heavy to carry.","She is too tired to walk."]},
    {formula:"let + sb + V",example:"But he let the mouse go.",ref:["Let me help you.","My mother lets me play outside."]}
  ]
},
{
  title:"The Tortoise and the Hare", level:"4", category:"寓言",
  text:`A hare was very proud of his speed.
He laughed at a tortoise for being slow.
"Let's have a race!" said the tortoise.
The hare agreed and ran very fast.
He was far ahead of the tortoise.
"I will take a nap," thought the hare.
"The tortoise is so slow."
But the tortoise kept walking, step by step.
He never stopped or rested.
When the hare woke up, he ran to the finish line.
But the tortoise was already there!
The tortoise had won the race.
The hare was very surprised.
He learned that slow and steady wins the race.`,
  newWords:[{w:"proud",m:"骄傲的"},{w:"speed",m:"速度"},{w:"nap",m:"小睡"},{w:"steady",m:"稳定的"}],
  comprehension:[
    {q:"Why was the hare proud?",a:"The hare was proud of his speed."},
    {q:"What did the hare do during the race?",a:"The hare took a nap because he was far ahead."},
    {q:"Who won the race?",a:"The tortoise won the race."},
    {q:"What lesson did the hare learn?",a:"Slow and steady wins the race."}
  ],
  patterns:[
    {formula:"be proud of + n",example:"A hare was very proud of his speed.",ref:["I am proud of my son.","She is proud of her work."]},
    {formula:"keep + V-ing",example:"The tortoise kept walking.",ref:["Keep trying!","He kept running in the rain."]}
  ]
},
{
  title:"The Boy Who Cried Wolf", level:"5", category:"寓言",
  text:`A boy was watching sheep on a hill.
He felt bored and wanted to have fun.
"Wolf! Wolf! A wolf is coming!" he cried.
The villagers ran up the hill to help.
But there was no wolf.
The boy laughed at them.
He did this again the next day.
The villagers came again, but there was no wolf.
They were very angry.
One day, a real wolf came.
The boy cried, "Wolf! Wolf! Help!"
But no one came to help him.
The villagers did not believe him anymore.
The wolf ate some of his sheep.
The boy learned that liars are not believed,
even when they tell the truth.`,
  newWords:[{w:"bored",m:"无聊的"},{w:"villager",m:"村民"},{w:"believe",m:"相信"},{w:"truth",m:"真相"}],
  comprehension:[
    {q:"Why did the boy cry 'wolf' the first time?",a:"He was bored and wanted to have fun."},
    {q:"How did the villagers feel when there was no wolf?",a:"They were very angry."},
    {q:"What happened when a real wolf came?",a:"No one came to help because they did not believe the boy anymore."},
    {q:"What lesson did the boy learn?",a:"Liars are not believed, even when they tell the truth."}
  ],
  patterns:[
    {formula:"no one + V",example:"No one came to help him.",ref:["No one knows the answer.","No one likes a liar."]},
    {formula:"even when + clause",example:"Even when they tell the truth.",ref:["I will help you even when things are hard.","She smiles even when she is sad."]}
  ]
},
{
  title:"The Fox and the Grapes", level:"4", category:"寓言",
  text:`A fox was very hungry one day.
He saw some purple grapes on a high vine.
"They look so sweet and juicy," he thought.
"I will eat them!"
He jumped up to reach the grapes.
But they were too high.
He jumped again and again.
Each time, he could not reach them.
Finally, he was too tired to jump anymore.
He sat down and said, "Those grapes are sour anyway.
I do not want them."
He walked away with his head down.
But in his heart, he knew he wanted them very much.
People often say bad things about what they cannot have.`,
  newWords:[{w:"grape",m:"葡萄"},{w:"vine",m:"藤蔓"},{w:"juicy",m:"多汁的"},{w:"sour",m:"酸的"}],
  comprehension:[
    {q:"What did the fox see on the vine?",a:"The fox saw some purple grapes."},
    {q:"Why couldn't the fox get the grapes?",a:"The grapes were too high for the fox to reach."},
    {q:"What did the fox say about the grapes?",a:'The fox said, "Those grapes are sour anyway."'},
    {q:"What does this story teach us?",a:"People often say bad things about what they cannot have."}
  ],
  patterns:[
    {formula:"too + adj + to + V",example:"They were too high to reach.",ref:["The water is too hot to drink.","The book is too hard to read."]},
    {formula:"anyway",example:"Those grapes are sour anyway.",ref:["I will go anyway.","It is raining, but let us go anyway."]}
  ]
},
{
  title:"The Crow and the Pitcher", level:"5", category:"寓言",
  text:`A crow was very thirsty on a hot day.
He found a pitcher with a little water in it.
But the pitcher had a long, narrow neck.
The crow could not reach the water.
He tried to push the pitcher over.
But it was too heavy.
Then the crow had an idea.
He saw some small stones on the ground.
He picked up a stone and dropped it into the pitcher.
The water rose a little.
He dropped another stone, and another.
Slowly, the water came up to the top.
The crow drank the water and was no longer thirsty.
He was very happy with his clever idea.
Where there is a will, there is a way.`,
  newWords:[{w:"thirsty",m:"口渴的"},{w:"pitcher",m:"水罐"},{w:"narrow",m:"窄的"},{w:"clever",m:"聪明的"}],
  comprehension:[
    {q:"What did the crow find?",a:"The crow found a pitcher with a little water in it."},
    {q:"Why couldn't the crow drink the water?",a:"The pitcher had a long, narrow neck and the crow could not reach the water."},
    {q:"How did the crow make the water rise?",a:"The crow dropped stones into the pitcher, and the water rose."},
    {q:"What lesson does this story teach?",a:"Where there is a will, there is a way."}
  ],
  patterns:[
    {formula:"too + adj + to + V",example:"It was too heavy to push over.",ref:["The box is too big to move.","She is too shy to speak."]},
    {formula:"Where there is a will, there is a way",example:"Where there is a will, there is a way.",ref:["If you try hard, you will succeed.","Nothing is impossible if you try."]}
  ]
},
{
  title:"The Goose That Laid Golden Eggs", level:"5", category:"寓言",
  text:`A farmer had a special goose.
Every morning, the goose laid one golden egg.
The farmer sold the eggs and became rich.
But he was greedy and wanted more.
"Why wait for one egg each day?" he thought.
"I will cut open the goose and take all the eggs at once!"
He killed the goose and cut it open.
But there were no eggs inside.
The goose was just like any other goose inside.
Now the farmer had no goose and no golden eggs.
He was very sad and regretted his greed.
He had lost everything because he wanted too much.
Greed often leads to ruin.`,
  newWords:[{w:"goose",m:"鹅"},{w:"golden",m:"金色的"},{w:"greedy",m:"贪婪的"},{w:"regret",m:"后悔"}],
  comprehension:[
    {q:"What was special about the goose?",a:"The goose laid one golden egg every morning."},
    {q:"Why did the farmer kill the goose?",a:"He was greedy and wanted to take all the golden eggs at once."},
    {q:"What did the farmer find inside the goose?",a:"There were no eggs inside. The goose was just like any other goose."},
    {q:"What lesson does this story teach?",a:"Greed often leads to ruin."}
  ],
  patterns:[
    {formula:"Why + V...?",example:'Why wait for one egg each day?',ref:["Why not try again?","Why go there alone?"]},
    {formula:"lead to + n",example:"Greed often leads to ruin.",ref:["Hard work leads to success.","His laziness led to failure."]}
  ]
},
{
  title:"The Wind and the Sun", level:"4", category:"寓言",
  text:`The wind and the sun were arguing.
"I am stronger than you!" said the wind.
"No, I am stronger!" said the sun.
They saw a man walking on the road.
He was wearing a thick coat.
"Let us see who can make him take off his coat," said the sun.
The wind blew hard and cold.
But the man held his coat tighter.
The wind blew even harder.
The man held his coat even tighter.
Then the sun came out and shone warmly.
The man felt warm and happy.
Soon he took off his coat.
The sun said, "You see, kindness is stronger than force."`,
  newWords:[{w:"argue",m:"争论"},{w:"blow",m:"吹"},{w:"force",m:"力量"},{w:"kindness",m:"善良"}],
  comprehension:[
    {q:"What were the wind and the sun arguing about?",a:"They were arguing about who was stronger."},
    {q:"What did the wind do to make the man take off his coat?",a:"The wind blew hard and cold, but the man held his coat tighter."},
    {q:"How did the sun make the man take off his coat?",a:"The sun shone warmly, and the man felt warm and took off his coat."},
    {q:"What did the sun say at the end?",a:'The sun said, "Kindness is stronger than force."'}
  ],
  patterns:[
    {formula:"comparative: adj-er than",example:"I am stronger than you.",ref:["Tom is taller than Jack.","A bike is cheaper than a car."]},
    {formula:"make + sb + V",example:"Make him take off his coat.",ref:["Music makes me happy.","The teacher made us study hard."]}
  ]
},
{
  title:"The Town Mouse and the Country Mouse", level:"5", category:"寓言",
  text:`A country mouse invited his cousin from the town.
The town mouse came to visit the country.
The country mouse served simple food.
"Is this all you eat?" laughed the town mouse.
"Come to the town with me.
You will eat wonderful food!"
They went to the town together.
The town mouse showed the country mouse a big house.
There was delicious food on the table.
They began to eat happily.
Suddenly, a cat came running in!
They ran to hide in a hole.
Then a dog ran into the room.
They had to hide again.
"This is too dangerous!" said the country mouse.
"I would rather eat simple food in peace,
than eat delicious food in fear."
He went back to his simple country home.`,
  newWords:[{w:"cousin",m:"表亲"},{w:"dangerous",m:"危险的"},{w:"peace",m:"安宁"},{w:"fear",m:"恐惧"}],
  comprehension:[
    {q:"What did the country mouse serve for the town mouse?",a:"The country mouse served simple food."},
    {q:"What happened when they began to eat the delicious food?",a:"A cat came running in and they had to hide."},
    {q:"Why did the country mouse go back home?",a:"He preferred simple food in peace over delicious food in fear."},
    {q:"What lesson does this story teach?",a:"It is better to live simply and safely than to live in luxury and fear."}
  ],
  patterns:[
    {formula:"would rather + V than + V",example:"I would rather eat simple food in peace, than eat delicious food in fear.",ref:["I would rather read than watch TV.","He would rather walk than run."]},
    {formula:"too + adj",example:"This is too dangerous!",ref:["This is too expensive.","The test is too difficult."]}
  ]
},
{
  title:"The Ugly Duckling", level:"5", category:"童话",
  text:`A mother duck sat on her eggs.
One egg was bigger than the others.
When it hatched, the baby was grey and ugly.
The other ducklings laughed at him.
"You are so ugly!" they said.
The ugly duckling felt very sad.
He ran away from the pond.
He lived alone for a long time.
Winter came and it was very cold.
Spring came and the duckling grew bigger.
One day, he saw some swans on a lake.
"How beautiful they are!" he thought.
He looked at himself in the water.
He was a beautiful white swan!
The other swans welcomed him.
The children threw bread to him.
He was the happiest bird in the world.
He was not an ugly duckling at all.
He was a beautiful swan.`,
  newWords:[{w:"hatch",m:"孵化"},{w:"ugly",m:"丑的"},{w:"swan",m:"天鹅"},{w:"welcome",m:"欢迎"}],
  comprehension:[
    {q:"Why did the other ducklings laugh at the ugly duckling?",a:"Because the ugly duckling was grey and ugly, different from the others."},
    {q:"What happened when spring came?",a:"The duckling grew bigger and discovered he was a beautiful swan."},
    {q:"What did the ugly duckling turn out to be?",a:"He turned out to be a beautiful white swan."},
    {q:"How did the ugly duckling feel at the end?",a:"He was the happiest bird in the world."}
  ],
  patterns:[
    {formula:"comparative: adj-er than",example:"One egg was bigger than the others.",ref:["My dog is bigger than yours.","This book is more interesting than that one."]},
    {formula:"not ... at all",example:"He was not an ugly duckling at all.",ref:["I am not tired at all.","She is not angry at all."]}
  ]
},
{
  title:"The Little Red Hen", level:"4", category:"童话",
  text:`A little red hen found some seeds.
"Who will help me plant these seeds?" she asked.
"Not I," said the dog.
"Not I," said the cat.
"Not I," said the pig.
"Then I will do it myself," said the hen.
She planted the seeds and they grew into wheat.
"Who will help me cut the wheat?" she asked.
"Not I," said the dog, cat, and pig.
She cut the wheat herself.
"Who will help me make flour?" she asked.
"Not I," they all said.
She made the flour and baked bread.
"Who will help me eat the bread?" she asked.
"I will!" said the dog, cat, and pig.
"No! I will eat it myself," said the hen.
"You did not help, so you do not get any bread."
The lesson is: you must work to get rewards.`,
  newWords:[{w:"seed",m:"种子"},{w:"wheat",m:"小麦"},{w:"flour",m:"面粉"},{w:"reward",m:"奖励"}],
  comprehension:[
    {q:"What did the little red hen find?",a:"The little red hen found some seeds."},
    {q:"Did the other animals help the hen?",a:"No, the dog, cat, and pig all said 'Not I' and did not help."},
    {q:"Who ate the bread at the end?",a:"The little red hen ate the bread herself because the others did not help."},
    {q:"What is the lesson of this story?",a:"You must work to get rewards."}
  ],
  patterns:[
    {formula:"Who will help me + V?",example:"Who will help me plant these seeds?",ref:["Who will help me clean the room?","Who will help me carry these bags?"]},
    {formula:"Not I",example:'"Not I," said the dog.',ref:['"Not I," said the cat.','"Not I," said the pig.']}
  ]
},
{
  title:"The Three Little Pigs", level:"4", category:"童话",
  text:`Three little pigs left home to build their own houses.
The first pig built a house of straw.
It was quick and easy.
The second pig built a house of wood.
It took a little longer.
The third pig built a house of bricks.
It took a long time and was hard work.
One day, a wolf came to the straw house.
He huffed and puffed and blew it down.
The first pig ran to the second pig's house.
The wolf came and blew down the wood house too.
They ran to the brick house.
The wolf huffed and puffed.
But he could not blow it down.
He tried to come down the chimney.
But the pigs had a pot of hot water.
The wolf fell in and ran away crying.
The three pigs lived safely ever after.`,
  newWords:[{w:"straw",m:"稻草"},{w:"brick",m:"砖块"},{w:"chimney",m:"烟囱"},{w:"huff",m:"吹气"}],
  comprehension:[
    {q:"What did the first pig build his house with?",a:"The first pig built his house of straw."},
    {q:"Why did the third pig's house survive?",a:"Because bricks are strong and the wolf could not blow it down."},
    {q:"How did the pigs stop the wolf from coming down the chimney?",a:"The pigs had a pot of hot water waiting for the wolf."},
    {q:"What lesson does this story teach?",a:"Hard work pays off."}
  ],
  patterns:[
    {formula:"too + adj + to + V",example:"He could not blow it down.",ref:["The bridge is too high to cross.","The wall is too strong to break."]},
    {formula:"ever after",example:"The three pigs lived safely ever after.",ref:["They lived happily ever after.","She remained kind ever after."]}
  ]
},
{
  title:"The Dog and His Reflection", level:"4", category:"寓言",
  text:`A dog was walking home with a piece of meat in his mouth.
He had to cross a bridge over a river.
He looked down and saw his reflection in the water.
He thought it was another dog with a bigger piece of meat.
"If I bark at him, he may drop his meat," he thought.
"Then I will have two pieces of meat!"
He opened his mouth to bark.
His piece of meat fell into the water.
It sank to the bottom of the river.
The dog stood on the bridge with nothing.
He was very hungry and very sad.
He had lost what he had because of his greed.
We should be happy with what we have.`,
  newWords:[{w:"reflection",m:"倒影"},{w:"bark",m:"吠叫"},{w:"sink",m:"沉"},{w:"greed",m:"贪婪"}],
  comprehension:[
    {q:"What was the dog carrying in his mouth?",a:"The dog was carrying a piece of meat in his mouth."},
    {q:"What did the dog see in the water?",a:"The dog saw his own reflection, but thought it was another dog with a bigger piece of meat."},
    {q:"What happened when the dog opened his mouth to bark?",a:"His piece of meat fell into the water and sank."},
    {q:"What lesson does this story teach?",a:"We should be happy with what we have and not be greedy."}
  ],
  patterns:[
    {formula:"If I + V, ... will + V",example:"If I bark at him, he may drop his meat.",ref:["If I study hard, I will pass the test.","If it rains, we will stay home."]},
    {formula:"be happy with + n",example:"We should be happy with what we have.",ref:["I am happy with my new bike.","She is happy with her job."]}
  ]
},
{
  title:"The Frog and the Ox", level:"5", category:"寓言",
  text:`A frog was sitting by a small pond.
An ox came to the pond to drink water.
The frog saw how big the ox was.
"I want to be as big as that ox!" said the frog.
He puffed himself up and asked his friends.
"Am I as big as the ox now?"
"No," said his friends.
He puffed himself up more.
"Am I as big now?"
"No, not yet," they said.
He puffed and puffed until he was very round.
Suddenly, POP!
The frog burst because he was too puffed up.
He had tried to be something he was not.
It is better to be yourself than to pretend
to be something you are not.`,
  newWords:[{w:"ox",m:"公牛"},{w:"puff",m:"鼓起"},{w:"burst",m:"爆裂"},{w:"pretend",m:"假装"}],
  comprehension:[
    {q:"What did the frog see at the pond?",a:"The frog saw an ox that was very big."},
    {q:"What did the frog want to do?",a:"The frog wanted to be as big as the ox."},
    {q:"What happened when the frog puffed up too much?",a:"The frog burst because he was too puffed up."},
    {q:"What lesson does this story teach?",a:"It is better to be yourself than to pretend to be something you are not."}
  ],
  patterns:[
    {formula:"as + adj + as",example:"I want to be as big as that ox!",ref:["She is as tall as her mother.","This is as good as new."]},
    {formula:"It is better to + V than to + V",example:"It is better to be yourself than to pretend.",ref:["It is better to try than to give up.","It is better to study than to play."]}
  ]
},
{
  title:"Belling the Cat", level:"5", category:"寓言",
  text:`The mice were tired of running from the cat.
They had a meeting to solve the problem.
"We must do something about the cat!" said one mouse.
A young mouse stood up and said, "I have an idea!
We can put a bell on the cat's neck.
Then we will hear her coming and run away!"
All the mice clapped and cheered.
"What a wonderful idea!" they said.
Then an old mouse stood up slowly.
"That is a very good idea," he said.
"But who will put the bell on the cat?"
The room went quiet.
No one was brave enough to do it.
It is easy to suggest impossible things.
But it is hard to do them.`,
  newWords:[{w:"bell",m:"给...系铃"},{w:"solve",m:"解决"},{w:"brave",m:"勇敢的"},{w:"impossible",m:"不可能的"}],
  comprehension:[
    {q:"Why did the mice have a meeting?",a:"The mice were tired of running from the cat and wanted to solve the problem."},
    {q:"What was the young mouse's idea?",a:"To put a bell on the cat's neck so they could hear her coming."},
    {q:"What did the old mouse ask?",a:'The old mouse asked, "Who will put the bell on the cat?"'},
    {q:"What lesson does this story teach?",a:"It is easy to suggest impossible things, but it is hard to do them."}
  ],
  patterns:[
    {formula:"be tired of + V-ing/n",example:"The mice were tired of running from the cat.",ref:["I am tired of waiting.","She is tired of her job."]},
    {formula:"Who will + V?",example:"Who will put the bell on the cat?",ref:["Who will help me?","Who will clean the room?"]}
  ]
},
{
  title:"My Best Friend", level:"4", category:"日常",
  text:`My best friend is Lily.
We have been friends since first grade.
She has long black hair and big eyes.
She is kind and always helps others.
We play together after school every day.
We like to ride bikes in the park.
We also enjoy reading books together.
Lily is very good at math.
She often helps me with my homework.
I am good at English, so I help her with English.
We share our lunch every day.
Sometimes she brings apples for me.
Sometimes I bring cookies for her.
We never fight or argue.
When I am sad, she makes me laugh.
When she is sad, I make her laugh too.
I hope we will be friends forever.
A true friend is the best gift in life.`,
  newWords:[{w:"since",m:"自从"},{w:"kind",m:"善良的"},{w:"share",m:"分享"},{w:"true",m:"真正的"}],
  comprehension:[
    {q:"Who is the writer's best friend?",a:"Lily is the writer's best friend."},
    {q:"What do they like to do after school?",a:"They like to ride bikes in the park and read books together."},
    {q:"How do they help each other?",a:"Lily helps with math and the writer helps with English."},
    {q:"What does the writer think about friendship?",a:"A true friend is the best gift in life."}
  ],
  patterns:[
    {formula:"have been + V-ing",example:"We have been friends since first grade.",ref:["I have been studying English for three years.","She has been playing piano since she was five."]},
    {formula:"be good at + n/V-ing",example:"Lily is very good at math.",ref:["He is good at swimming.","They are good at sports."]}
  ]
},
{
  title:"A Visit to the Zoo", level:"4", category:"日常",
  text:`Last Sunday, my family went to the zoo.
It was a sunny and warm day.
We arrived at the zoo at nine in the morning.
First, we saw the monkeys.
They were jumping from tree to tree.
They were so funny and active!
Then we went to see the elephants.
They were very big and strong.
An elephant used its trunk to drink water.
Next, we saw the pandas eating bamboo.
They looked so cute and round.
After lunch, we watched the dolphin show.
The dolphins jumped high out of the water.
Everyone clapped and cheered.
Before going home, we visited the gift shop.
I bought a small toy panda.
It was the best day ever.
I want to go to the zoo again soon.`,
  newWords:[{w:"arrive",m:"到达"},{w:"trunk",m:"象鼻"},{w:"bamboo",m:"竹子"},{w:"dolphin",m:"海豚"}],
  comprehension:[
    {q:"When did the family go to the zoo?",a:"The family went to the zoo last Sunday."},
    {q:"What did the monkeys do?",a:"The monkeys were jumping from tree to tree."},
    {q:"How did the elephant drink water?",a:"The elephant used its trunk to drink water."},
    {q:"What did the writer buy at the gift shop?",a:"The writer bought a small toy panda."}
  ],
  patterns:[
    {formula:"First, ... Then, ... Next, ... After, ...",example:"First, we saw the monkeys. Then, we went to see the elephants.",ref:["First, wash your hands. Then, eat your food.","First, read the question. Next, write the answer."]},
    {formula:"want to + V",example:"I want to go to the zoo again soon.",ref:["I want to be a doctor.","She wants to learn Chinese."]}
  ]
},
{
  title:"My Favorite Season", level:"4", category:"日常",
  text:`My favorite season is autumn.
In autumn, the leaves change color.
Some turn red, some turn yellow, and some turn orange.
The weather is cool and comfortable.
I do not feel too hot or too cold.
In autumn, I can pick apples with my family.
The apples are sweet and crunchy.
I also like to collect fallen leaves.
I press them in my books to keep them beautiful.
My grandmother makes pumpkin pie in autumn.
It is my favorite food in the world!
The Mid-Autumn Festival is in autumn too.
We eat mooncakes and watch the full moon.
The moon is so big and bright.
I think autumn is the most beautiful season.
Every day in autumn feels like a gift.
I wish autumn could last all year long.`,
  newWords:[{w:"autumn",m:"秋天"},{w:"crunchy",m:"脆的"},{w:"press",m:"压平"},{w:"festival",m:"节日"}],
  comprehension:[
    {q:"What is the writer's favorite season?",a:"The writer's favorite season is autumn."},
    {q:"What happens to the leaves in autumn?",a:"The leaves change color. Some turn red, some turn yellow, and some turn orange."},
    {q:"What does the writer do with fallen leaves?",a:"The writer collects fallen leaves and presses them in books."},
    {q:"What festival is in autumn?",a:"The Mid-Autumn Festival is in autumn."}
  ],
  patterns:[
    {formula:"My favorite + n is + n",example:"My favorite season is autumn.",ref:["My favorite food is pizza.","My favorite color is blue."]},
    {formula:"wish + clause",example:"I wish autumn could last all year long.",ref:["I wish I could fly.","She wishes she had more time."]}
  ]
},
{
  title:"The Magic Library", level:"6", category:"奇幻",
  text:`One evening, Tom found a hidden door in his school.
It was behind a big bookshelf in the library.
He pushed the door and walked inside.
It was a magic room full of glowing books!
Each book could talk and tell stories.
A red book said, "Open me and you can fly!"
Tom opened the red book and suddenly floated up.
He flew over mountains and rivers in the pages.
A blue book said, "Open me and you can breathe underwater!"
Tom opened the blue book and dived into the sea.
He swam with colorful fish and saw coral reefs.
A green book said, "Open me and you can talk to animals!"
Tom opened the green book and chatted with a wise owl.
The owl said, "Reading is the greatest magic of all."
Tom nodded and closed the books.
He walked back through the door.
From that day, Tom loved reading more than anything.
He knew that books could take him anywhere.`,
  newWords:[{w:"hidden",m:"隐藏的"},{w:"glowing",m:"发光的"},{w:"float",m:"漂浮"},{w:"coral reef",m:"珊瑚礁"}],
  comprehension:[
    {q:"What did Tom find behind the bookshelf?",a:"Tom found a hidden door behind a big bookshelf in the library."},
    {q:"What happened when Tom opened the red book?",a:"Tom floated up and could fly over mountains and rivers."},
    {q:"What did the wise owl say?",a:'The owl said, "Reading is the greatest magic of all."'},
    {q:"What did Tom learn from his experience?",a:"Tom learned that books could take him anywhere, so he loved reading more than anything."}
  ],
  patterns:[
    {formula:"can + V",example:"Each book could talk and tell stories.",ref:["Birds can fly.","Fish can swim."]},
    {formula:"From that day, ...",example:"From that day, Tom loved reading more than anything.",ref:["From that day, she was not afraid.","From that day, he studied hard."]}
  ]
},
{
  title:"The Helpful Robot", level:"6", category:"科幻",
  text:`In the year 2050, every home had a robot.
Ming's family had a robot named Bob.
Bob could cook, clean, and help with homework.
But Bob had one problem: he could not smile.
Ming wanted to make Bob happy.
She told Bob jokes and funny stories.
Bob said, "I understand the jokes, but I cannot laugh."
One day, Ming was sick and could not go to school.
Bob took care of her all day.
He made soup and read her stories.
He checked her temperature every hour.
Ming said, "Bob, you are the best friend ever!
Even without a smile, you show love through your actions."
Bob's screen showed a curved line.
It looked like a smile!
Bob said, "Maybe I cannot smile with my face,
but I can smile with my heart."
From that day, Bob's screen always showed a smile.
Ming knew that love has many forms.`,
  newWords:[{w:"robot",m:"机器人"},{w:"temperature",m:"温度"},{w:"action",m:"行动"},{w:"form",m:"形式"}],
  comprehension:[
    {q:"What could the robot Bob do?",a:"Bob could cook, clean, and help with homework."},
    {q:"What was Bob's problem?",a:"Bob could not smile."},
    {q:"How did Bob take care of Ming when she was sick?",a:"Bob made soup, read stories, and checked her temperature every hour."},
    {q:"What did Bob say about smiling?",a:'Bob said, "Maybe I cannot smile with my face, but I can smile with my heart."'}
  ],
  patterns:[
    {formula:"even without + n",example:"Even without a smile, you show love through your actions.",ref:["Even without money, he is happy.","Even without help, she finished the work."]},
    {formula:"through + n",example:"You show love through your actions.",ref:["We learn through practice.","She helps through kindness."]}
  ]
},
{
  title:"A Letter to the Earth", level:"6", category:"环保",
  text:`Dear Earth,
I am writing to say thank you and sorry.
Thank you for the air we breathe.
Thank you for the water we drink.
Thank you for the food that grows in your soil.
Thank you for the beautiful mountains and oceans.
I am sorry that we cut down too many trees.
I am sorry that we pollute the rivers and seas.
I am sorry that we waste too much water and energy.
I am sorry that many animals are losing their homes.
From now on, I promise to do better.
I will recycle paper, plastic, and glass.
I will turn off the lights when I leave a room.
I will use less water when I brush my teeth.
I will plant trees and take care of them.
I will tell my friends to protect you too.
You are our only home in the universe.
Let us work together to keep you beautiful and healthy.
With love,
A student who cares`,
  newWords:[{w:"pollute",m:"污染"},{w:"waste",m:"浪费"},{w:"recycle",m:"回收"},{w:"universe",m:"宇宙"}],
  comprehension:[
    {q:"What is the writer thanking the Earth for?",a:"The writer thanks the Earth for air, water, food, mountains, and oceans."},
    {q:"What is the writer sorry about?",a:"The writer is sorry for cutting down trees, polluting rivers, wasting water and energy, and causing animals to lose their homes."},
    {q:"What does the writer promise to do?",a:"The writer promises to recycle, turn off lights, use less water, plant trees, and tell friends to protect the Earth."},
    {q:"What does the writer call the Earth?",a:"The writer calls the Earth 'our only home in the universe.'"}
  ],
  patterns:[
    {formula:"Thank you for + n/V-ing",example:"Thank you for the air we breathe.",ref:["Thank you for helping me.","Thank you for your gift."]},
    {formula:"From now on, I promise to + V",example:"From now on, I promise to do better.",ref:["From now on, I promise to study hard.","From now on, I promise to be kind."]}
  ]
}
];

// --- 故事生成器 ---
function generateERStories(){
  const names = ['Tom','Mary','John','Lily','Jack','Amy','Bob','Lucy','David','Anna','Peter','Sue','Mike','Kate','Paul','Lisa','Sam','Betty','Carl','Diana','Kevin','Jenny','Eric','Helen','Frank','Grace','Henry','Ivy','Oscar','Ruby'];
  const places = ['park','zoo','library','museum','farm','beach','garden','school','supermarket','cinema','bakery','fire station','science center','amusement park','post office','train station','bookstore','flower shop','toy store','pet shop'];
  const animals = ['cat','dog','rabbit','bird','fish','turtle','duck','chicken','horse','sheep','cow','pig','monkey','panda','elephant','tiger','lion','bear','koala','fox','deer','squirrel','frog','goose','owl'];
  const emotions = ['happy','excited','surprised','curious','amazed','proud','thankful','glad','cheerful','delighted','confident','grateful','joyful','content','eager'];
  const days = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
  const weathers = ['sunny','cloudy','windy','rainy','warm','cool','bright','clear','mild','pleasant'];
  const colors = ['red','blue','green','yellow','orange','purple','pink','brown','white','black','grey','gold','silver','light blue','dark green'];
  const foods = ['apple','bread','cake','milk','juice','rice','noodles','sandwich','cookie','banana','orange','chocolate','cheese','honey','butter','popcorn'];
  const actions = ['playing','reading','running','singing','dancing','jumping','climbing','swimming','drawing','laughing','walking','flying','jumping','cooking','writing'];
  const times = ['morning','afternoon','evening','night','noon','midday','sunrise','sunset'];
  const seasons = ['spring','summer','autumn','winter'];
  const objects = ['ball','kite','book','toy','puzzle','robot','drum','guitar','painting','camera'];
  const subjects = ['math','English','science','art','music','history','geography','P.E.'];
  const clothes = ['shirt','jacket','dress','hat','scarf','gloves','shoes','boots','raincoat','sweater'];

  const EMOTION_MEANINGS = {happy:'开心的',excited:'兴奋的',surprised:'惊讶的',curious:'好奇的',amazed:'惊叹的',proud:'自豪的',thankful:'感恩的',glad:'高兴的',cheerful:'愉快的',delighted:'欣喜的',confident:'自信的',grateful:'感激的',joyful:'快乐的',content:'满足的',eager:'渴望的'};
  const PLACE_MEANINGS = {park:'公园',zoo:'动物园',library:'图书馆',museum:'博物馆',farm:'农场',beach:'海滩',garden:'花园',school:'学校',supermarket:'超市',cinema:'电影院',bakery:'面包店','fire station':'消防站','science center':'科学中心','amusement park':'游乐园','post office':'邮局','train station':'火车站',bookstore:'书店','flower shop':'花店','toy store':'玩具店','pet shop':'宠物店'};
  const ANIMAL_MEANINGS = {cat:'猫',dog:'狗',rabbit:'兔子',bird:'鸟',fish:'鱼',turtle:'乌龟',duck:'鸭子',chicken:'鸡',horse:'马',sheep:'羊',cow:'牛',pig:'猪',monkey:'猴子',panda:'熊猫',elephant:'大象',tiger:'老虎',lion:'狮子',bear:'熊',koala:'考拉',fox:'狐狸',deer:'鹿',squirrel:'松鼠',frog:'青蛙',goose:'鹅',owl:'猫头鹰'};
  const FOOD_MEANINGS = {apple:'苹果',bread:'面包',cake:'蛋糕',milk:'牛奶',juice:'果汁',rice:'米饭',noodles:'面条',sandwich:'三明治',cookie:'饼干',banana:'香蕉',orange:'橙子',chocolate:'巧克力',cheese:'奶酪',honey:'蜂蜜',butter:'黄油',popcorn:'爆米花'};
  const OBJECT_MEANINGS = {ball:'球',kite:'风筝',book:'书',toy:'玩具',puzzle:'拼图',robot:'机器人',drum:'鼓',guitar:'吉他',painting:'画',camera:'相机'};
  const SUBJECT_MEANINGS = {math:'数学',English:'英语',science:'科学',art:'美术',music:'音乐',history:'历史',geography:'地理','P.E.':'体育'};
  const CLOTHES_MEANINGS = {shirt:'衬衫',jacket:'夹克',dress:'连衣裙',hat:'帽子',scarf:'围巾',gloves:'手套',shoes:'鞋子',boots:'靴子',raincoat:'雨衣',sweater:'毛衣'};
  const SEASON_MEANINGS = {spring:'春天',summer:'夏天',autumn:'秋天',winter:'冬天'};

  function getMeaning(dict, key){ return dict[key] || ''; }

  const templates = [
    // Template 1: A Day at [Place]
    () => {
      const n = erPick(names), p = erPick(places), d = erPick(days), w = erPick(weathers);
      const a = erPick(animals), e = erPick(emotions), f = erPick(foods), h = erRand(2,6);
      const text = `It was a ${w} ${d}.\n${n} went to the ${p} with friends.\nAt the ${p}, ${n} saw a small ${a}.\n${n} was ${e} to see the ${a}.\nThey played together for ${h} hours.\nAt lunch time, ${n} ate some ${f}.\nIt was a wonderful day at the ${p}.\n${n} wanted to come back again next week.`;
      return {
        title:`A Day at the ${p.charAt(0).toUpperCase()+p.slice(1)}`, level:String(erRand(4,5)), category:"日常",
        text, newWords:[{w:e,m:getMeaning(EMOTION_MEANINGS,e)},{w:p,m:getMeaning(PLACE_MEANINGS,p)}],
        comprehension:[
          {q:`Where did ${n} go?`,a:`${n} went to the ${p}.`},
          {q:`What did ${n} see at the ${p}?`,a:`${n} saw a small ${a}.`},
          {q:`How did ${n} feel?`,a:`${n} was ${e}.`},
          {q:`How long did they play?`,a:`They played for ${h} hours.`}
        ],
        patterns:[
          {formula:"go to the + place",example:`${n} went to the ${p}.`,ref:["I went to the park.","She went to the zoo."]},
          {formula:"want to + V",example:`${n} wanted to come back again.`,ref:["I want to go home.","He wants to play football."]}
        ]
      };
    },
    // Template 2: My Pet [Animal]
    () => {
      const n = erPick(names), a = erPick(animals), c = erPick(colors), e = erPick(emotions);
      const text = `I have a pet ${a}. My ${a}'s name is ${n}.\nMy ${a} has ${c} fur and bright eyes.\nEvery morning, my ${a} wakes up early.\nMy ${a} likes to play with a ball.\nI feed my ${a} every day.\nMy ${a} is very ${e} when I come home from school.\nI love my pet ${a} very much.\nMy ${a} is my best friend.\nTaking care of a pet is hard work.\nBut it is also very rewarding.`;
      return {
        title:`My Pet ${a.charAt(0).toUpperCase()+a.slice(1)}`, level:String(erRand(4,5)), category:"日常",
        text, newWords:[{w:a,m:getMeaning(ANIMAL_MEANINGS,a)},{w:e,m:getMeaning(EMOTION_MEANINGS,e)},{w:c,m:''}],
        comprehension:[
          {q:`What kind of pet does the writer have?`,a:`The writer has a pet ${a}.`},
          {q:`What does the pet like to play with?`,a:`The pet likes to play with a ball.`},
          {q:`How does the pet feel when the writer comes home?`,a:`The pet is ${e}.`},
          {q:`What does the writer think about taking care of a pet?`,a:"Taking care of a pet is hard work but also very rewarding."}
        ],
        patterns:[
          {formula:"Every + time, ...",example:"Every morning, my pet wakes up early.",ref:["Every evening, I read a book.","Every Sunday, we go to the park."]},
          {formula:"Taking care of + n is + adj",example:"Taking care of a pet is hard work.",ref:["Learning English is fun.","Helping others is important."]}
        ]
      };
    },
    // Template 3: A [Season] Day
    () => {
      const s = erPick(seasons), n = erPick(names), w = erPick(weathers);
      const o = erPick(objects), p = erPick(places), e = erPick(emotions);
      const text = `It was a ${w} day in ${s}.\n${n} went outside to play.\nThe ${s} air felt fresh and clean.\n${n} brought a ${o} to the ${p}.\nAt the ${p}, ${n} met some friends.\nThey played games and ran around.\nEveryone was ${e} and laughed a lot.\nWhen the sun went down, they went home.\n${n} thought, "I love ${s}!"\nIt was a perfect day.`;
      return {
        title:`A ${s.charAt(0).toUpperCase()+s.slice(1)} Day`, level:String(erRand(4,5)), category:"日常",
        text, newWords:[{w:s,m:getMeaning(SEASON_MEANINGS,s)},{w:e,m:getMeaning(EMOTION_MEANINGS,e)},{w:o,m:getMeaning(OBJECT_MEANINGS,o)}],
        comprehension:[
          {q:`What season was it?`,a:`It was ${s}.`},
          {q:`What did ${n} bring to the ${p}?`,a:`${n} brought a ${o}.`},
          {q:`How did everyone feel?`,a:`Everyone was ${e} and laughed a lot.`},
          {q:`What did ${n} think about ${s}?`,a:`${n} thought, "I love ${s}!"`}
        ],
        patterns:[
          {formula:"bring + n to + place",example:`${n} brought a ${o} to the ${p}.`,ref:["She brought a book to school.","He brought a gift to the party."]},
          {formula:"When + clause, ...",example:"When the sun went down, they went home.",ref:["When I grow up, I want to be a doctor.","When it rains, I stay inside."]}
        ]
      };
    },
    // Template 4: My Favorite [Subject]
    () => {
      const sub = erPick(subjects), n = erPick(names);
      const text = `My favorite subject is ${sub}.\nI love learning ${sub} at school.\nOur ${sub} teacher is very kind.\nShe makes learning fun and interesting.\nIn ${sub} class, we do many activities.\nSometimes we work in groups.\nSometimes we do experiments.\nI am good at ${sub} because I practice every day.\nMy friend ${n} is also good at ${sub}.\nWe help each other with homework.\nWhen I grow up, I want to use ${sub} in my job.\nLearning ${sub} opens many doors for the future.`;
      return {
        title:`My Favorite ${sub.charAt(0).toUpperCase()+sub.slice(1)}`, level:String(erRand(5,6)), category:"日常",
        text, newWords:[{w:sub,m:getMeaning(SUBJECT_MEANINGS,sub)},{w:'experiment',m:'实验'},{w:'practice',m:'练习'}],
        comprehension:[
          {q:`What is the writer's favorite subject?`,a:`The writer's favorite subject is ${sub}.`},
          {q:`What do they do in ${sub} class?`,a:`They do many activities, work in groups, and do experiments.`},
          {q:`Who helps the writer with homework?`,a:`The writer's friend ${n} helps with homework.`},
          {q:`Why does the writer like ${sub}?`,a:"Because the teacher makes it fun and interesting, and it opens many doors for the future."}
        ],
        patterns:[
          {formula:"be good at + n/V-ing",example:`I am good at ${sub} because I practice every day.`,ref:["She is good at singing.","They are good at sports."]},
          {formula:"When I grow up, I want to + V",example:"When I grow up, I want to use math in my job.",ref:["When I grow up, I want to be a doctor.","When I grow up, I want to travel the world."]}
        ]
      };
    },
    // Template 5: The [Animal] and the [Animal]
    () => {
      const a1 = erPick(animals), a2 = erPick(animals.filter(x=>x!==a1));
      const p = erPick(places), e = erPick(emotions);
      const text = `A ${a1} and a ${a2} were good friends.\nOne day, the ${a1} said, "Let us go to the ${p}."\nThe ${a2} agreed and they walked together.\nOn the way, they saw a beautiful ${e} sunset.\n"This is wonderful!" said the ${a1}.\n"Yes, the world is beautiful," said the ${a2}.\nThey arrived at the ${p} and played all day.\nThe ${a1} shared food with the ${a2}.\nThe ${a2} found water for the ${a1}.\nThey helped each other and were happy.\nGood friends always share and help each other.`;
      return {
        title:`The ${a1.charAt(0).toUpperCase()+a1.slice(1)} and the ${a2.charAt(0).toUpperCase()+a2.slice(1)}`, level:String(erRand(4,5)), category:"寓言",
        text, newWords:[{w:a1,m:getMeaning(ANIMAL_MEANINGS,a1)},{w:a2,m:getMeaning(ANIMAL_MEANINGS,a2)},{w:e,m:getMeaning(EMOTION_MEANINGS,e)}],
        comprehension:[
          {q:`Who were good friends?`,a:`A ${a1} and a ${a2} were good friends.`},
          {q:`Where did they go?`,a:`They went to the ${p}.`},
          {q:`How did they help each other?`,a:`The ${a1} shared food and the ${a2} found water.`},
          {q:`What is the lesson of the story?`,a:"Good friends always share and help each other."}
        ],
        patterns:[
          {formula:"Let us + V",example:'"Let us go to the park."',ref:["Let us play together.","Let us read a book."]},
          {formula:"share + n with + sb",example:`The ${a1} shared food with the ${a2}.`,ref:["I shared my cookies with my friend.","She shared her umbrella with me."]}
        ]
      };
    },
    // Template 6: I Like to [Action]
    () => {
      const act = erPick(actions), n = erPick(names), p = erPick(places);
      const text = `I like to go ${act} on weekends.\nIt is my favorite hobby.\nEvery Saturday, I go ${act} at the ${p}.\nMy friend ${n} comes with me sometimes.\nWe have so much fun together.\n${act.charAt(0).toUpperCase()+act.slice(1)} makes me strong and happy.\nWhen I am ${act}, I forget all my worries.\nThe wind feels cool on my face.\nI can hear birds singing in the trees.\nNature is beautiful when you are outside.\nI think everyone should have a hobby.\nIt makes life more interesting and fun.`;
      return {
        title:`I Like to ${act.charAt(0).toUpperCase()+act.slice(1)}`, level:String(erRand(4,6)), category:"日常",
        text, newWords:[{w:'hobby',m:'爱好'},{w:'worry',m:'烦恼'},{w:'nature',m:'自然'}],
        comprehension:[
          {q:`What does the writer like to do on weekends?`,a:`The writer likes to go ${act} on weekends.`},
          {q:`Where does the writer go ${act}?`,a:`The writer goes ${act} at the ${p}.`},
          {q:`Who comes with the writer sometimes?`,a:`The writer's friend ${n} comes sometimes.`},
          {q:`Why does the writer think everyone should have a hobby?`,a:"Because it makes life more interesting and fun."}
        ],
        patterns:[
          {formula:"like to + V",example:"I like to go swimming on weekends.",ref:["She likes to read books.","They like to play soccer."]},
          {formula:"make + sb + adj",example:`${act.charAt(0).toUpperCase()+act.slice(1)} makes me strong and happy.`,ref:["Music makes me relaxed.","Exercise makes you healthy."]}
        ]
      };
    },
    // Template 7: A Trip to [Place]
    () => {
      const n = erPick(names), p = erPick(places), d = erPick(days);
      const f = erPick(foods), e = erPick(emotions), h = erRand(2,8);
      const text = `Last ${d}, ${n}'s family went on a trip.\nThey went to a ${p} far away.\nThey drove for ${h} hours to get there.\nWhen they arrived, ${n} was very ${e}.\nThe ${p} was bigger than ${n} imagined.\nThere were many interesting things to see.\n${n} took lots of photos with a camera.\nThey had lunch at a small cafe.\n${n} ordered ${f} and it was delicious.\nIn the evening, they watched the sunset.\nIt was the most beautiful sunset ${n} had ever seen.\n${n} will never forget this wonderful trip.`;
      return {
        title:`A Trip to the ${p.charAt(0).toUpperCase()+p.slice(1)}`, level:String(erRand(5,6)), category:"日常",
        text, newWords:[{w:p,m:getMeaning(PLACE_MEANINGS,p)},{w:e,m:getMeaning(EMOTION_MEANINGS,e)},{w:'imagine',m:'想象'}],
        comprehension:[
          {q:`Where did the family go on a trip?`,a:`They went to a ${p} far away.`},
          {q:`How long did they drive?`,a:`They drove for ${h} hours.`},
          {q:`What did ${n} order for lunch?`,a:`${n} ordered ${f}.`},
          {q:`What did they watch in the evening?`,a:`They watched the sunset.`}
        ],
        patterns:[
          {formula:"bigger than",example:`The ${p} was bigger than ${n} imagined.`,ref:["My school is bigger than yours.","An elephant is bigger than a cat."]},
          {formula:"will never forget",example:`${n} will never forget this wonderful trip.`,ref:["I will never forget this day.","She will never forget her first teacher."]}
        ]
      };
    },
    // Template 8: Helping at Home
    () => {
      const n = erPick(names), t = erPick(times), s = erPick(seasons);
      const text = `Every ${t}, ${n} helps at home.\n${n} sweeps the floor and cleans the windows.\nSometimes ${n} helps cook dinner.\n${n}'s mother says, "Thank you for helping."\n${n} also helps take care of the garden.\nIn ${s}, ${n} waters the plants every day.\nThe flowers grow beautifully with care.\n${n} also folds clothes and puts them away.\nHelping at home is not always easy.\nBut ${n} feels proud to help the family.\nEveryone should help at home.\nA family works together and loves together.`;
      return {
        title:`Helping at Home`, level:String(erRand(4,5)), category:"日常",
        text, newWords:[{w:'sweep',m:'打扫'},{w:'fold',m:'折叠'},{w:'proud',m:'自豪的'},{w:s,m:getMeaning(SEASON_MEANINGS,s)}],
        comprehension:[
          {q:`What does ${n} do to help at home?`,a:`${n} sweeps the floor, cleans windows, cooks dinner, waters plants, and folds clothes.`},
          {q:`What does ${n}'s mother say?`,a:'The mother says, "Thank you for helping."'},
          {q:`How does ${n} feel about helping?`,a:`${n} feels proud to help the family.`},
          {q:`What is the lesson of this story?`,a:"Everyone should help at home. A family works together and loves together."}
        ],
        patterns:[
          {formula:"Every + time, ...",example:`Every ${t}, ${n} helps at home.`,ref:["Every morning, I brush my teeth.","Every weekend, we visit grandma."]},
          {formula:"not always + adj",example:"Helping at home is not always easy.",ref:["Learning is not always fun.","Life is not always fair."]}
        ]
      };
    },
    // Template 9: The Brave Little [Animal]
    () => {
      const a = erPick(animals), p = erPick(places), n = erPick(names);
      const text = `There was a small ${a} named ${n}.\n${n} was the smallest ${a} in the family.\nEveryone said ${n} was too small to do anything.\nBut ${n} was brave and wanted to prove them wrong.\nOne day, a big storm came to the ${p}.\nThe wind blew hard and rain fell everywhere.\nAll the big animals were scared.\nBut ${n} was not afraid.\n${n} found a safe cave for everyone.\n${n} led all the animals to the cave.\nThey were safe and dry inside.\nThe big animals said, "Thank you, ${n}!"\n"You may be small, but you are very brave."\nBeing brave is not about size.\nIt is about having a big heart.`;
      return {
        title:`The Brave Little ${a.charAt(0).toUpperCase()+a.slice(1)}`, level:String(erRand(5,6)), category:"寓言",
        text, newWords:[{w:a,m:getMeaning(ANIMAL_MEANINGS,a)},{w:'brave',m:'勇敢的'},{w:'cave',m:'洞穴'},{w:'storm',m:'暴风雨'}],
        comprehension:[
          {q:`What was special about ${n}?`,a:`${n} was the smallest ${a} but was very brave.`},
          {q:`What happened one day?`,a:"A big storm came to the place and all the big animals were scared."},
          {q:`How did ${n} help everyone?`,a:`${n} found a safe cave and led all the animals to safety.`},
          {q:`What lesson does this story teach?`,a:"Being brave is not about size. It is about having a big heart."}
        ],
        patterns:[
          {formula:"too + adj + to + V",example:`Everyone said ${n} was too small to do anything.`,ref:["The baby is too young to walk.","The box is too heavy to lift."]},
          {formula:"not about + n",example:"Being brave is not about size.",ref:["Love is not about money.","Success is not about luck."]}
        ]
      };
    },
    // Template 10: My Dream for the Future
    () => {
      const n = erPick(names), job = erPick(['teacher','doctor','scientist','artist','pilot','writer','engineer','farmer','nurse','chef']);
      const JOB_MEANINGS = {teacher:'老师',doctor:'医生',scientist:'科学家',artist:'艺术家',pilot:'飞行员',writer:'作家',engineer:'工程师',farmer:'农民',nurse:'护士',chef:'厨师'};
      const text = `When I grow up, I want to be a ${job}.\nI have dreamed about this since I was little.\nA ${job} helps people and makes the world better.\nIf I am a ${job}, I will work very hard.\nI will learn everything about being a ${job}.\nMy teacher says I need to study hard.\nSo I study every day after school.\nI read books about famous ${job}s.\nI practice the skills I need.\nSometimes it is difficult, but I never give up.\nMy parents support my dream.\nThey say, "You can do anything!"\nI believe that dreams can come true.\nIf you work hard, anything is possible.`;
      return {
        title:`My Dream: To Be a ${job.charAt(0).toUpperCase()+job.slice(1)}`, level:String(erRand(5,6)), category:"日常",
        text, newWords:[{w:job,m:getMeaning(JOB_MEANINGS,job)},{w:'dream',m:'梦想'},{w:'support',m:'支持'},{w:'possible',m:'可能的'}],
        comprehension:[
          {q:`What does the writer want to be?`,a:`The writer wants to be a ${job}.`},
          {q:`What does the writer do to achieve the dream?`,a:"The writer studies hard, reads books, and practices skills every day."},
          {q:`What do the parents say?`,a:'The parents say, "You can do anything!"'},
          {q:`What does the writer believe?`,a:"The writer believes that dreams can come true if you work hard."}
        ],
        patterns:[
          {formula:"When I grow up, I want to + V",example:`When I grow up, I want to be a ${job}.`,ref:["When I grow up, I want to be a teacher.","When I grow up, I want to travel."]},
          {formula:"If + clause, ... will + V",example:"If you work hard, anything is possible.",ref:["If it rains, we will stay home.","If you practice, you will improve."]}
        ]
      };
    }
  ];

  const stories = [];
  let id = ER_STORIES.length + 1;
  // Generate enough to reach 800 total
  const need = 800 - ER_STORIES.length;
  for(let i = 0; i < need; i++){
    const template = templates[i % templates.length];
    const story = template();
    story.id = id++;
    stories.push(story);
  }
  return stories;
}

const ALL_ER_STORIES = [...ER_STORIES.map((s,i)=>({...s,id:i+1})), ...generateERStories()];

