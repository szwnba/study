// ===== 阅读 =====
function renderReading(stats, progRing){
  const rec = getModuleRecord(currentDate, 'reading');
  const passage = getTodayPassage();
  // Build annotated text with highlights
  let annotatedText = passage.text;
  // Highlight good sentences
  if(Array.isArray(passage.goodSentences)){
    passage.goodSentences.forEach(s=>{
      if(s && annotatedText.includes(s)){
        annotatedText = annotatedText.replace(s, `<span class="rd-highlight-sent">${s}</span>`);
      }
    });
  } else if(typeof passage.goodSentences === 'string'){
    if(annotatedText.includes(passage.goodSentences)){
      annotatedText = annotatedText.replace(passage.goodSentences, `<span class="rd-highlight-sent">${passage.goodSentences}</span>`);
    }
  }
  // Highlight core paragraph
  if(passage.corePara && annotatedText.includes(passage.corePara)){
    annotatedText = annotatedText.replace(passage.corePara, `<span class="rd-highlight-core">${passage.corePara}</span>`);
  }
  // Highlight good words
  if(passage.goodWords){
    passage.goodWords.forEach(w=>{
      const re = new RegExp(w.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'), 'g');
      annotatedText = annotatedText.replace(re, `<span class="rd-highlight-word">${w}</span>`);
    });
  }
  annotatedText = annotatedText.replace(/\n/g, '<br>');

  let extra = `<div class="tc-extra">
    <div style="font-size:13px;font-weight:600;color:var(--green-7);margin-bottom:8px;display:flex;align-items:center;gap:6px;flex-wrap:wrap">
      <span>📖</span><span>今日选文（第${readingState.idx+1}篇/共${getReadingPassageCount()}篇）</span>
      <span style="font-size:11px;color:var(--green-5);background:var(--green-1);padding:2px 8px;border-radius:8px">${passage.cat}</span>
      <span style="font-size:11px;color:var(--orange)">${passage.level}</span>
    </div>
    <div class="rd-legend">
      <span class="rd-legend-item"><span class="rd-legend-dot word"></span>好词</span>
      <span class="rd-legend-item"><span class="rd-legend-dot sent"></span>好句</span>
      <span class="rd-legend-item"><span class="rd-legend-dot core"></span>重点段落</span>
    </div>
    <div class="rd-passage-card">
      <div class="rd-passage-title">${passage.title}</div>
      <div class="rd-passage-text">${annotatedText}</div>
    </div>
    <div class="rd-section">
      <div class="rd-sec-title">✂️ 好词摘抄</div>
      <div class="rd-good-words">${passage.goodWords.map(w=>`<span class="rd-word-chip">${w}</span>`).join('')}</div>
    </div>
    <div class="rd-section">
      <div class="rd-sec-title">✨ 优美好句</div>
      <div class="rd-good-sents">${(Array.isArray(passage.goodSentences)?passage.goodSentences:[passage.goodSentences]).map(s=>`<div class="rd-sent-item">${s}</div>`).join('')}</div>
    </div>
    <div class="rd-section">
      <div class="rd-sec-title">📝 阅读批注</div>
      <div class="rd-annot">${passage.annot}</div>
    </div>
    <div class="rd-section">
      <div class="rd-sec-title">💭 感悟体会</div>
      <textarea id="readingReflection" class="rd-reflection-input" placeholder="读完这篇选文，你有什么感悟和体会？用自己的话写下来吧..." 
        oninput="saveReflection()">${readingState.reflection||''}</textarea>
      <div class="rd-reflection-tip">💡 先自己写感悟，写完后再点击下方查看参考范文</div>
      <div class="rd-ref-toggle" onclick="toggleReadingRef()">
        ${readingState.showRef?'📖 收起参考感悟范文':'📖 展开参考感悟范文（写完后再看哦）'}
      </div>
      ${readingState.showRef?`<div class="rd-ref-content">${passage.reflection}</div>`:''}
    </div>
    <div class="rd-nav">
      <button class="calc-btn reset" onclick="changeReadingPassage(-1)">‹ 上一篇选文</button>
      <button class="calc-btn start" onclick="changeReadingPassage(1)">下一篇选文 ›</button>
    </div>
  </div>`;

  let tasks = TASKS.reading.map(t=>{
    const done = !!rec[t.id];
    let taskExtra = '';
    if(t.id === 'intensive'){
      taskExtra = extra;
    }
    return renderTaskCard('reading', t, done, taskExtra);
  }).join('');
  let customHtml = renderCustomTasks('reading');
  return `${stats}${progRing}
    <div class="module-header"><span class="m-icon">📚</span><div><div class="m-title">每日阅读任务</div><div class="m-desc">300篇4-6年级课外选文 · 好词好句批注 · 感悟体会 · 参考范文</div></div></div>
    ${tasks}${customHtml}
  `;
}

