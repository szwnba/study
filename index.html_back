// 26秋沪教版四上课本完整内容（8个单元：对话+课文+句型+语法）
const ENGLISH_CONTENT = {
  1:{title:"Where do people live?",words:[{w:"city",m:"城市"},{w:"building",m:"建筑物"},{w:"flat",m:"公寓"},{w:"street",m:"街道"},{w:"country",m:"乡村"},{w:"farm",m:"农场"},{w:"house",m:"房子"},{w:"people",m:"人们"},{w:"live",m:"居住"},{w:"quiet",m:"安静的"}],text:"People live in all kinds of homes. Some live in flats and some live in houses.\n\nCities: There are a lot of people, streets and big buildings in cities. Many people live in flats.\n\nThe country: In the country, there are farms. People live in houses.",dialogue:[{who:"Boy",q:"Where do you live, Ningning?"},{who:"Ningning",a:"I live in Shenzhen. Shenzhen is a big city."},{who:"Boy",q:"Where do you live, Kate?"},{who:"Kate",a:"I live on a farm in the country."}],pattern:"Where do you live? I live in ___.",grammar:"Where do ... live? ... live ..."},
  2:{title:"Where do animals live?",words:[{w:"eagle",m:"老鹰"},{w:"owl",m:"猫头鹰"},{w:"honeybee",m:"蜜蜂"},{w:"nest",m:"巢穴"},{w:"tree hole",m:"树洞"},{w:"safe",m:"安全的"},{w:"snake",m:"蛇"},{w:"hive",m:"蜂巢"},{w:"make honey",m:"酿蜜"}],text:"Eagles live in big nests. Where are their nests? They are in the trees. Some eagles are white and brown. They eat rabbits, frogs and birds.\n\nOwls live in tree holes. They are safe there. Owls come out at night. They eat mice and snakes.\n\nHoneybees live in a hive. There, they make honey. They have food in winter. Honeybees have five eyes. They can't see the colour red.",dialogue:[],pattern:"Where do animals live? They live in ___.",grammar:"Where's / Where are ...? It's / They're ..."},
  3:{title:"How do we use numbers?",words:[{w:"plus",m:"加"},{w:"equal",m:"等于"},{w:"answer",m:"答案"},{w:"minus",m:"减"},{w:"odd numbers",m:"奇数"},{w:"even numbers",m:"偶数"},{w:"count",m:"数数"},{w:"how many",m:"多少"}],text:"Look at the numbers. Some numbers are even, and some numbers are odd. The even numbers are blue, and the odd numbers are red. We use numbers every day. They help us count things.",dialogue:[{who:"Boy",q:"You have five orange pencils. I have six green pencils. How many pencils do we have?"},{who:"Girl",a:"We have eleven pencils."},{who:"Boy",s:'We say, "Five plus six equals eleven." We write 5+6=11.'},{who:"Boy",q:"You have five apples. Your sister eats one. Now how many apples do you have?"},{who:"Girl",a:"I have four apples now."},{who:"Girl",s:'We say, "Five minus one equals four." We write 5-1=4.'}],pattern:"How many ... do we have? We have ...",grammar:"How many ... do we have? We have ... / We don't have ..."},
  4:{title:"What do we buy?",words:[{w:"supermarket",m:"超市"},{w:"a bag of rice",m:"一袋米"},{w:"a box of eggs",m:"一盒鸡蛋"},{w:"a bottle of juice",m:"一瓶果汁"},{w:"buy",m:"购买"},{w:"sell",m:"出售"},{w:"need",m:"需要"},{w:"shopping list",m:"购物单"},{w:"candy",m:"糖果"},{w:"bread",m:"面包"},{w:"share",m:"分享"},{w:"a bar of chocolate",m:"一块巧克力"}],text:"Let's go shopping!",dialogue:[{who:"Mum",a:"We need to buy some food."},{who:"Dad",a:"Let's play a game. We have 60 yuan. Here's the shopping list for each team. The faster team can buy some candy."},{who:"Mum",a:"We need some bread and a box of eggs."},{who:"Chen Lei",a:"Here they are."},{who:"Mum",q:"How much are the eggs?"},{who:"Chen Lei",a:"They're 15 yuan. And the bread is 12 yuan."},{who:"Dad",a:"We need some apples."},{who:"Chen Wei",a:"Here they are."},{who:"Dad",q:"Great. How much are they?"},{who:"Chen Wei",a:"This bag of apples is 12 yuan. This bag of carrots is 5 yuan."},{who:"Mum",a:"We still have 16 yuan. What would you like, Chen Lei?"},{who:"Chen Lei",a:"I'd like a bar of chocolate. I can share it with you all."}],pattern:"What would you like? I'd like ... / How much is/are ...?",grammar:"What would you like? I'd like ... / How much is/are ...? It's / They're ... yuan."},
  5:{title:"How are the seasons different?",words:[{w:"spring",m:"春天"},{w:"warm",m:"温暖的"},{w:"summer",m:"夏天"},{w:"hot",m:"炎热的"},{w:"autumn",m:"秋天"},{w:"cool",m:"凉爽的"},{w:"winter",m:"冬天"},{w:"cold",m:"寒冷的"},{w:"season",m:"季节"},{w:"grow",m:"生长"},{w:"snow",m:"下雪"}],text:"There are four seasons in a year: spring, summer, autumn and winter.\n\nSpring: Spring is a season for growing. It gets warm. It usually rains a lot. The rain helps plants grow.\n\nSummer: Summer comes after spring. It gets hot. The days are long and the nights are short. The sun helps fruit and flowers grow.\n\nAutumn: Autumn comes after summer. It gets cool. Leaves turn red, yellow and orange. Leaves fall in autumn.\n\nWinter: Winter comes after autumn. The days are short and the nights are long. It gets cold and it often snows! Many trees don't have leaves. Then it's spring! The seasons begin again.",dialogue:[],pattern:"It gets / snows ... It doesn't get / snow ...",grammar:"It gets / snows ... It doesn't get / snow ..."},
  6:{title:"What's amazing about plants?",words:[{w:"flower",m:"花"},{w:"fruit",m:"果实"},{w:"leaf",m:"叶子"},{w:"soil",m:"土壤"},{w:"sunflower",m:"向日葵"},{w:"seed",m:"种子"},{w:"plant",m:"植物"},{w:"root",m:"根"},{w:"tall",m:"高的"},{w:"round",m:"圆形的"},{w:"amazing",m:"令人惊叹的"}],text:"My sunflower (Observation Diary)\n\n3rd May: I have some small black sunflower seeds. I put a seed in the soil. Mum waters it.\n\n22nd May: Now the plant has some green leaves. But I can't see the roots. They grow down.\n\n21st July: Now my sunflower is tall with a big yellow flower. The flower is round. My family love it.\n\n3rd September: My sunflower has a lot of seeds. People can make oil from the seeds. Sunflowers are amazing!",dialogue:[],pattern:"It has ... / It doesn't have ...",grammar:"It has ... / It doesn't have ..."},
  7:{title:"How do we keep safe on the road?",words:[{w:"green light",m:"绿灯"},{w:"red light",m:"红灯"},{w:"wait",m:"等待"},{w:"cross",m:"穿越"},{w:"road",m:"马路"},{w:"should",m:"应该"},{w:"first",m:"首先"},{w:"left",m:"左边"},{w:"right",m:"右边"},{w:"skate",m:"滑滑板"},{w:"late",m:"迟到"}],text:"Our way to school",dialogue:[{who:"Dad",a:"The light is green. Let's cross the road. What should we do first?"},{who:"Yaoyao",a:"Look left! No cars."},{who:"Qiqi",a:"Look right! No cars."},{who:"Yaoyao",a:"It's safe to cross."},{who:"Qiqi",a:"I like walking to school."},{who:"Yaoyao",q:"I don't like walking. Can I ride a bike to school?"},{who:"Dad",a:"No. Children under 12 years old can't ride on the road."},{who:"Dad",a:"Don't run on the road, Qiqi."},{who:"Yaoyao",q:"Dad, can I skate to school?"},{who:"Dad",a:"No, sorry, kids. We can't skate on the road. It's not safe."},{who:"Dad",a:"Oh no! We're late!"},{who:"Yaoyao & Qiqi",a:"Dad, walk! Don't run!"}],pattern:"Wait ... / Don't play ...",grammar:"Wait ... / Don't play ..."},
  8:{title:"What do our grandparents do?",words:[{w:"go shopping",m:"购物"},{w:"go for a walk",m:"去散步"},{w:"use the internet",m:"使用互联网"},{w:"do exercise",m:"做运动"},{w:"do housework",m:"做家务"},{w:"do gardening",m:"做园艺"}],text:"Our grandparents' daily lives\n\nSaturday Morning: go for a walk. Afternoon: go shopping.\nSunday Morning: do gardening. Afternoon: do housework.",dialogue:[{who:"Junjun",a:"I'm Junjun. My sister and I are at our grandparents' house for a week."},{who:"Voice",a:"Our grandparents don't work now. Every morning, they go for a walk in the park. They often do tai chi with their friends there."},{who:"Voice",a:"It's Sunday morning. Grandma and I are in the supermarket. She always goes shopping on Sundays."},{who:"Voice",a:"In the afternoon, Grandpa usually does gardening. He has lots of plants. They look great."},{who:"Voice",a:"In the evening, Grandma shows us her food vlog. Lots of people watch it."}],pattern:"Go shopping / Go for a walk / Do exercise / Do housework / Do gardening",grammar:"Review (Units 1-7)"}
};

