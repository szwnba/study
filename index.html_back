      let sciIdx = ((dayOfYear - 1 + sciDayOffset) % SCIENCE_FACTS.length + SCIENCE_FACTS.length) % SCIENCE_FACTS.length;
      const sci = SCIENCE_FACTS[sciIdx];
      const savedNote = rec._science_note || '';
      extra = `<div class="tc-extra">
        <div class="sci-fact-card">
