<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#2E7D32">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="文文工作台">
<meta name="format-detection" content="telephone=no">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
<link rel="icon" type="image/png" sizes="512x512" href="icon-512.png">
<title>四年级工作台</title>
<style>
/* ========== Reset & Base ========== */
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none}
input,textarea{-webkit-user-select:text;user-select:text}
:root{
  --green-1:#E8F5E9; --green-2:#C8E6C9; --green-3:#A5D6A7; --green-4:#66BB6A; --green-5:#43A047; --green-6:#2E7D32; --green-7:#1B5E20;
  --bg:#F1F8E9; --card:#FFFFFF; --text:#2E7D32; --text-l:#558B5E; --text-d:#1B5E20; --muted:#81A684;
  --orange:#FF9800; --orange-l:#FFE0B2; --yellow:#FFC107; --red:#EF5350; --blue:#42A5F5; --purple:#AB47BC;
  --radius:14px; --radius-s:10px; --shadow:0 2px 12px rgba(46,125,50,.1); --shadow-l:0 4px 20px rgba(46,125,50,.15);
  --sidebar-w:240px; --topbar-h:56px;
}
html,body{height:100%;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--text);overflow:hidden}
button{font-family:inherit;cursor:pointer;border:none;outline:none;touch-action:manipulation}
input,select,textarea{font-family:inherit;outline:none}
ul,li{list-style:none}

/* ========== Layout ========== */
#app{display:flex;height:100%}

/* ===== Sidebar ===== */
#sidebar{width:var(--sidebar-w);background:linear-gradient(180deg,var(--green-6) 0%,var(--green-7) 100%);display:flex;flex-direction:column;flex-shrink:0;z-index:100;transition:transform .3s ease;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
#sidebar .logo{padding:16px 14px 12px;text-align:center;color:#fff;border-bottom:1px solid rgba(255,255,255,.15)}
#sidebar .logo .avatar{width:48px;height:48px;border-radius:50%;background:var(--yellow);margin:0 auto 6px;display:flex;align-items:center;justify-content:center;font-size:26px;box-shadow:0 2px 8px rgba(0,0,0,.2)}
#sidebar .logo .title{font-size:15px;font-weight:700;letter-spacing:1px}
#sidebar .logo .title-wrap{display:flex;align-items:center;justify-content:center;gap:6px}
#sidebar .logo .title-edit-btn{background:rgba(255,255,255,.2);border:none;color:#fff;font-size:11px;width:22px;height:22px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s;flex-shrink:0}
#sidebar .logo .title-edit-btn:hover{background:rgba(255,255,255,.4)}
#sidebar .logo .sub{font-size:10px;opacity:.7;margin-top:2px}
#nav{flex:1;overflow-y:auto;padding:8px 0}
#nav .nav-item{display:flex;align-items:center;gap:10px;padding:10px 16px;color:rgba(255,255,255,.8);font-size:13px;cursor:pointer;transition:all .2s;border-left:3px solid transparent;position:relative;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#nav .nav-item:hover{background:rgba(255,255,255,.1);color:#fff}
#nav .nav-item.active{background:rgba(255,255,255,.15);color:#fff;border-left-color:var(--yellow);font-weight:600}
#nav .nav-item .icon{font-size:18px;width:24px;text-align:center;flex-shrink:0}
#nav .nav-item .badge{margin-left:auto;background:var(--orange);color:#fff;font-size:10px;padding:1px 6px;border-radius:10px;font-weight:600}
#sidebar .sidebar-footer{padding:10px 14px;border-top:1px solid rgba(255,255,255,.15)}
#sidebar .sidebar-footer button{width:100%;padding:8px;border-radius:8px;background:rgba(255,255,255,.15);color:#fff;font-size:12px;transition:background .2s}
#sidebar .sidebar-footer button:hover{background:rgba(255,255,255,.25)}

/* ===== Main ===== */
#main{flex:1;display:flex;flex-direction:column;overflow:hidden}
#topbar{height:calc(var(--topbar-h) + env(safe-area-inset-top,0px));padding-top:env(safe-area-inset-top,0px);padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));background:var(--card);box-shadow:var(--shadow);display:flex;align-items:center;gap:12px;z-index:50;flex-shrink:0;position:sticky;top:0}
#topbar .hamburger{display:none;font-size:22px;color:var(--green-6);background:none;padding:4px}
#topbar .date-nav{display:flex;align-items:center;gap:8px}
#topbar .date-nav button{width:32px;height:32px;border-radius:8px;background:var(--green-1);color:var(--green-6);font-size:16px;display:flex;align-items:center;justify-content:center;transition:background .2s}
#topbar .date-nav button:hover{background:var(--green-2)}
#topbar .date-display{font-size:14px;font-weight:600;color:var(--text-d);min-width:120px;text-align:center}
#topbar .date-display .weekday{font-size:11px;color:var(--muted);font-weight:400}
#topbar .spacer{flex:1}
#topbar .points-pill{display:flex;align-items:center;gap:6px;background:linear-gradient(135deg,var(--orange),#FB8C00);color:#fff;padding:6px 14px;border-radius:20px;font-size:14px;font-weight:700;box-shadow:0 2px 8px rgba(255,152,0,.3)}
#topbar .pet-pill{display:flex;align-items:center;gap:4px;background:var(--green-1);padding:6px 12px;border-radius:20px;font-size:13px;color:var(--green-6);font-weight:600;cursor:pointer;transition:background .2s}
#topbar .pet-pill:hover{background:var(--green-2)}

#content{flex:1;overflow-y:auto;padding:16px;padding-bottom:calc(20px + env(safe-area-inset-bottom,0px));-webkit-overflow-scrolling:touch;overscroll-behavior-y:contain;touch-action:pan-y}

/* ===== Cards & Modules ===== */
.module-header{display:flex;align-items:center;gap:10px;margin-bottom:16px}
.module-header .m-icon{font-size:28px}
.module-header .m-title{font-size:20px;font-weight:700;color:var(--text-d)}
.module-header .m-desc{font-size:12px;color:var(--muted);margin-top:2px}

.task-card{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:16px;margin-bottom:12px;transition:all .3s}
.task-card.done{background:linear-gradient(135deg,var(--green-1),var(--green-2))}
.task-card .tc-head{display:flex;align-items:flex-start;gap:12px}
.task-card .tc-check{width:26px;height:26px;border-radius:50%;border:2.5px solid var(--green-3);flex-shrink:0;cursor:pointer;transition:all .2s;display:flex;align-items:center;justify-content:center;margin-top:2px}
.task-card .tc-check:hover{border-color:var(--green-5);transform:scale(1.1)}
.task-card.done .tc-check{background:var(--green-5);border-color:var(--green-5)}
.task-card.done .tc-check::after{content:'✓';color:#fff;font-size:15px;font-weight:700}
.task-card .tc-body{flex:1}
.task-card .tc-title{font-size:15px;font-weight:600;color:var(--text-d);margin-bottom:4px}
.task-card.done .tc-title{text-decoration:line-through;opacity:.6}
.task-card .tc-desc{font-size:12px;color:var(--text-l);line-height:1.6}
.task-card .tc-tags{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap}
.task-card .tc-tag{font-size:10px;padding:2px 8px;border-radius:10px;background:var(--green-1);color:var(--green-6)}
.task-card .tc-tag.points{background:var(--orange-l);color:#E65100}
.task-card .tc-actions{display:flex;gap:6px;margin-top:8px}
.task-card .tc-btn{font-size:11px;padding:4px 10px;border-radius:6px;background:var(--green-1);color:var(--green-6);transition:background .2s}
.task-card .tc-btn:hover{background:var(--green-2)}
.task-card .tc-btn.danger{background:#FFEBEE;color:var(--red)}
.task-card .tc-btn.danger:hover{background:#FFCDD2}
.task-card .tc-extra{margin-top:10px;padding-top:10px;border-top:1px dashed var(--green-2)}

/* ===== Stat Row ===== */
.stat-row{display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap}
.stat-box{flex:1;min-width:130px;background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:14px;text-align:center}
.stat-box .s-icon{font-size:24px;margin-bottom:4px}
.stat-box .s-value{font-size:22px;font-weight:700;color:var(--text-d)}
.stat-box .s-label{font-size:11px;color:var(--muted);margin-top:2px}

/* ===== Progress Ring ===== */
.progress-section{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:20px;margin-bottom:16px;text-align:center}
.progress-ring{position:relative;width:120px;height:120px;margin:0 auto 12px}
.progress-ring svg{transform:rotate(-90deg)}
.progress-ring .ring-bg{fill:none;stroke:var(--green-2);stroke-width:10}
.progress-ring .ring-fg{fill:none;stroke:var(--green-5);stroke-width:10;stroke-linecap:round;transition:stroke-dashoffset .5s ease}
.progress-ring .ring-text{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center}
.progress-ring .ring-text .rt-num{font-size:28px;font-weight:700;color:var(--text-d)}
.progress-ring .ring-text .rt-label{font-size:11px;color:var(--muted)}

/* ===== Add Task ===== */
.add-task-bar{display:flex;gap:8px;margin-bottom:12px}
.add-task-bar input{flex:1;padding:10px 14px;border:2px solid var(--green-2);border-radius:var(--radius-s);font-size:13px;background:var(--card);color:var(--text);transition:border-color .2s}
.add-task-bar input:focus{border-color:var(--green-5)}
.add-task-bar button{padding:10px 16px;background:var(--green-5);color:#fff;border-radius:var(--radius-s);font-size:13px;font-weight:600;transition:background .2s}
.add-task-bar button:hover{background:var(--green-6)}

/* ===== Buttons ===== */
.btn{padding:10px 18px;border-radius:var(--radius-s);font-size:13px;font-weight:600;transition:all .2s}
.btn-primary{background:var(--green-5);color:#fff}
.btn-primary:hover{background:var(--green-6)}
.btn-orange{background:var(--orange);color:#fff}
.btn-orange:hover{background:#F57C00}
.btn-outline{background:transparent;border:2px solid var(--green-4);color:var(--green-6)}
.btn-outline:hover{background:var(--green-1)}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn-row{display:flex;gap:8px;flex-wrap:wrap}

/* ===== Pet System ===== */
.pet-container{background:linear-gradient(180deg,#E8F5E9,#C8E6C9);border-radius:var(--radius);padding:24px;text-align:center;margin-bottom:16px;position:relative;overflow:hidden}
.pet-container::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:radial-gradient(circle at 50% 30%,rgba(255,255,255,.4),transparent 60%);pointer-events:none}
.pet-display{font-size:80px;line-height:1;position:relative;z-index:1;animation:petBob 2s ease-in-out infinite}
.pet-display.bouncing{animation:petBounce .5s ease infinite}
.pet-display.sad{animation:petDroop 3s ease-in-out infinite}
@keyframes petBob{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
@keyframes petBounce{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-15px) scale(1.1)}}
@keyframes petDroop{0%,100%{transform:translateY(2px) rotate(0)}50%{transform:translateY(4px) rotate(-2deg)}}
.pet-name{font-size:18px;font-weight:700;color:var(--text-d);margin-top:8px;position:relative;z-index:1}
.pet-status{font-size:13px;color:var(--text-l);margin-top:4px;position:relative;z-index:1}
.pet-fullness-bar{width:80%;max-width:300px;height:20px;background:rgba(255,255,255,.5);border-radius:10px;margin:14px auto 0;overflow:hidden;position:relative;z-index:1}
.pet-fullness-fill{height:100%;border-radius:10px;transition:width .5s ease,background .3s}
.pet-fullness-text{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:11px;font-weight:600;color:var(--text-d);z-index:1}
.pet-info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px;position:relative;z-index:1}
.pet-info-item{background:rgba(255,255,255,.7);border-radius:10px;padding:10px;text-align:center}
.pet-info-item .pi-icon{font-size:20px}
.pet-info-item .pi-val{font-size:16px;font-weight:700;color:var(--text-d);margin-top:2px}
.pet-info-item .pi-label{font-size:10px;color:var(--muted)}

/* ===== Error Ledger Table ===== */
.ledger-table-wrap{overflow-x:auto;border-radius:var(--radius);box-shadow:var(--shadow);background:var(--card)}
.ledger-table{width:100%;border-collapse:collapse;min-width:700px}
.ledger-table th{background:var(--green-5);color:#fff;padding:10px 8px;font-size:12px;font-weight:600;text-align:left;white-space:nowrap}
.ledger-table td{padding:8px;font-size:12px;border-bottom:1px solid var(--green-1);color:var(--text)}
.ledger-table tr:hover{background:var(--green-1)}
.ledger-table .col-action{text-align:center;white-space:nowrap}
.ledger-table .empty-row td{text-align:center;color:var(--muted);padding:30px}

/* ===== Modal ===== */
.modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.4);z-index:1000;display:none;align-items:center;justify-content:center;padding:16px}
.modal-overlay.show{display:flex}
.modal{background:var(--card);border-radius:var(--radius);width:100%;max-width:460px;max-height:85vh;overflow-y:auto;box-shadow:var(--shadow-l)}
.modal-head{padding:16px 20px;border-bottom:1px solid var(--green-2);display:flex;align-items:center;justify-content:between}
.modal-head .mh-title{font-size:16px;font-weight:700;color:var(--text-d);flex:1}
.modal-head .mh-close{font-size:22px;color:var(--muted);background:none;width:32px;height:32px}
.modal-body{padding:20px}
.modal-body .form-group{margin-bottom:14px}
.modal-body .form-group label{display:block;font-size:13px;font-weight:600;color:var(--text-d);margin-bottom:6px}
.modal-body .form-group input,.modal-body .form-group select,.modal-body .form-group textarea{width:100%;padding:10px 12px;border:2px solid var(--green-2);border-radius:8px;font-size:13px;color:var(--text);transition:border-color .2s}
.modal-body .form-group input:focus,.modal-body .form-group select:focus,.modal-body .form-group textarea:focus{border-color:var(--green-5)}
.modal-body .form-group textarea{resize:vertical;min-height:60px}
.modal-foot{padding:12px 20px;border-top:1px solid var(--green-2);display:flex;gap:8px;justify-content:flex-end}

/* ===== Toast ===== */
#toast{position:fixed;top:70px;left:50%;transform:translateX(-50%) translateY(-20px);background:var(--green-6);color:#fff;padding:10px 24px;border-radius:20px;font-size:14px;font-weight:600;z-index:2000;opacity:0;transition:all .3s;pointer-events:none;box-shadow:var(--shadow-l)}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#toast.orange{background:var(--orange)}
#toast.red{background:var(--red)}

/* ===== Points History ===== */
.points-history{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden}
.points-history .ph-item{display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid var(--green-1)}
.points-history .ph-item:last-child{border-bottom:none}
.points-history .ph-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.points-history .ph-icon.earn{background:var(--green-1)}
.points-history .ph-icon.spend{background:var(--orange-l)}
.points-history .ph-info{flex:1}
.points-history .ph-desc{font-size:13px;font-weight:600;color:var(--text-d)}
.points-history .ph-time{font-size:11px;color:var(--muted)}
.points-history .ph-amount{font-size:15px;font-weight:700}
.points-history .ph-amount.earn{color:var(--green-5)}
.points-history .ph-amount.spend{color:var(--orange)}

/* ===== Game Cards ===== */
.game-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
.game-card{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:16px;text-align:center;cursor:pointer;transition:all .2s}
.game-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-l)}
.game-card .gc-icon{font-size:36px;margin-bottom:8px}
.game-card .gc-title{font-size:13px;font-weight:600;color:var(--text-d)}
.game-card .gc-desc{font-size:11px;color:var(--muted);margin-top:4px}

/* ===== Vocab Cards ===== */
.vocab-section{margin-bottom:16px}
.vocab-section .vs-title{font-size:14px;font-weight:700;color:var(--text-d);margin-bottom:8px;padding-left:4px}
.vocab-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px}
.vocab-card{background:var(--card);border-radius:10px;box-shadow:var(--shadow);padding:10px;text-align:center;transition:all .2s}
.vocab-card:hover{box-shadow:var(--shadow-l)}
.vocab-card .vc-word{font-size:14px;font-weight:700;color:var(--text-d)}
.vocab-card .vc-meaning{font-size:11px;color:var(--text-l);margin-top:2px}

/* ===== Recitation List ===== */
.recite-list{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;margin-bottom:12px}
.recite-item{display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid var(--green-1);cursor:pointer;transition:background .2s}
.recite-item:hover{background:var(--green-1)}
.recite-item:last-child{border-bottom:none}
.recite-item .ri-num{width:28px;height:28px;border-radius:50%;background:var(--green-1);color:var(--green-6);font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.recite-item.done .ri-num{background:var(--green-5);color:#fff}
.recite-item .ri-title{flex:1;font-size:13px;color:var(--text-d);font-weight:500}
.recite-item.done .ri-title{color:var(--muted)}
.recite-item .ri-status{font-size:18px}
.recite-item.done .ri-status{color:var(--green-5)}

/* ===== Empty State ===== */
.empty-state{text-align:center;padding:40px 20px;color:var(--muted)}
.empty-state .es-icon{font-size:48px;margin-bottom:8px;opacity:.5}
.empty-state .es-text{font-size:14px}

/* ===== Streak Badge ===== */
.streak-badge{display:inline-flex;align-items:center;gap:4px;background:linear-gradient(135deg,#FF6B6B,#EE5A24);color:#fff;padding:4px 10px;border-radius:12px;font-size:12px;font-weight:700}

/* ===== Section Title ===== */
.section-title{font-size:15px;font-weight:700;color:var(--text-d);margin:20px 0 10px;padding-left:4px;display:flex;align-items:center;gap:6px}

/* ===== Mobile Overlay ===== */
#sidebar-overlay{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.4);z-index:99}

/* ===== Exchange Card ===== */
.exchange-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
.exchange-card{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:20px 16px;text-align:center;transition:all .2s}
.exchange-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-l)}
.exchange-card .ec-icon{font-size:36px;margin-bottom:8px}
.exchange-card .ec-title{font-size:14px;font-weight:600;color:var(--text-d)}
.exchange-card .ec-cost{font-size:12px;color:var(--orange);font-weight:700;margin-top:4px}
.exchange-card .ec-btn{margin-top:10px;padding:6px 16px;border-radius:8px;background:var(--green-5);color:#fff;font-size:12px;font-weight:600}
.exchange-card .ec-btn:disabled{background:#CCC}

/* ===== Content Detail Styles ===== */
.tc-extra{margin-top:12px;padding-top:12px;border-top:1px dashed var(--green-2)}

/* Recitation list */
.recite-list{display:flex;flex-direction:column;gap:6px}
.recite-item{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--green-1);border-radius:10px;cursor:pointer;transition:all .2s;border:1.5px solid transparent}
.recite-item:hover{background:var(--green-2)}
.recite-item.done{background:linear-gradient(135deg,#E8F5E9,#C8E6C9);border-color:var(--green-4)}
.ri-num{width:24px;height:24px;border-radius:50%;background:var(--green-5);color:#fff;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ri-title-wrap{flex:1;min-width:0}
.ri-title{font-size:13px;font-weight:600;color:var(--text-d);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ri-meta{font-size:10px;color:var(--muted);margin-top:2px}
.ri-status{font-size:18px;cursor:pointer;flex-shrink:0;padding:4px}
.ri-arrow{font-size:10px;color:var(--muted);flex-shrink:0;transition:transform .2s}

/* Recitation detail panel */
.recite-detail{background:#FAFAFA;border-radius:10px;padding:14px;margin-top:2px;margin-bottom:6px;border:1px solid var(--green-2);animation:fadeIn .2s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}
.rd-block{margin-bottom:12px}
.rd-block:last-child{margin-bottom:0}
.rd-label{font-size:12px;font-weight:700;color:var(--green-6);margin-bottom:4px;display:flex;align-items:center;gap:4px}
.rd-content{font-size:13px;line-height:1.7;color:#333;background:#fff;padding:10px 12px;border-radius:8px;border:1px solid #EEE}
.rd-content.poem{font-family:"STKaiti","KaiTi",serif;font-size:15px;letter-spacing:2px;text-align:center;color:var(--text-d)}
.rd-content.translation{color:#555;font-size:12px}
.rd-content.theme{color:var(--green-7);font-size:12px;font-style:italic}
.rd-content.req{color:var(--orange);font-size:11px;font-weight:600}

/* Reading comprehension */
.reading-card{background:#FAFAFA;border-radius:10px;padding:14px;border:1px solid var(--green-2)}
.rc-title{font-size:14px;font-weight:700;color:var(--text-d);margin-bottom:8px}
.rc-text{font-size:13px;line-height:1.8;color:#333;background:#fff;padding:12px;border-radius:8px;border:1px solid #EEE;margin-bottom:10px}
.rc-questions{display:flex;flex-direction:column;gap:8px}
.rcq{font-size:12px;color:#333;line-height:1.6}
.rcq-num{font-weight:700;color:var(--green-6)}
.rcq-a{margin-top:4px;padding:6px 10px;background:var(--green-1);border-radius:6px;font-size:11px;color:var(--green-7);border-left:3px solid var(--green-4)}

/* English textbook content */
.eng-unit-list{display:flex;flex-direction:column;gap:10px}
.eng-unit-card{background:#FAFAFA;border-radius:10px;border:1px solid var(--green-2);overflow:hidden}
.eng-unit-head{display:flex;align-items:center;gap:8px;padding:10px 12px;background:var(--green-1);cursor:pointer;transition:background .2s}
.eng-unit-head:hover{background:var(--green-2)}
.eng-unit-num{width:22px;height:22px;border-radius:50%;background:var(--green-5);color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.eng-unit-title{flex:1;font-size:13px;font-weight:600;color:var(--text-d)}
.eng-unit-arrow{font-size:10px;color:var(--muted)}
.eng-unit-body{padding:12px;display:none}
.eng-unit-body.open{display:block;animation:fadeIn .2s ease}
.eng-section{margin-bottom:10px}
.eng-section:last-child{margin-bottom:0}
.eng-sec-label{font-size:11px;font-weight:700;color:var(--blue);margin-bottom:4px;display:flex;align-items:center;gap:4px}
.eng-text{font-size:12px;line-height:1.7;color:#333;background:#fff;padding:10px;border-radius:8px;border:1px solid #EEE;white-space:pre-wrap}
.eng-dialogue{font-size:12px;line-height:1.8;background:#fff;padding:10px;border-radius:8px;border:1px solid #EEE}
.eng-dl-line{padding:2px 0}
.eng-dl-line .who{font-weight:700;color:var(--green-6)}
.eng-pattern{font-size:12px;color:var(--purple);background:#F3E5F5;padding:8px 10px;border-radius:8px;font-weight:600}
.eng-grammar{font-size:11px;color:#666;background:#FFF3E0;padding:6px 10px;border-radius:6px}
.eng-words{display:flex;flex-wrap:wrap;gap:4px}
.eng-word-chip{display:inline-flex;align-items:center;gap:4px;padding:3px 8px;background:var(--green-1);border-radius:12px;font-size:11px}
.eng-word-chip b{color:var(--green-6)}
.eng-word-chip span{color:var(--muted)}

/* Science facts */
.sci-fact-card{background:linear-gradient(135deg,#E3F2FD,#E8F5E9);border-radius:12px;padding:16px;border:1px solid var(--green-2);margin-top:8px}
.sci-cat{display:inline-block;padding:3px 10px;border-radius:12px;font-size:11px;font-weight:700;color:#fff;margin-bottom:8px}
.sci-cat.自然{background:#66BB6A}.sci-cat.动物{background:#FF9800}.sci-cat.植物{background:#43A047}
.sci-cat.天文{background:#5C6BC0}.sci-cat.地理{background:#8D6E63}.sci-cat.人体{background:#EF5350}
.sci-cat.生活{background:#26C6DA}.sci-cat.恐龙{background:#7E57C2}.sci-cat.海洋{background:#0288D1}
.sci-cat.物理{background:#5C6BC0}.sci-cat.化学{background:#AB47BC}
.sci-tryit{font-size:12px;color:#1565C0;background:#E3F2FD;padding:8px 12px;border-radius:8px;border-left:3px solid #1565C0;margin-top:8px;display:flex;align-items:flex-start;gap:6px}
/* ===== 趣味游戏样式 ===== */
/* 游戏卡片网格（2列） */
.game-card-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.game-card-real{background:var(--card);border-radius:14px;padding:18px 14px;text-align:center;box-shadow:var(--shadow);cursor:pointer;transition:all .25s;border:2px solid transparent}
.game-card-real:hover{transform:translateY(-3px);box-shadow:0 6px 16px rgba(76,175,80,.15);border-color:var(--green-4)}
.gcr-icon{font-size:40px;margin-bottom:8px;line-height:1}
.gcr-title{font-size:14px;font-weight:700;color:var(--text-d);margin-bottom:4px}
.gcr-desc{font-size:11px;color:var(--muted);line-height:1.4}

/* 成语接龙 */
.chain-score{text-align:center;font-size:16px;color:var(--green-6);background:var(--green-l);padding:10px;border-radius:10px;margin-bottom:12px}
.chain-current{text-align:center;font-size:14px;color:var(--text-d);margin-bottom:6px}
.chain-word{font-size:20px;color:var(--orange);padding:2px 10px;background:#FFF3E0;border-radius:6px;display:inline-block}
.chain-next{text-align:center;font-size:13px;color:var(--text-l);margin-bottom:14px}
.chain-letter{font-size:20px;color:var(--red);font-weight:700;background:#FFEBEE;padding:2px 10px;border-radius:6px;margin:0 4px}
.chain-input{width:100%;padding:12px;font-size:18px;text-align:center;border:2px solid var(--green-3);border-radius:10px;outline:none;font-family:inherit;margin-bottom:12px}
.chain-input:focus{border-color:var(--green-5)}
.chain-history{background:var(--bg);padding:10px;border-radius:10px;margin-bottom:10px;line-height:1.8}
.ch-label{font-size:12px;color:var(--text-l);margin-bottom:4px}
.ch-tag{display:inline-block;background:var(--card);padding:3px 8px;border-radius:6px;font-size:13px;margin:2px;color:var(--green-6);font-weight:600;border:1px solid var(--green-2)}
.chain-tip{font-size:12px;color:var(--text-l);background:var(--orange-l);padding:8px 10px;border-radius:8px;color:#E65100}

/* 句子仿写 */
.sentence-template{background:linear-gradient(135deg,#FFF8E1,#FFE0B2);padding:14px;border-radius:10px;margin-bottom:12px;font-size:14px;line-height:1.7;color:var(--text-d)}
.sentence-template b{color:var(--orange);font-size:16px}
.sentence-hint{font-size:13px;color:var(--text-l);background:var(--bg);padding:8px 12px;border-radius:8px;margin-bottom:10px}
.sentence-example{background:var(--green-l);padding:12px;border-radius:10px;margin-bottom:12px;font-size:13px;line-height:1.7}
.sentence-example i{color:var(--green-6)}
.sentence-textarea{width:100%;padding:10px;font-size:14px;border:2px solid var(--green-3);border-radius:10px;outline:none;font-family:inherit;resize:vertical;box-sizing:border-box}

/* 九宫数独 */
.sudoku-tip{font-size:12px;color:var(--text-l);background:var(--blue-l);padding:8px 12px;border-radius:8px;margin-bottom:10px;line-height:1.5;color:#1565C0}
.sudoku-grid{display:grid;grid-template-columns:repeat(9,1fr);gap:1px;background:var(--text-d);border:3px solid var(--text-d);width:100%;max-width:380px;margin:0 auto 12px;aspect-ratio:1}
.sudoku-cell{background:var(--card);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:600;cursor:pointer;transition:all .15s;user-select:none;color:var(--text-d)}
.sudoku-cell.given{background:#FAFAFA;color:var(--text-d);font-weight:700;cursor:default}
.sudoku-cell.selected{background:var(--green-2)!important;color:var(--green-6);font-weight:700}
.sudoku-cell:hover:not(.given){background:var(--green-l)}
.sudoku-cell.r-top{border-top:2px solid var(--text-d)}
.sudoku-cell.r-bottom{border-bottom:2px solid var(--text-d)}
.sudoku-cell.c-left{border-left:2px solid var(--text-d)}
.sudoku-cell.c-right{border-right:2px solid var(--text-d)}
.sudoku-pad{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-bottom:12px;max-width:380px;margin-left:auto;margin-right:auto}
.sudoku-num-btn{padding:10px;border:2px solid var(--green-3);border-radius:8px;background:var(--card);font-size:16px;font-weight:700;cursor:pointer;transition:all .15s;color:var(--green-6)}
.sudoku-num-btn:hover{background:var(--green-2);transform:scale(1.05)}
.sudoku-num-btn.del{background:var(--red);color:#fff;border-color:var(--red)}
.sudoku-actions{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}

/* 抓大鹅 */
.goose-stats{display:flex;justify-content:space-around;background:linear-gradient(135deg,#E3F2FD,#FFF8E1);padding:10px;border-radius:10px;margin-bottom:10px;font-size:14px;color:var(--text-d)}
.goose-stats b{color:var(--orange);font-size:16px}
.goose-tip{font-size:12px;color:#1565C0;background:#E3F2FD;padding:8px 12px;border-radius:8px;margin-bottom:12px}
.goose-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:12px}
.goose-card{aspect-ratio:1;background:var(--green-5);border-radius:10px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:transform .3s;color:#fff;font-size:14px;position:relative;perspective:600px;user-select:none}
.goose-card .goose-back,.goose-card .goose-front{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:10px;backface-visibility:hidden;font-size:13px;text-align:center;padding:4px;line-height:1.3}
.goose-card .goose-back{background:linear-gradient(135deg,#FF9800,#FF5722);transform:rotateY(0)}
.goose-card .goose-front{background:linear-gradient(135deg,#4CAF50,#2E7D32);transform:rotateY(180deg);font-size:15px}
.goose-card.flipped .goose-back{transform:rotateY(180deg)}
.goose-card.flipped .goose-front{transform:rotateY(0)}
.goose-card.matched{background:linear-gradient(135deg,#FFD54F,#FF9800)!important;cursor:default;animation:matchPop .5s}
.goose-card.matched .goose-front{background:linear-gradient(135deg,#FFD54F,#FF9800);color:#fff}
@keyframes matchPop{0%{transform:scale(1)}50%{transform:scale(1.15)}100%{transform:scale(1)}}
@media(max-width:480px){.goose-grid{grid-template-columns:repeat(4,1fr);gap:5px}.goose-card .goose-front{font-size:12px}.goose-card .goose-back{font-size:11px}.sudoku-cell{font-size:14px}}

.game-tabs{display:flex;gap:8px;overflow-x:auto;padding-bottom:6px;margin-bottom:14px}
.game-tab{flex-shrink:0;padding:8px 16px;border-radius:20px;background:var(--bg);font-size:13px;font-weight:600;color:var(--text-l);cursor:pointer;transition:all .2s;white-space:nowrap;border:2px solid transparent}
.game-tab.active{background:var(--green-5);color:#fff;border-color:var(--green-6)}
.game-panel{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:20px;min-height:280px}
.gp-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.gp-title{font-size:16px;font-weight:700;color:var(--text-d);display:flex;align-items:center;gap:8px}
.gp-counter{font-size:12px;color:var(--muted);background:var(--bg);padding:4px 10px;border-radius:12px}
.gp-question{font-size:18px;font-weight:700;color:var(--text-d);text-align:center;padding:24px 16px;background:linear-gradient(135deg,#FFF8E1,#E3F2FD);border-radius:12px;margin-bottom:16px;line-height:1.6}
.gp-hint{font-size:13px;color:var(--text-l);text-align:center;margin-bottom:12px}
.gp-options{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}
.gp-opt{padding:14px;border-radius:10px;background:var(--bg);border:2px solid var(--green-2);font-size:14px;font-weight:600;text-align:center;cursor:pointer;transition:all .2s;color:var(--text-d)}
.gp-opt:hover{border-color:var(--green-5);background:var(--green-1)}
.gp-opt.correct{background:#C8E6C9;border-color:#4CAF50;color:#2E7D32}
.gp-opt.wrong{background:#FFCDD2;border-color:#EF5350;color:#C62828}
.gp-answer{background:var(--green-1);border-radius:10px;padding:14px;margin-bottom:12px;border-left:4px solid var(--green-5)}
.gp-answer-label{font-size:11px;color:var(--green-6);font-weight:700;margin-bottom:4px}
.gp-answer-text{font-size:14px;color:var(--text-d);line-height:1.6}
.gp-btn-row{display:flex;gap:10px;justify-content:center;margin-top:12px}
.gp-btn{padding:10px 24px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;transition:all .2s;border:none}
.gp-btn-primary{background:var(--green-5);color:#fff}
.gp-btn-primary:hover{background:var(--green-6)}
.gp-btn-secondary{background:var(--orange);color:#fff}
.gp-btn-secondary:hover{opacity:.9}
.gp-btn-ghost{background:var(--bg);color:var(--text-l)}
.gp-reveal{font-size:13px;color:var(--orange);cursor:pointer;text-align:center;padding:8px;border-radius:8px;background:#FFF3E0;margin-bottom:8px;font-weight:600}
.gp-reveal:hover{background:#FFE0B2}
.gp-feedback{text-align:center;font-size:14px;font-weight:700;padding:10px;border-radius:8px;margin-bottom:10px}
.gp-feedback.right{background:#C8E6C9;color:#2E7D32}
.gp-feedback.wrong{background:#FFCDD2;color:#C62828}
.gp-idiom-display{font-size:24px;font-weight:700;color:var(--text-d);text-align:center;padding:20px;background:linear-gradient(135deg,#FFF3E0,#F3E5F5);border-radius:12px;margin-bottom:12px;letter-spacing:4px}
.gp-blank{display:inline-block;width:40px;border-bottom:3px solid var(--orange);margin:0 4px}
.gp-nums{display:flex;gap:12px;justify-content:center;margin-bottom:16px}
.gp-num-card{width:60px;height:60px;border-radius:12px;background:linear-gradient(135deg,#FF9800,#FF5722);color:#fff;font-size:28px;font-weight:700;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(255,87,34,.3)}
@media(max-width:480px){.gp-options{grid-template-columns:1fr}.gp-num-card{width:48px;height:48px;font-size:22px}}
.sci-title{font-size:15px;font-weight:700;color:var(--text-d);margin-bottom:8px}
.sci-content{font-size:13px;line-height:1.8;color:#333;background:#fff;padding:12px;border-radius:8px;margin-bottom:8px}
.sci-tip{font-size:12px;color:var(--orange);background:#FFF3E0;padding:8px 12px;border-radius:8px;border-left:3px solid var(--orange);display:flex;align-items:flex-start;gap:6px}
.sci-nav{display:flex;gap:8px;margin-top:10px;justify-content:center}
.sci-nav button{padding:6px 16px;border-radius:8px;background:var(--green-5);color:#fff;font-size:12px;font-weight:600}

/* Olympiad problems */
.oly-list{display:flex;flex-direction:column;gap:8px}
.oly-card{background:#FAFAFA;border-radius:10px;padding:12px;border:1px solid var(--green-2)}
.oly-type{display:inline-block;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;color:#fff;margin-bottom:6px}
.oly-type.鸡兔同笼{background:#FF9800}.oly-type.和差问题{background:#42A5F5}.oly-type.和倍问题{background:#AB47BC}
.oly-type.差倍问题{background:#26C6DA}.oly-type.盈亏问题{background:#EF5350}.oly-type.基础行程{background:#66BB6A}
.oly-type.植树问题{background:#8D6E63}.oly-type.数论初步{background:#5C6BC0}.oly-type.等差数列{background:#EC407A}
.oly-type.容斥原理{background:#FF7043}
.oly-q{font-size:13px;color:#333;line-height:1.6;margin-bottom:6px}
.oly-toggle{font-size:11px;color:var(--green-6);cursor:pointer;font-weight:600;padding:4px 0}
.oly-hint{font-size:11px;color:var(--blue);background:#E3F2FD;padding:8px 10px;border-radius:6px;margin-top:6px;display:none}
.oly-hint.show{display:block}
.oly-a{font-size:12px;color:var(--green-7);background:var(--green-1);padding:8px 10px;border-radius:6px;margin-top:6px;font-weight:600;display:none}
.oly-a.show{display:block}

/* ===== Math Module: Speed Calc ===== */
.calc-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px}
.calc-timer{font-size:18px;font-weight:800;color:#e53935;background:#FFF3E0;padding:6px 14px;border-radius:8px;font-variant-numeric:tabular-nums}
.calc-timer.done{color:var(--green-7);background:var(--green-1)}
.calc-info{font-size:12px;color:var(--text-l)}
.calc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:6px;margin-bottom:10px}
.calc-item{background:#FAFAFA;border:1px solid var(--green-2);border-radius:8px;padding:8px 10px;text-align:center}
.calc-item.correct{background:#E8F5E9;border-color:#66BB6A}
.calc-item.wrong{background:#FFEBEE;border-color:#EF5350}
.calc-expr{font-size:13px;font-weight:600;color:#333;margin-bottom:4px;white-space:nowrap}
.calc-input{width:60px;border:1px solid var(--green-3);border-radius:6px;padding:3px 6px;font-size:13px;text-align:center;color:#333}
.calc-input:focus{outline:none;border-color:var(--green-6);box-shadow:0 0 0 2px rgba(76,175,80,.15)}
.calc-input:disabled{background:#f0f0f0;color:#999}
.calc-ans{font-size:11px;color:var(--green-7);font-weight:600}
.calc-ans.wrong{color:#e53935}
.calc-result{background:var(--green-1);border-radius:10px;padding:12px;margin-top:10px;text-align:center}
.calc-result-score{font-size:22px;font-weight:800;color:var(--green-7)}
.calc-result-detail{font-size:12px;color:var(--text-l);margin-top:4px}
.calc-btns{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.calc-btn{padding:6px 16px;border:none;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer}
.calc-btn.start{background:var(--green-6);color:#fff}
.calc-btn.submit{background:#FF9800;color:#fff}
.calc-btn.reset{background:#E0E0E0;color:#666}

/* ===== Math Module: Word Problems ===== */
.wp-card{background:#FAFAFA;border-radius:10px;padding:14px;border:1px solid var(--green-2);margin-bottom:10px}
.wp-cat{display:inline-block;padding:2px 10px;border-radius:10px;font-size:10px;font-weight:700;color:#fff;margin-bottom:6px}
.wp-cat.行程问题{background:#42A5F5}.wp-cat.和差倍{background:#AB47BC}.wp-cat.鸡兔同笼{background:#FF9800}
.wp-cat.植树问题{background:#8D6E63}.wp-cat.工程问题{background:#66BB6A}.wp-cat.年龄问题{background:#EC407A}
.wp-cat.还原问题{background:#5C6BC0}.wp-cat.平均数{background:#26C6DA}.wp-cat.归一归总{background:#FF7043}
.wp-cat.盈亏问题{background:#EF5350}.wp-cat.几何问题{background:#7E57C2}.wp-cat.分数应用{background:#26A69A}
.wp-cat.百分数{background:#789262}.wp-cat.比例问题{background:#BDB76B}
.wp-q{font-size:13px;color:#333;line-height:1.7;margin-bottom:8px}
.wp-analysis{font-size:12px;color:var(--blue);background:#E3F2FD;padding:8px 10px;border-radius:6px;margin-top:6px;display:none;line-height:1.6}
.wp-analysis.show{display:block}
.wp-answer{font-size:12px;color:var(--green-7);background:var(--green-1);padding:8px 10px;border-radius:6px;margin-top:6px;font-weight:600;display:none}
.wp-answer.show{display:block}
.wp-nav{display:flex;align-items:center;justify-content:space-between;margin-top:8px}
.wp-nav-btns{display:flex;gap:8px}

/* ===== Math Module: Olympiad ===== */
.oly-level{display:inline-block;padding:1px 6px;border-radius:8px;font-size:9px;font-weight:700;margin-left:4px}
.oly-level.L1{background:#E8F5E9;color:#2E7D32}.oly-level.L2{background:#FFF3E0;color:#E65100}
.oly-level.L3{background:#FFEBEE;color:#C62828}.oly-level.L4{background:#F3E5F5;color:#6A1B9A}

/* Math answer input */
.wp-answer-input-wrap{margin-top:10px;padding:10px;background:#F5F5F5;border-radius:8px}
.wp-answer-label{font-size:12px;font-weight:600;color:var(--green-7);margin-bottom:6px}
.wp-answer-input-row{display:flex;gap:8px;align-items:center}
.wp-answer-input{flex:1;padding:8px 12px;border:2px solid var(--green-3);border-radius:8px;font-size:14px;outline:none;transition:border-color .2s}
.wp-answer-input:focus{border-color:var(--green-5)}
.wp-answer-result{padding:10px;border-radius:8px;margin-top:8px}
.wp-answer-result.correct{background:#E8F5E9;border:1px solid #66BB6A}
.wp-answer-result.wrong{background:#FFEBEE;border:1px solid #EF5350}
.wp-result-status{font-size:14px;font-weight:700;margin-bottom:4px}
.wp-answer-result.correct .wp-result-status{color:#2E7D32}
.wp-answer-result.wrong .wp-result-status{color:#C62828}
.wp-result-your{font-size:12px;color:#666;margin-top:4px}
.wp-result-correct{font-size:12px;color:var(--green-7);font-weight:600;margin-top:2px}

/* English audio */
.eng-audio-bar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:10px 0}
.eng-audio-btn{padding:6px 14px;border-radius:20px;border:none;font-size:12px;font-weight:600;cursor:pointer;transition:all .2s;background:var(--green-1);color:var(--green-7)}
.eng-audio-btn:hover{background:var(--green-2)}
.eng-audio-btn.active{background:var(--green-5);color:#fff}
.eng-audio-btn.stop{background:#FFEBEE;color:#C62828}
.eng-audio-btn.submit{background:#FFF3E0;color:#E65100}
.eng-playing-indicator{font-size:12px;color:var(--green-6);animation:pulse 1s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
.eng-text-display{background:#FAFAFA;border-radius:8px;padding:12px;font-size:13px;line-height:1.8;color:#333;border:1px solid var(--green-2);margin-bottom:10px}
.eng-sentence-view{background:#E3F2FD;border-radius:8px;padding:12px;margin:10px 0}
.eng-sent-current{font-size:14px;color:#1565C0;font-weight:600;margin-bottom:8px;line-height:1.6}
.eng-sent-nav{display:flex;gap:8px;align-items:center;justify-content:center;flex-wrap:wrap}
.eng-sent-btn{padding:4px 10px;border-radius:12px;border:none;font-size:11px;cursor:pointer;background:#fff;color:#1565C0;font-weight:600}
.eng-sent-btn:hover{background:#BBDEFB}
.eng-sent-btn.replay{background:#FFF3E0;color:#E65100}
.eng-sent-count{font-size:12px;color:#1565C0;font-weight:600}
.eng-dict-section{margin-top:10px}
.eng-dict-label{font-size:12px;font-weight:600;color:var(--green-7);margin-bottom:6px}
.eng-dict-input{width:100%;min-height:120px;padding:10px;border:2px solid var(--green-3);border-radius:8px;font-size:13px;line-height:1.6;resize:vertical;font-family:inherit;outline:none}
.eng-dict-input:focus{border-color:var(--green-5)}
.eng-dict-btns{display:flex;gap:8px;align-items:center;margin-top:8px;flex-wrap:wrap}
.eng-dict-tip{font-size:11px;color:var(--text-l)}
.eng-dict-result{padding:12px;border-radius:8px;margin-top:8px}
.eng-dict-result.pass{background:#E8F5E9;border:1px solid #66BB6A}
.eng-dict-result.fail{background:#FFEBEE;border:1px solid #EF5350}
.eng-dict-score{font-size:13px;font-weight:700;margin-bottom:8px}
.eng-dict-compare{font-size:13px;line-height:1.8;background:#fff;padding:10px;border-radius:6px}
.cmp-correct{color:#2E7D32;background:#C8E6C9;padding:1px 3px;border-radius:3px}
.cmp-wrong{color:#C62828;background:#FFCDD2;padding:1px 3px;border-radius:3px;text-decoration:line-through}
.cmp-correct-ans{color:#1565C0;font-size:11px;margin-left:2px}
.cmp-missed{color:#999;background:#EEE;padding:1px 3px;border-radius:3px;text-decoration:underline}
.eng-word-dict-list{display:flex;flex-direction:column;gap:8px}
.eng-word-dict-item{display:flex;align-items:center;gap:10px;padding:8px 10px;background:#FAFAFA;border-radius:8px;border:1px solid var(--green-2)}
.eng-word-play{background:none;border:none;font-size:18px;cursor:pointer;padding:4px}
.eng-word-meaning{font-size:13px;color:#333;min-width:80px;font-weight:500}
.eng-word-input{flex:1;padding:6px 10px;border:1px solid var(--green-3);border-radius:6px;font-size:14px;outline:none}
.eng-word-input:focus{border-color:var(--green-5)}
.eng-word-dict-result{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:8px}
.eng-word-dict-result.correct{background:#E8F5E9}
.eng-word-dict-result.wrong{background:#FFEBEE}
.eng-word-user{font-size:13px;min-width:80px}
.eng-word-user.wrong{color:#C62828;text-decoration:line-through}
.eng-word-correct{font-size:13px;color:#2E7D32;font-weight:600;min-width:80px}
.eng-word-status{font-size:16px}

/* New English Reader (Screenshot-style UI) */
.eng-reader-new{background:#fff;border-radius:12px;padding:16px;margin-top:10px}
.eng-unit-list{margin-top:10px}
.eng-unit-list-title{font-size:14px;font-weight:600;color:var(--green-7);margin-bottom:10px;padding:8px 12px;background:var(--green-1);border-radius:8px;display:flex;align-items:center;gap:8px}
.eng-unit-list-title span.hint{font-size:11px;color:var(--text-l);font-weight:400;margin-left:auto}
.eng-unit-item{display:flex;align-items:center;gap:12px;padding:12px 16px;background:#E8F5E9;border:1px solid #C8E6C9;border-radius:10px;margin-bottom:8px;cursor:pointer;transition:all .2s}
.eng-unit-item:hover{background:#C8E6C9;border-color:#81C784;transform:translateX(2px)}
.eng-unit-item:active{transform:translateX(0)}
.eng-unit-num{width:32px;height:32px;border-radius:50%;background:#43A047;color:#fff;font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 1px 3px rgba(0,0,0,.1)}
.eng-unit-title{flex:1;font-size:14px;font-weight:600;color:#1B5E20}
.eng-unit-arrow{color:#43A047;font-size:16px;font-weight:700}
.eng-unit-badge{font-size:10px;background:#FFF3E0;color:#E65100;padding:2px 6px;border-radius:8px;font-weight:600;margin-left:8px}
.eng-back-btn{display:inline-flex;align-items:center;gap:6px;background:var(--green-1);color:var(--green-7);border:none;padding:6px 14px;border-radius:16px;font-size:13px;font-weight:600;cursor:pointer;margin-bottom:10px}
.eng-back-btn:hover{background:var(--green-2)}
.eng-page-nav{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.eng-page-pill{padding:6px 16px;border-radius:20px;border:1.5px solid #90CAF9;background:#fff;color:#1976D2;font-size:13px;font-weight:600;cursor:pointer;transition:all .2s}
.eng-page-pill:hover{background:#E3F2FD}
.eng-page-pill.active{background:#1976D2;color:#fff;border-color:#1976D2;box-shadow:0 2px 6px rgba(25,118,210,.3)}
.eng-top-controls{display:flex;align-items:center;justify-content:space-between;background:#fff;border:1.5px solid #E0E0E0;border-radius:24px;padding:6px 14px;margin-bottom:18px;box-shadow:0 1px 3px rgba(0,0,0,.04)}
.eng-timer-btn{background:none;border:none;font-size:15px;color:#1976D2;cursor:pointer;display:flex;align-items:center;gap:6px;font-weight:600;padding:4px 8px}
.eng-timer-btn.paused{color:#999}
.eng-speed-selector{display:flex;gap:0;background:#E3F2FD;border-radius:20px;padding:2px;border:1.5px solid #90CAF9}
.eng-speed-btn{padding:5px 12px;border-radius:18px;border:none;background:transparent;color:#1976D2;font-size:12px;font-weight:600;cursor:pointer;transition:all .2s}
.eng-speed-btn.active{background:#1976D2;color:#fff;box-shadow:0 1px 3px rgba(25,118,210,.3)}
.eng-forward-btn{background:none;border:none;font-size:18px;color:#1976D2;cursor:pointer;padding:4px 8px;font-weight:600}
.eng-forward-btn:hover{color:#0D47A1}
.eng-page-title{font-size:16px;font-weight:700;color:#333;margin-bottom:14px;padding-bottom:8px;border-bottom:1px dashed #E0E0E0}
.eng-page-title-tag{display:inline-block;font-size:11px;background:#E3F2FD;color:#1976D2;padding:2px 8px;border-radius:8px;margin-right:8px;font-weight:600}
.eng-sent-list{display:flex;flex-direction:column;gap:14px;margin-bottom:14px}
.eng-sent-pair{padding:8px 0;border-bottom:1px dashed #F0F0F0}
.eng-sent-pair:last-child{border-bottom:none}
.eng-sent-en{font-size:16px;color:#1976D2;cursor:pointer;font-weight:600;display:flex;align-items:center;gap:8px;line-height:1.5;padding:4px 0}
.eng-sent-en:hover{color:#0D47A1;text-decoration:underline}
.eng-sent-en.playing{background:#FFF9C4;color:#F57F17;border-radius:6px;padding:4px 6px}
.eng-sent-en .play-icon{font-size:12px;color:#1976D2}
.eng-sent-en.recording{background:#FFEBEE;color:#C62828;border-radius:6px;padding:4px 6px;animation:pulse 1s infinite}
.eng-sent-zh{font-size:14px;color:#757575;line-height:1.5;margin-top:2px;margin-left:24px;font-weight:400}
.eng-page-actions{display:flex;gap:8px;margin-top:14px;align-items:center;flex-wrap:wrap}
.eng-page-btn{padding:8px 16px;border-radius:18px;border:none;font-size:12px;font-weight:600;cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:6px}
.eng-page-btn.primary{background:#1976D2;color:#fff}
.eng-page-btn.primary:hover{background:#0D47A1}
.eng-page-btn.secondary{background:#E3F2FD;color:#1976D2}
.eng-page-btn.secondary:hover{background:#BBDEFB}
.eng-page-btn.danger{background:#FFEBEE;color:#C62828}
.eng-page-btn.record{background:#FFE0B2;color:#E65100}
.eng-page-btn.record.recording{background:#FFCDD2;color:#B71C1C;animation:pulse 1s infinite}
.eng-study-tip{font-size:11px;color:#999;margin-top:14px;padding:8px 12px;background:#F5F5F5;border-radius:6px;line-height:1.6}

/* English Reading Module */
.er-tabs{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap}
.er-tab{padding:8px 20px;border-radius:20px;border:2px solid var(--green-3);font-size:13px;font-weight:600;cursor:pointer;transition:all .2s;background:#fff;color:var(--green-7)}
.er-tab:hover{background:var(--green-1)}
.er-tab.active{background:var(--green-5);color:#fff;border-color:var(--green-5)}
.er-story-text{font-size:14px;line-height:2.2;color:#444;background:#F5F5F5;border-radius:8px;padding:14px;margin-bottom:12px}
.er-new-word-inline{background:#FFF9C4;border-bottom:2px dotted #FBC02D;cursor:pointer;border-radius:3px;padding:0 2px;position:relative}
.er-new-word-inline:hover{background:#FFF176}
.er-word-note{font-size:9px;color:#E65100;vertical-align:super;font-weight:700;margin-left:1px}
.er-audio-controls{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
.er-sentence-view{background:#E3F2FD;border-radius:8px;padding:12px;margin-bottom:12px}
.er-sent-current{font-size:14px;color:#1565C0;font-weight:600;margin-bottom:8px;line-height:1.6}
.er-sent-nav{display:flex;gap:8px;align-items:center;justify-content:center;flex-wrap:wrap}
.er-sent-btn{padding:4px 10px;border-radius:12px;border:none;font-size:11px;cursor:pointer;background:#fff;color:#1565C0;font-weight:600}
.er-sent-btn:hover{background:#BBDEFB}
.er-sent-btn.replay{background:#FFF3E0;color:#E65100}
.er-recording-indicator{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:#C62828;animation:pulse 1s infinite;padding:6px 10px;background:#FFEBEE;border-radius:8px}
.er-story-level{font-size:11px;padding:2px 8px;border-radius:8px;background:var(--green-1);color:var(--green-7);font-weight:600}
.er-vocab-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px}
.er-vocab-card{background:#fff;border:1px solid var(--green-2);border-radius:8px;padding:10px;transition:all .2s}
.er-vocab-card:hover{box-shadow:0 2px 8px rgba(0,0,0,.08)}
.er-vocab-card.learned{background:var(--green-1);border-color:var(--green-4)}
.er-vocab-word{font-size:15px;font-weight:700;color:#333;margin-bottom:2px}
.er-vocab-phonetic{font-size:11px;color:var(--text-l);margin-bottom:4px}
.er-vocab-meaning{font-size:12px;color:var(--green-7);font-weight:600;margin-bottom:4px}
.er-vocab-example{font-size:11px;color:#666;font-style:italic;margin-bottom:6px;line-height:1.4}
.er-vocab-actions{display:flex;gap:4px;flex-wrap:wrap}
.er-vocab-btn{padding:3px 8px;border-radius:10px;border:none;font-size:10px;cursor:pointer;background:var(--green-1);color:var(--green-7);font-weight:600;transition:all .15s}
.er-vocab-btn:hover{background:var(--green-2)}
.er-vocab-btn.recording{background:#FFEBEE;color:#C62828;animation:pulse 1s infinite}
.er-exercise{margin-top:14px}
.er-exercise-item{margin-bottom:10px}
.er-exercise-q{font-size:13px;font-weight:600;color:#333;margin-bottom:4px;padding:8px;background:#FAFAFA;border-radius:6px;line-height:1.5}
.er-exercise-a{font-size:12px;color:var(--green-7);padding:8px 12px;background:var(--green-1);border-radius:6px;margin-top:4px;line-height:1.5}
.er-toggle-btn{font-size:11px;padding:3px 10px;border-radius:8px;border:none;background:var(--blue-1);color:var(--blue-7);cursor:pointer;font-weight:600;margin:4px 0}
.er-toggle-btn:hover{background:var(--blue-2)}
.er-pattern-card{background:#E8F5E9;border-radius:8px;padding:10px;margin-bottom:10px}
.er-pattern-formula{font-size:13px;font-weight:700;color:#2E7D32;margin-bottom:4px}
.er-pattern-example{font-size:12px;color:#555;margin-bottom:6px;font-style:italic}
.er-pattern-input{width:100%;min-height:60px;padding:8px;border:2px solid var(--green-3);border-radius:6px;font-size:13px;outline:none;margin-bottom:6px;resize:vertical;font-family:inherit;box-sizing:border-box}
.er-pattern-input:focus{border-color:var(--green-5)}
.er-pattern-ref{font-size:12px;color:#555;padding:8px;background:#FFF9C4;border-radius:6px;margin-top:6px;line-height:1.6}
.er-voice-btn{padding:4px 10px;border-radius:10px;border:none;font-size:11px;cursor:pointer;background:#FFF3E0;color:#E65100;font-weight:600}
.er-voice-btn:hover{background:#FFE0B2}
.er-voice-btn.listening{background:#FFEBEE;color:#C62828;animation:pulse 1s infinite}
.er-progress-bar{height:8px;background:#E0E0E0;border-radius:4px;margin:10px 0;overflow:hidden}
.er-progress-fill{height:100%;background:var(--green-5);border-radius:4px;transition:width .3s}
.er-new-word{display:inline-block;padding:2px 8px;background:#FFF9C4;border-radius:12px;font-size:12px;cursor:pointer;margin:2px;border:1px solid #FBC02D}
.er-new-word sup{font-size:9px;color:#E65100;font-weight:700;margin-left:2px}


/* Reading module */
.rd-legend{display:flex;gap:12px;margin-bottom:8px;font-size:11px;color:var(--text-l)}
.rd-legend-item{display:flex;align-items:center;gap:4px}
.rd-legend-dot{width:10px;height:10px;border-radius:3px;display:inline-block}
.rd-legend-dot.word{background:#FFF9C4;border:1px solid #FBC02D}
.rd-legend-dot.sent{background:#E3F2FD;border:1px solid #1976D2}
.rd-legend-dot.core{background:#FFEBEE;border:1px solid #C62828}
.rd-passage-card{background:#FFFEF7;border-radius:10px;padding:16px;border:1px solid #FBC02D33;margin-bottom:12px}
.rd-passage-title{font-size:16px;font-weight:700;color:#333;margin-bottom:10px;text-align:center}
.rd-passage-text{font-size:14px;line-height:2;color:#333;text-indent:2em}
.rd-highlight-word{background:#FFF9C4;border-bottom:2px solid #FBC02D;padding:0 2px;border-radius:2px}
.rd-highlight-sent{background:#E3F2FD;border-left:3px solid #1976D2;padding-left:4px;border-radius:2px}
.rd-highlight-core{background:#FFEBEE;border-left:3px solid #C62828;padding-left:4px;border-radius:2px;font-weight:500}
.rd-section{margin-top:12px}
.rd-sec-title{font-size:13px;font-weight:700;color:var(--green-7);margin-bottom:6px}
.rd-good-words{display:flex;flex-wrap:wrap;gap:6px}
.rd-word-chip{background:#FFF9C4;border:1px solid #FBC02D;color:#F57F17;padding:3px 10px;border-radius:12px;font-size:12px;font-weight:500}
.rd-good-sents{display:flex;flex-direction:column;gap:6px}
.rd-sent-item{background:#E3F2FD;border-left:3px solid #1976D2;padding:8px 12px;border-radius:6px;font-size:13px;color:#1565C0;line-height:1.6}
.rd-annot{background:#F5F5F5;border-radius:8px;padding:10px;font-size:12px;color:#555;line-height:1.6}
.rd-reflection-input{width:100%;min-height:100px;padding:10px;border:2px solid var(--green-3);border-radius:8px;font-size:13px;line-height:1.6;resize:vertical;font-family:inherit;outline:none;margin-top:6px}
.rd-reflection-input:focus{border-color:var(--green-5)}
.rd-reflection-tip{font-size:11px;color:var(--text-l);margin-top:6px}
.rd-ref-toggle{font-size:12px;color:var(--green-6);cursor:pointer;font-weight:600;padding:8px 0;margin-top:4px}
.rd-ref-toggle:hover{text-decoration:underline}
.rd-ref-content{background:#FFF3E0;border-radius:8px;padding:12px;font-size:13px;color:#E65100;line-height:1.7;border:1px solid #FFB74D}
.rd-nav{display:flex;gap:8px;justify-content:center;margin-top:12px}
.oly-prog{display:flex;gap:4px;margin-bottom:8px;flex-wrap:wrap}
.oly-prog-dot{width:8px;height:8px;border-radius:50%;background:#E0E0E0}
.oly-prog-dot.done{background:var(--green-6)}
.oly-prog-dot.current{background:#FF9800;transform:scale(1.3)}

/* Calligraphy lessons */
.cal-list{display:flex;flex-direction:column;gap:8px}
.cal-card{background:#FAFAFA;border-radius:10px;padding:12px;border:1px solid var(--green-2)}
.cal-day{font-size:12px;font-weight:700;color:var(--green-6);margin-bottom:4px}
.cal-topic{font-size:14px;font-weight:600;color:var(--text-d);margin-bottom:8px}
.cal-chars{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
.cal-char{width:36px;height:36px;display:flex;align-items:center;justify-content:center;background:#fff;border:2px solid var(--green-3);border-radius:8px;font-size:20px;font-family:"STKaiti","KaiTi",serif;color:var(--text-d)}
.cal-tip{font-size:11px;color:var(--orange);background:#FFF3E0;padding:6px 10px;border-radius:6px;border-left:3px solid var(--orange)}

/* ===== Responsive ===== */
@media(max-width:768px){
  :root{--sidebar-w:230px}
  #sidebar{position:fixed;top:0;left:0;bottom:0;transform:translateX(-100%)}
  #sidebar.show{transform:translateX(0)}
  #sidebar-overlay.show{display:block}
  #topbar .hamburger{display:flex;align-items:center}
  #topbar .date-display{min-width:90px;font-size:13px}
  #topbar .points-pill{font-size:12px;padding:5px 10px}
  #topbar .pet-pill{display:none}
  #content{padding:12px}
  .module-header .m-title{font-size:18px}
  .task-card{padding:14px}
  .stat-box{min-width:100px;padding:12px}
  .stat-box .s-value{font-size:18px}
  .pet-display{font-size:64px}
  .pet-info-grid{grid-template-columns:1fr 1fr 1fr}
  .exchange-grid{grid-template-columns:1fr}
  .game-grid{grid-template-columns:repeat(2,1fr)}
  .vocab-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:380px){
  .stat-row{gap:8px}
  .stat-box{min-width:90px;padding:10px}
  .stat-box .s-value{font-size:16px}
}

/* ===== 权限系统 ===== */
#loginScreen{position:fixed;inset:0;z-index:9999;background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);display:flex;align-items:center;justify-content:center;padding:20px}
.login-card{background:#fff;border-radius:20px;padding:36px 28px;max-width:360px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,.3);text-align:center}
.login-card .lc-logo{font-size:48px;margin-bottom:8px}
.login-card .lc-title{font-size:22px;font-weight:700;color:#333;margin-bottom:4px}
.login-card .lc-sub{font-size:13px;color:#999;margin-bottom:24px}
.login-card .lc-input{width:100%;padding:14px 16px;border:2px solid #e0e0e0;border-radius:12px;font-size:16px;text-align:center;letter-spacing:2px;box-sizing:border-box;margin-bottom:16px;transition:border-color .2s}
.login-card .lc-input:focus{outline:none;border-color:#764ba2}
.login-card .lc-btn{width:100%;padding:14px;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:12px;font-size:16px;font-weight:600;cursor:pointer;transition:opacity .2s}
.login-card .lc-btn:active{opacity:.8}
.login-card .lc-tip{font-size:12px;color:#bbb;margin-top:14px;line-height:1.6}
.login-card .lc-admin{margin-top:18px;font-size:13px;color:#fff;cursor:pointer;padding:8px 20px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);border-radius:8px;display:inline-block;user-select:none;-webkit-tap-highlight-color:transparent;transition:background .2s}
.login-card .lc-admin:active{background:rgba(255,255,255,.3)}

/* 付费弹窗 */
#permPayModal{position:fixed;inset:0;z-index:9998;background:rgba(0,0,0,.55);display:none;align-items:center;justify-content:center;padding:20px}
#permPayModal.show{display:flex}
/* 用户前端充值弹窗 */
#userRechargeModal{position:fixed;inset:0;z-index:9998;background:rgba(0,0,0,.55);display:none;align-items:center;justify-content:center;padding:20px}
#userRechargeModal.show{display:flex}
.pay-card{background:#fff;border-radius:20px;padding:28px 24px;max-width:340px;width:100%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.3)}
.pay-card .pc-price{font-size:36px;font-weight:800;color:#e74c3c;margin-bottom:4px}
.pay-card .pc-price small{font-size:16px;font-weight:400;color:#999}
.pay-card .pc-qr{width:200px;height:200px;margin:16px auto;border:2px dashed #e0e0e0;border-radius:12px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#fafafa}
.pay-card .pc-qr img{width:100%;height:100%;object-fit:cover}
.pay-card .pc-qr-empty{color:#ccc;font-size:13px;text-align:center;padding:20px}
.pay-card .pc-notice{background:#FFF8E1;border-radius:10px;padding:12px 14px;font-size:12px;color:#E65100;line-height:1.7;text-align:left;margin:12px 0}
.pay-card .pc-btn{width:100%;padding:12px;background:#e74c3c;color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:600;cursor:pointer;margin-top:8px}
.pay-card .pc-close{width:100%;padding:10px;background:#f5f5f5;color:#999;border:none;border-radius:10px;font-size:14px;cursor:pointer;margin-top:8px}
.pay-card .pc-msg{font-size:15px;color:#333;margin-bottom:8px;font-weight:600}

/* 管理员登录弹窗 */
#adminLoginModal{position:fixed;top:0;left:0;right:0;bottom:0;width:100vw;height:100vh;z-index:10001;background:rgba(0,0,0,.55);display:none;align-items:center;justify-content:center;padding:20px;box-sizing:border-box}
.admin-login-box{background:#fff;border-radius:16px;padding:28px 24px 20px;width:300px;max-width:90vw;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,.2);box-sizing:border-box}
.admin-login-box .alm-icon{font-size:40px;margin-bottom:8px}
.admin-login-box .alm-title{font-size:18px;font-weight:700;color:#2c3e50;margin-bottom:6px}
.admin-login-box .alm-label{font-size:14px;color:#666;margin-bottom:14px}
.admin-login-box .alm-input{width:100%;padding:12px 14px;border:2px solid #e0e0e0;border-radius:10px;font-size:16px;text-align:center;outline:none;transition:border-color .2s;box-sizing:border-box}
.admin-login-box .alm-input:focus{border-color:#667eea}
.admin-login-box .alm-btns{display:flex;gap:10px;margin-top:14px}
.admin-login-box .alm-confirm-btn{flex:1;padding:12px;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:600;cursor:pointer}
.admin-login-box .alm-confirm-btn:active{transform:scale(.98)}
.admin-login-box .alm-cancel-btn{flex:1;padding:12px;background:#f5f5f5;color:#666;border:none;border-radius:10px;font-size:15px;cursor:pointer}

/* 管理员后台 */
#adminPanel{position:fixed;top:0;left:0;right:0;bottom:0;z-index:10002;background:#f0f2f5;display:none;flex-direction:column}
.admin-header{background:linear-gradient(135deg,#2c3e50,#34495e);color:#fff;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.admin-header .ah-title{font-size:18px;font-weight:700}
.admin-header .ah-btns{display:flex;gap:8px}
.admin-header .ah-btns button{padding:6px 14px;border:none;border-radius:8px;font-size:13px;cursor:pointer;background:rgba(255,255,255,.15);color:#fff}
.admin-body{flex:1;overflow-y:auto;padding:16px;max-width:900px;margin:0 auto;width:100%}
.admin-tabs{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap}
.admin-tab{padding:8px 18px;border-radius:10px;font-size:14px;cursor:pointer;background:#fff;color:#666;border:2px solid transparent}
.admin-tab.active{background:#667eea;color:#fff}
.admin-table{width:100%;border-collapse:collapse;background:#fff;border-radius:12px;overflow:hidden;font-size:13px}
.admin-table th{background:#f5f5f5;padding:10px 8px;text-align:left;font-weight:600;color:#666;white-space:nowrap}
.admin-table td{padding:10px 8px;border-top:1px solid #f0f0f0;color:#333;vertical-align:top}
.admin-table tr:hover{background:#fafafa}
.st-badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600}
.st-trial{background:#E3F2FD;color:#1976D2}
.st-paid{background:#E8F5E9;color:#2E7D32}
.st-unpaid{background:#FFF3E0;color:#E65100}
.st-banned{background:#FFEBEE;color:#C62828}
.admin-action-btn{padding:4px 10px;border:none;border-radius:6px;font-size:12px;cursor:pointer;margin:2px}
.admin-qr-upload{border:2px dashed #ccc;border-radius:12px;padding:20px;text-align:center;margin-bottom:16px;background:#fff}
.admin-qr-preview{max-width:200px;margin:10px auto;border-radius:8px;overflow:hidden}
.admin-qr-preview img{width:100%}
.admin-stat-row{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px}
.admin-stat-box{background:#fff;border-radius:12px;padding:16px 20px;flex:1;min-width:140px;text-align:center}
.admin-stat-box .as-num{font-size:28px;font-weight:700}
.admin-stat-box .as-label{font-size:12px;color:#999;margin-top:4px}

/* 会员状态条 */
#permStatusBar{position:fixed;top:0;left:0;right:0;z-index:9990;background:rgba(0,0,0,.7);color:#fff;font-size:12px;padding:4px 12px;display:none;align-items:center;justify-content:space-between}
#permStatusBar.show{display:flex}
#permStatusBar .ps-info{display:flex;align-items:center;gap:8px}
#permStatusBar .ps-logout{color:#ff9800;cursor:pointer;text-decoration:underline}
</style>
</head>
<body>
<div id="app">
  <!-- ===== Sidebar ===== -->
  <aside id="sidebar">
    <div class="logo">
      <div class="avatar">📚</div>
      <div class="title-wrap">
        <div class="title" id="workbenchTitle">四年级工作台</div>
        <button class="title-edit-btn" onclick="renameWorkbench()" title="点击修改名称">✏️</button>
      </div>
      <div class="sub" id="workbenchSub">四年级 · 专属定制</div>
    </div>
    <nav id="nav"></nav>
    <div class="sidebar-footer" id="sidebarFooter">
      <!-- 动态渲染，由 renderSidebar() 根据身份控制 -->
    </div>
  </aside>
  <div id="sidebar-overlay" onclick="toggleSidebar()"></div>

  <!-- ===== Main ===== -->
  <div id="main">
    <div id="topbar">
      <button class="hamburger" onclick="toggleSidebar()">☰</button>
      <div class="date-nav">
        <button onclick="changeDate(-1)">‹</button>
        <div class="date-display" id="dateDisplay"></div>
        <button onclick="changeDate(1)">›</button>
      </div>
      <button class="pet-pill" id="petPill" onclick="navTo('pet')"></button>
      <div class="spacer"></div>
      <div class="points-pill" id="pointsPill">⭐ 0</div>
    </div>
    <div id="content"></div>
  </div>
</div>

<!-- ===== Modal ===== -->
<div class="modal-overlay" id="modalOverlay" onclick="if(event.target===this)closeModal()">
  <div class="modal" id="modalBox"></div>
</div>

<!-- ===== Toast ===== -->
<div id="toast"></div>

<!-- ===== 会员状态条 ===== -->
<div id="permStatusBar">
  <div class="ps-info" id="permStatusInfo"></div>
  <div class="ps-logout" onclick="permLogout()">退出登录</div>
</div>

<!-- ===== 登录界面 ===== -->
<div id="loginScreen" style="display:none">
  <div class="login-card">
    <div class="lc-logo">📚</div>
    <div class="lc-title">四年级工作台</div>
    <div class="lc-sub">请输入手机号登录</div>
    <input class="lc-input" id="loginPhone" type="tel" maxlength="11" placeholder="请输入11位手机号" oninput="this.value=this.value.replace(/[^0-9]/g,'')">
    <button class="lc-btn" onclick="permDoLogin()">登 录</button>
    <div class="lc-tip">🔒 强制手机号登录，禁止匿名访问<br>新用户自动获得3天免费体验</div>
    <div class="lc-admin" onclick="showAdminLogin()">管理员入口</div>
  </div>
</div>

<!-- ===== 付费弹窗 ===== -->
<div id="permPayModal">
  <div class="pay-card">
    <div class="pc-msg" id="payModalMsg">⏰ 3天免费体验已结束，开通永久授权解锁全部学习功能</div>
    <div class="pc-price">&yen;49.9<small> / 永久授权</small></div>
    <div class="pc-qr" id="payQRContainer">
      <div class="pc-qr-empty">管理员尚未上传<br>收款二维码</div>
    </div>
    <div class="pc-notice">
      ⚠️ 49.9元为单手机号永久授权，权限不可转让<br>
      ⚠️ 最多2台设备登录，禁止账号共享<br>
      ⚠️ 账号共享、转租会被封禁<br>
      转账后请联系管理员手动开通权限
    </div>
    <button class="pc-btn" onclick="closePayModal()">我已转账，等待开通</button>
    <button class="pc-close" onclick="permLogout()">退出登录</button>
  </div>
</div>

<!-- ===== 用户前端充值弹窗（仅展示收款信息，不能开通权限） ===== -->
<div id="userRechargeModal">
  <div class="pay-card">
    <div style="font-size:18px;font-weight:700;color:#2c3e50;text-align:center;margin-bottom:4px">💳 会员充值</div>
    <div class="pc-price">&yen;49.9<small> / 永久授权</small></div>
    <div class="pc-qr" id="userRechargeQR">
      <div class="pc-qr-empty">管理员尚未上传<br>收款二维码</div>
    </div>
    <button onclick="refreshUserQR()" style="display:block;margin:0 auto 12px;padding:4px 12px;font-size:12px;color:#667eea;border:1px solid #667eea;border-radius:6px;background:transparent;cursor:pointer">🔄 刷新二维码</button>
    <div class="pc-notice">
      ⚠️ 49.9元为单手机号永久授权，权限不可转让<br>
      ⚠️ 最多2台设备登录，禁止账号共享<br>
      ⚠️ 账号共享、转租会被封禁<br>
      <strong style="color:#e74c3c">转账后请联系管理员手动开通权限</strong>
    </div>
    <button class="pc-btn" onclick="closeUserRecharge()">我已了解，关闭</button>
  </div>
</div>

<!-- ===== 管理员登录弹窗 ===== -->
<div id="adminLoginModal" style="display:none">
  <div class="admin-login-box">
    <div class="alm-icon">🔧</div>
    <div class="alm-title">管理员登录</div>
    <div class="alm-label">请输入管理员密码</div>
    <input type="password" id="adminPwdInput" class="alm-input" placeholder="管理员密码" autocomplete="off"
      onkeydown="if(event.key==='Enter') adminDoLogin()">
    <div class="alm-btns">
      <button class="alm-cancel-btn" onclick="hideAdminLogin()">取消</button>
      <button class="alm-confirm-btn" onclick="adminDoLogin()">确认</button>
    </div>
  </div>
</div>

<!-- ===== 管理员后台 ===== -->
<div id="adminPanel">
  <div class="admin-header">
    <div class="ah-title">🔧 管理员后台 · 会员权限管理</div>
    <div class="ah-btns">
      <button onclick="exportSourceCode()" style="background:#667eea;color:#fff">💻 导出源代码</button>
      <button onclick="adminEnterWorkbench()" style="background:#27ae60;color:#fff;font-weight:600">📖 进入工作台</button>
      <button onclick="adminCloseBackend()">关闭后台</button>
    </div>
  </div>
  <div class="admin-body" id="adminBody"></div>
</div>

<script>
// ============================================================
//  数据层 - localStorage 持久化
// ============================================================
const STORE_KEY = 'wenwen_summer_2026';
const todayStr = () => new Date().toISOString().slice(0,10);

function defaultData(){
  return {
    dailyRecords:{},
    points:{ total:0, history:[] },
    pet:{ name:'小黄', fullness:0, feedHistory:[], createdDate:todayStr() },
    errorLedger:[],
    customTasks:{ chinese:[], math:[], english:[], eng_reading:[], sports:[], reading:[], handwriting:[], science:[], housework:[] },
    recitationProgress:{},
    settings:{ childName:'文文', workbenchName:'四年级工作台', workbenchSub:'四年级 · 专属定制' }
  };
}
let D = defaultData();
function loadData(){
  try{ const s = localStorage.getItem(STORE_KEY); if(s){ D = Object.assign(defaultData(), JSON.parse(s)); } }catch(e){}
  // 迁移：强制更新工作台名称（旧数据可能保存了过期名称）
  if(D.settings){
    D.settings.workbenchName = '四年级工作台';
    D.settings.workbenchSub  = '四年级 · 专属定制';
  }
  if(!D.dailyRecords[todayStr()]) D.dailyRecords[todayStr()] = {};
}
function saveData(){ localStorage.setItem(STORE_KEY, JSON.stringify(D)); }

// ============================================================
//  权限系统 - 会员管理 / 设备记录 / 鉴权
// ============================================================
const PERM_KEY = 'wenwen_perm_2026';
const TRIAL_DAYS = 3;
const MAX_DEVICES = 2;       // 付费用户最多2台设备
const RISK_DEVICE_LIMIT = 3; // 同时登录3台设备触发拦截
const RISK_BAN_DAYS = 7;     // 7天内3台独立设备触发封禁

function defaultPerm(){
  return {
    members: [],      // {phone, status, orderId, purchaseTime, trialStartTime, note, bannedReason, bannedTime}
    devices: [],      // {phone, deviceId, firstLoginTime, lastLoginTime}
    payQRCode: 'data:image/jpeg;base64,',    // base64 默认收款二维码（用户上传后会被覆盖）
    adminPwd: 'admin2026',
    currentUser: null // {phone, deviceId, loginTime}
  };
}
let PERM = defaultPerm();

function loadPerm(){
  try{
    const s = localStorage.getItem(PERM_KEY);
    if(s){ PERM = Object.assign(defaultPerm(), JSON.parse(s)); }
    // 如果已加载的PERM中没有收款二维码（兼容老用户），用默认值填充
    if(!PERM.payQRCode){
      const def = defaultPerm();
      PERM.payQRCode = def.payQRCode;
    }
  }catch(e){}
}
function savePerm(){ localStorage.setItem(PERM_KEY, JSON.stringify(PERM)); }

// 设备标识：localStorage持久化的UUID + 浏览器指纹
function getDeviceId(){
  let id = localStorage.getItem('wenwen_device_id');
  if(!id){
    const ua = navigator.userAgent;
    const screen = window.screen.width + 'x' + window.screen.height;
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
    const lang = navigator.language || '';
    const raw = ua + '|' + screen + '|' + tz + '|' + lang + '|' + Date.now() + '|' + Math.random();
    let hash = 0;
    for(let i=0;i<raw.length;i++){ hash = ((hash<<5)-hash) + raw.charCodeAt(i); hash |= 0; }
    id = 'dev_' + Math.abs(hash).toString(36) + '_' + Date.now().toString(36);
    localStorage.setItem('wenwen_device_id', id);
  }
  return id;
}

// 查找会员
function findMember(phone){ return PERM.members.find(m=>m.phone===phone); }

// 计算体验剩余天数
function permTrialDaysLeft(member){
  if(!member || !member.trialStartTime) return 0;
  const elapsed = Math.floor((Date.now() - member.trialStartTime) / (24*60*60*1000));
  return Math.max(0, TRIAL_DAYS - elapsed);
}

// 获取某手机号的所有设备
function getDevicesByPhone(phone){
  return PERM.devices.filter(d=>d.phone===phone);
}

// 获取某手机号7天内的独立设备数
function getRecentDeviceCount(phone){
  const now = Date.now();
  const week = 7 * 24 * 60 * 60 * 1000;
  const recents = PERM.devices.filter(d=>d.phone===phone && (now - d.lastLoginTime) < week);
  return recents.length;
}

// 自动化检查：体验到期、风控
function permAutoCheck(){
  let changed = false;
  const now = Date.now();
  const trialMs = TRIAL_DAYS * 24 * 60 * 60 * 1000;
  // 1. 体验超3天 → 未付费
  PERM.members.forEach(m=>{
    if(m.status==='trial' && m.trialStartTime && (now - m.trialStartTime) >= trialMs){
      m.status = 'unpaid';
      changed = true;
    }
  });
  // 2. 7天内≥3台独立设备 → 风险封禁
  PERM.members.forEach(m=>{
    if(m.status!=='banned' && m.status!=='paid'){
      const cnt = getRecentDeviceCount(m.phone);
      if(cnt >= RISK_DEVICE_LIMIT){
        m.status = 'banned';
        m.bannedReason = '7天内登录设备数≥' + RISK_DEVICE_LIMIT + '台，系统自动封禁';
        m.bannedTime = now;
        changed = true;
      }
    }
  });
  if(changed) savePerm();
}

// 鉴权检查：返回 'ok' | 'unpaid' | 'banned' | 'nologin'
function checkAuth(){
  if(!PERM.currentUser) return 'nologin';
  const m = findMember(PERM.currentUser.phone);
  if(!m) return 'nologin';
  permAutoCheck();
  const m2 = findMember(PERM.currentUser.phone);
  if(m2.status === 'banned') return 'banned';
  if(m2.status === 'unpaid') return 'unpaid';
  return 'ok';
}

// 显示登录界面
function showLoginScreen(){
  document.getElementById('loginScreen').style.display = 'flex';
  document.getElementById('app').style.filter = 'blur(4px)';
  document.getElementById('app').style.pointerEvents = 'none';
}
function hideLoginScreen(){
  document.getElementById('loginScreen').style.display = 'none';
  document.getElementById('app').style.filter = '';
  document.getElementById('app').style.pointerEvents = '';
}

// 显示付费弹窗
function showPayModal(msg){
  // 每次打开弹窗前重新从localStorage读取最新PERM数据
  loadPerm();
  const el = document.getElementById('permPayModal');
  el.classList.add('show');
  if(msg) document.getElementById('payModalMsg').textContent = msg;
  // 渲染二维码
  renderPayQRCode('payQRContainer');
}
function closePayModal(){
  document.getElementById('permPayModal').classList.remove('show');
  // 关闭弹窗后重新鉴权——未付费用户看到等待开通页面，不能访问学习功能
  renderModule();
}

// 公共函数：渲染收款二维码到指定容器
function renderPayQRCode(containerId){
  var container = document.getElementById(containerId);
  if(!container) return;
  if(PERM.payQRCode){
    container.innerHTML = '<img src="' + PERM.payQRCode + '" alt="收款二维码" style="max-width:100%;max-height:220px;border-radius:8px">';
  } else {
    container.innerHTML = '<div class="pc-qr-empty">管理员尚未上传<br>收款二维码</div>';
  }
}

// ===== 用户前端充值弹窗（仅展示收款信息，不能开通权限） =====
function showUserRecharge(){
  // 每次打开弹窗前重新从localStorage读取最新PERM数据
  loadPerm();
  var el = document.getElementById('userRechargeModal');
  if(!el){ console.error('userRechargeModal not found'); return; }
  el.style.display = 'flex';
  el.style.visibility = 'visible';
  el.style.opacity = '1';
  // 渲染二维码
  renderPayQRCode('userRechargeQR');
}
function closeUserRecharge(){
  var el = document.getElementById('userRechargeModal');
  if(!el) return;
  el.style.display = 'none';
}
// 手动刷新用户充值弹窗中的二维码
function refreshUserQR(){
  loadPerm();
  renderPayQRCode('userRechargeQR');
  toast('✅ 已刷新为最新二维码');
}

// 更新会员状态条
function updatePermStatusBar(){
  const bar = document.getElementById('permStatusBar');
  const info = document.getElementById('permStatusInfo');
  if(!PERM.currentUser){
    bar.classList.remove('show');
    return;
  }
  const m = findMember(PERM.currentUser.phone);
  if(!m){ bar.classList.remove('show'); return; }
  bar.classList.add('show');
  const statusMap = {
    trial: {text:'体验中', cls:'st-trial'},
    paid: {text:'已付费', cls:'st-paid'},
    unpaid: {text:'未付费', cls:'st-unpaid'},
    banned: {text:'已封禁', cls:'st-banned'}
  };
  const st = statusMap[m.status] || statusMap.unpaid;
  let extra = '';
  if(m.status === 'trial'){
    const left = permTrialDaysLeft(m);
    extra = ' (剩余' + left + '天)';
  }
  info.innerHTML = (PERM.currentUser.isAdmin ? '🔧 管理员' : '📱 ' + m.phone.slice(0,3) + '****' + m.phone.slice(7)) + ' <span class="st-badge ' + st.cls + '">' + st.text + extra + '</span>';
}

// 执行登录
function permDoLogin(){
  const phone = document.getElementById('loginPhone').value.trim();
  if(!/^1[3-9]\d{9}$/.test(phone)){ toast('请输入正确的11位手机号', 'red'); return; }

  const deviceId = getDeviceId();
  const now = Date.now();

  // 查找会员
  let m = findMember(phone);

  // 新用户：创建体验中
  let isNewUser = false;
  if(!m){
    m = { phone, status:'trial', orderId:'', purchaseTime:'', trialStartTime:now, note:'', bannedReason:'', bannedTime:0 };
    PERM.members.push(m);
    isNewUser = true;
  }

  // 检查封禁
  if(m.status === 'banned'){
    toast('⚠️ 账号受限：' + (m.bannedReason || '账号已被封禁'), 'red');
    return;
  }

  // 检查体验到期——到期账号直接拦截，弹出充值弹窗引导联系管理员
  if(m.status === 'unpaid'){
    // 设置当前用户但不真正登录工作台，仅用于显示充值弹窗
    PERM.currentUser = { phone, deviceId, loginTime:now };
    savePerm();
    hideLoginScreen();
    updatePermStatusBar();
    // 直接弹出充值弹窗
    showPayModal('⏰ 3天免费体验已结束，转账 ¥49.9 开通永久授权解锁全部学习功能');
    return;
  }

  // 设备检查（仅对体验中/未付费检查3台拦截；付费用户检查2台上限）
  const userDevices = getDevicesByPhone(phone);
  const thisDevice = userDevices.find(d=>d.deviceId===deviceId);

  if(!thisDevice){
    // 新设备登录
    if(userDevices.length >= RISK_DEVICE_LIMIT){
      toast('⚠️ 登录设备数量超限（≥' + RISK_DEVICE_LIMIT + '台），已拦截登录', 'red');
      return;
    }
    // 付费用户设备上限2台
    if(m.status === 'paid' && userDevices.length >= MAX_DEVICES){
      toast('⚠️ 已达设备上限（' + MAX_DEVICES + '台），如需更换设备请联系管理员', 'red');
      return;
    }
    // 添加新设备
    PERM.devices.push({ phone, deviceId, firstLoginTime:now, lastLoginTime:now });
  } else {
    thisDevice.lastLoginTime = now;
  }

  // 7天风控检查
  permAutoCheck();
  const m2 = findMember(phone);
  if(m2.status === 'banned'){
    toast('⚠️ 账号因异常登录行为已被封禁', 'red');
    savePerm();
    return;
  }

  // 设置当前用户
  PERM.currentUser = { phone, deviceId, loginTime:now };
  savePerm();
  hideLoginScreen();
  updatePermStatusBar();

  // 根据状态处理
  if(isNewUser){
    toast('🎉 您已领取 3 天完整功能免费体验，体验结束后可开通永久权限', 'orange');
  }

  // init() 会根据状态自动显示付费弹窗或等待页面
  init();
}

// 退出登录
function permLogout(){
  PERM.currentUser = null;
  savePerm();
  closePayModal();
  hideAdminPanel();
  document.getElementById('loginPhone').value = '';
  showLoginScreen();
  updatePermStatusBar();
  toast('已退出登录');
}

// ===== 管理员后台 =====
let adminTab = 'members';

function showAdminLogin(){
  var modal = document.getElementById('adminLoginModal');
  if(!modal){ return; }
  modal.style.display = 'flex';
  var input = document.getElementById('adminPwdInput');
  if(input){
    input.value = '';
    setTimeout(function(){ try{ input.focus({preventScroll:true}); }catch(e){ input.focus(); } }, 350);
  }
}

function hideAdminLogin(){
  var modal = document.getElementById('adminLoginModal');
  if(!modal) return;
  modal.style.display = 'none';
}

function adminDoLogin(){
  const input = document.getElementById('adminPwdInput');
  const pwd = input ? input.value.trim() : '';
  if(!pwd){
    toast('请输入管理员密码', 'orange');
    return;
  }
  if(pwd === PERM.adminPwd){
    hideAdminLogin();
    showAdminPanel();
  } else {
    toast('密码不正确，请重新输入', 'red');
    if(input){ input.value = ''; input.focus(); }
  }
}

function showAdminPanel(){
  var panel = document.getElementById('adminPanel');
  panel.style.display = 'flex';
  renderAdminPanel();
}
function hideAdminPanel(){
  document.getElementById('adminPanel').style.display = 'none';
}

// 管理员进入工作台：以管理员身份免登跳转，享有完整权限
function adminEnterWorkbench(){
  // 设置管理员身份（等同于已付费账号权限）
  PERM.currentUser = {
    phone: 'admin',
    deviceId: 'admin_device',
    loginTime: Date.now(),
    isAdmin: true
  };
  // 确保管理员账号在 members 中且状态为 paid
  var adminMember = findMember('admin');
  if(!adminMember){
    PERM.members.push({
      phone: 'admin',
      status: 'paid',
      orderId: 'ADMIN',
      purchaseTime: Date.now(),
      trialStartTime: Date.now(),
      note: '管理员账号'
    });
  } else {
    adminMember.status = 'paid';
  }
  savePerm();
  // 隐藏管理员后台
  hideAdminPanel();
  // 隐藏登录界面，恢复app交互
  hideLoginScreen();
  // 初始化工作台UI
  updatePermStatusBar();
  applyWorkbenchName();
  var subEl = document.getElementById('workbenchSub');
  if(subEl && D.settings && D.settings.workbenchSub) subEl.textContent = D.settings.workbenchSub;
  renderSidebar();
  updateTopBar();
  // 直接渲染学习模块
  renderModule();
  toast('✅ 管理员已进入工作台，享有完整权限');
}

// 关闭后台：管理员身份→回到登录界面；普通用户→回到工作台
function adminCloseBackend(){
  hideAdminPanel();
  if(PERM.currentUser && PERM.currentUser.isAdmin){
    // 管理员身份：清除登录状态，回到登录界面
    PERM.currentUser = null;
    savePerm();
    showLoginScreen();
    updatePermStatusBar();
  }
  // 普通用户：只需隐藏后台面板，自动回到工作台
}

function renderAdminPanel(){
  // 每次渲染前自动执行自动化检查（体验到期、风控），确保统计数据实时最新
  permAutoCheck();
  savePerm();

  const body = document.getElementById('adminBody');
  const totalMembers = PERM.members.length;
  const paidCount = PERM.members.filter(m=>m.status==='paid').length;
  const trialCount = PERM.members.filter(m=>m.status==='trial').length;
  const bannedCount = PERM.members.filter(m=>m.status==='banned').length;
  const unpaidCount = PERM.members.filter(m=>m.status==='unpaid').length;
  const totalDevices = PERM.devices.length;

  let statsHtml = '<div class="admin-stat-row">' +
    '<div class="admin-stat-box"><div class="as-num">' + totalMembers + '</div><div class="as-label">总会员数</div></div>' +
    '<div class="admin-stat-box"><div class="as-num" style="color:#2E7D32">' + paidCount + '</div><div class="as-label">已付费</div></div>' +
    '<div class="admin-stat-box"><div class="as-num" style="color:#1976D2">' + trialCount + '</div><div class="as-label">体验中</div></div>' +
    '<div class="admin-stat-box"><div class="as-num" style="color:#E65100">' + unpaidCount + '</div><div class="as-label">已过期</div></div>' +
    '<div class="admin-stat-box"><div class="as-num" style="color:#C62828">' + bannedCount + '</div><div class="as-label">风险封禁</div></div>' +
    '<div class="admin-stat-box"><div class="as-num" style="color:#666">' + totalDevices + '</div><div class="as-label">设备记录</div></div>' +
    '</div>';

  // 刷新统计按钮
  statsHtml += '<div style="text-align:right;margin-bottom:10px">' +
    '<button class="admin-action-btn" style="background:#E3F2FD;color:#1976D2" onclick="renderAdminPanel()">🔄 刷新统计</button>' +
    '</div>';

  let tabsHtml = '<div class="admin-tabs">' +
    '<div class="admin-tab ' + (adminTab==='recharge'?'active':'') + '" onclick="adminTab=\'recharge\';renderAdminPanel()">💳 会员充值</div>' +
    '<div class="admin-tab ' + (adminTab==='members'?'active':'') + '" onclick="adminTab=\'members\';renderAdminPanel()">📋 用户清单</div>' +
    '<div class="admin-tab ' + (adminTab==='devices'?'active':'') + '" onclick="adminTab=\'devices\';renderAdminPanel()">📱 设备记录</div>' +
    '<div class="admin-tab ' + (adminTab==='qrcode'?'active':'') + '" onclick="adminTab=\'qrcode\';renderAdminPanel()">💰 收款二维码</div>' +
    '<div class="admin-tab ' + (adminTab==='risk'?'active':'') + '" onclick="adminTab=\'risk\';renderAdminPanel()">🚨 风险账号</div>' +
    '<div class="admin-tab ' + (adminTab==='config'?'active':'') + '" onclick="adminTab=\'config\';renderAdminPanel()">⚙️ 管理员配置</div>' +
    '</div>';

  let contentHtml = '';
  if(adminTab === 'recharge'){
    contentHtml = renderAdminRecharge();
  } else if(adminTab === 'members'){
    contentHtml = renderAdminMembers();
  } else if(adminTab === 'devices'){
    contentHtml = renderAdminDevices();
  } else if(adminTab === 'qrcode'){
    contentHtml = renderAdminQR();
  } else if(adminTab === 'risk'){
    contentHtml = renderAdminRisk();
  } else if(adminTab === 'config'){
    contentHtml = renderAdminConfig();
  }

  body.innerHTML = statsHtml + tabsHtml + contentHtml;
}

// ===== 会员充值功能 =====
function renderAdminRecharge(){
  return '<div style="max-width:520px;margin:0 auto">' +
    '<div style="font-size:16px;font-weight:700;color:#2c3e50;margin-bottom:16px">💳 会员充值 / 权限管理</div>' +
    '<div style="background:#fff;border:1px solid #e0e0e0;border-radius:12px;padding:20px;margin-bottom:16px">' +
      '<div style="font-size:14px;font-weight:600;margin-bottom:10px">📱 输入目标手机号</div>' +
      '<input type="text" id="rechargePhone" class="alm-input" placeholder="请输入11位手机号" autocomplete="off" ' +
        'style="text-align:left;margin-bottom:16px;font-size:16px;letter-spacing:1px" ' +
        'onkeydown="if(event.key===\'Enter\') adminRechargeLookup()">' +
      '<div id="rechargeResult" style="display:none">' +
        '<div style="border-top:1px solid #eee;padding-top:16px;margin-bottom:16px">' +
          '<div style="font-size:13px;color:#999;margin-bottom:8px">当前会员信息</div>' +
          '<div id="rechargeMemberInfo"></div>' +
        '</div>' +
        '<div style="font-size:13px;color:#999;margin-bottom:10px">选择权限操作：</div>' +
        '<div style="display:flex;flex-direction:column;gap:10px">' +
          '<button class="alm-confirm-btn" style="background:#2E7D32" onclick="adminRechargeAction(\'paid\')">✅ 开通永久已付费权限</button>' +
          '<button class="alm-confirm-btn" style="background:#C62828" onclick="adminRechargeAction(\'banned\')">🚫 标记为风险封禁</button>' +
          '<button class="alm-confirm-btn" style="background:#1976D2" onclick="adminRechargeAction(\'normal\')">🔓 恢复正常账号</button>' +
        '</div>' +
        '<div style="background:#FFF8E1;border-radius:8px;padding:12px;margin-top:14px;font-size:12px;color:#E65100;line-height:1.6">' +
          '<b>权限执行规则：</b><br>' +
          '· <b>开通永久已付费</b>：永久解锁全部功能，不受3天体验限制，遵守最多2台设备登录风控<br>' +
          '· <b>标记风险封禁</b>：账号禁止登录进入工作台<br>' +
          '· <b>恢复正常账号</b>：解除封禁限制，恢复为未付费状态' +
        '</div>' +
      '</div>' +
    '</div>' +
    '<div style="background:#E3F2FD;border-radius:10px;padding:14px;font-size:13px;color:#1565C0;line-height:1.7">' +
      '<b>账号体验硬性规则：</b><br>' +
      '① 全新手机号首次登录，自动发放3天免费体验<br>' +
      '② 3天体验周期结束，账号自动失效<br>' +
      '③ 体验到期账号<strong>无法登录工作台</strong>，不再提供任何免费体验<br>' +
      '④ 仅管理员后台主动开通【永久已付费权限】，到期账号才能恢复正常使用' +
    '</div>' +
  '</div>';
}

// 查找手机号并显示操作面板
function adminRechargeLookup(){
  const inp = document.getElementById('rechargePhone');
  if(!inp) return;
  const phone = inp.value.trim();
  if(!/^1[3-9]\d{9}$/.test(phone)){
    toast('请输入正确的11位手机号', 'red');
    return;
  }
  const m = findMember(phone);
  if(!m){
    toast('⚠️ 该手机号暂无注册记录', 'red');
    const result = document.getElementById('rechargeResult');
    if(result) result.style.display = 'none';
    return;
  }
  // 显示会员信息和操作面板
  const result = document.getElementById('rechargeResult');
  const info = document.getElementById('rechargeMemberInfo');
  const statusMap = {
    trial: {text:'体验中', cls:'st-trial'},
    paid: {text:'已付费', cls:'st-paid'},
    unpaid: {text:'已过期', cls:'st-unpaid'},
    banned: {text:'风险封禁', cls:'st-banned'}
  };
  const st = statusMap[m.status] || statusMap.unpaid;
  const trialDate = m.trialStartTime ? new Date(m.trialStartTime).toLocaleString('zh-CN',{year:'numeric',month:'2-digit',day:'2-digit'}) : '-';
  const payDate = m.purchaseTime ? new Date(m.purchaseTime).toLocaleString('zh-CN',{year:'numeric',month:'2-digit',day:'2-digit'}) : '-';
  const devCount = getDevicesByPhone(phone).length;
  info.innerHTML =
    '<div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">' +
      '<span style="font-size:16px;font-weight:600">' + phone + '</span>' +
      '<span class="st-badge ' + st.cls + '">' + st.text + '</span>' +
    '</div>' +
    '<div style="font-size:12px;color:#999;line-height:1.8">' +
      '体验起始：' + trialDate + ' <span style="color:#ddd">|</span> ' +
      '购买时间：' + payDate + ' <span style="color:#ddd">|</span> ' +
      '设备数：' + devCount + '台' +
      (m.bannedReason ? ' <span style="color:#ddd">|</span> 封禁原因：' + m.bannedReason : '') +
    '</div>';
  result.style.display = 'block';
}

// 执行充值/权限操作
function adminRechargeAction(action){
  const inp = document.getElementById('rechargePhone');
  if(!inp) return;
  const phone = inp.value.trim();
  const m = findMember(phone);
  if(!m){
    toast('⚠️ 该手机号暂无注册记录', 'red');
    return;
  }

  if(action === 'paid'){
    // 开通永久已付费权限
    m.status = 'paid';
    if(!m.orderId) m.orderId = 'ADMIN-' + Date.now().toString(36).toUpperCase();
    m.purchaseTime = Date.now();
    m.bannedReason = '';
    m.bannedTime = 0;
    // 清理多余设备，只保留最近2台
    const devs = getDevicesByPhone(phone).sort((a,b)=>b.lastLoginTime - a.lastLoginTime);
    if(devs.length > MAX_DEVICES){
      const toRemove = devs.slice(MAX_DEVICES);
      PERM.devices = PERM.devices.filter(d=> !toRemove.find(r=>r.deviceId===d.deviceId && r.phone===phone));
    }
    savePerm();
    toast('✅ ' + phone + ' 手机号会员权限修改成功');
  } else if(action === 'banned'){
    // 标记为风险封禁
    m.status = 'banned';
    m.bannedReason = '管理员手动封禁';
    m.bannedTime = Date.now();
    savePerm();
    toast('✅ ' + phone + ' 手机号会员权限修改成功');
  } else if(action === 'normal'){
    // 恢复正常账号（解除封禁，恢复为未付费状态）
    m.status = 'unpaid';
    m.bannedReason = '';
    m.bannedTime = 0;
    // 清理该手机号所有设备记录
    PERM.devices = PERM.devices.filter(d=>d.phone !== phone);
    savePerm();
    toast('✅ ' + phone + ' 手机号会员权限修改成功');
  }
  renderAdminPanel();
}

// 用户清单筛选状态
let adminFilterStatus = 'all';
let adminFilterPhone = '';

function renderAdminMembers(){
  if(!PERM.members.length) return '<div style="text-align:center;color:#999;padding:40px">暂无会员记录</div>';
  const statusMap = {
    trial: {text:'体验中', cls:'st-trial'},
    paid: {text:'已付费', cls:'st-paid'},
    unpaid: {text:'未付费', cls:'st-unpaid'},
    banned: {text:'风险封禁', cls:'st-banned'}
  };

  // 筛选栏
  let filterHtml = '<div style="display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap;align-items:center">' +
    '<input type="text" id="adminSearchPhone" placeholder="搜索手机号" value="' + adminFilterPhone + '" ' +
      'oninput="adminFilterPhone=this.value" ' +
      'onkeydown="if(event.key===\'Enter\')renderAdminPanel()" ' +
      'style="padding:8px 12px;border:1px solid #ddd;border-radius:8px;font-size:14px;width:160px">' +
    '<select id="adminFilterStatus" onchange="adminFilterStatus=this.value;renderAdminPanel()" style="padding:8px 12px;border:1px solid #ddd;border-radius:8px;font-size:14px">' +
      '<option value="all"' + (adminFilterStatus==='all'?' selected':'') + '>全部状态</option>' +
      '<option value="trial"' + (adminFilterStatus==='trial'?' selected':'') + '>体验中</option>' +
      '<option value="paid"' + (adminFilterStatus==='paid'?' selected':'') + '>已付费</option>' +
      '<option value="unpaid"' + (adminFilterStatus==='unpaid'?' selected':'') + '>未付费</option>' +
      '<option value="banned"' + (adminFilterStatus==='banned'?' selected':'') + '>风险封禁</option>' +
    '</select>' +
    '<button class="admin-action-btn" style="background:#E3F2FD;color:#1976D2" onclick="adminFilterPhone=\'\';adminFilterStatus=\'all\';renderAdminPanel()">重置</button>' +
    '<span style="font-size:12px;color:#999;margin-left:auto">共 ' + PERM.members.length + ' 条记录</span>' +
  '</div>';

  // 筛选数据
  let filtered = PERM.members.filter(m=>{
    if(adminFilterStatus !== 'all' && m.status !== adminFilterStatus) return false;
    if(adminFilterPhone && !m.phone.includes(adminFilterPhone.trim())) return false;
    return true;
  });

  if(!filtered.length){
    return filterHtml + '<div style="text-align:center;color:#999;padding:40px">无匹配记录</div>';
  }

  let rows = filtered.map(m=>{
    const st = statusMap[m.status] || statusMap.unpaid;
    const trialDate = m.trialStartTime ? new Date(m.trialStartTime).toLocaleString('zh-CN',{year:'numeric',month:'2-digit',day:'2-digit'}) : '-';
    const payDate = m.purchaseTime ? new Date(m.purchaseTime).toLocaleString('zh-CN',{year:'numeric',month:'2-digit',day:'2-digit'}) : '-';
    const devCount = getDevicesByPhone(m.phone).length;
    return '<tr>' +
      '<td>' + m.phone + '</td>' +
      '<td><span class="st-badge ' + st.cls + '">' + st.text + '</span></td>' +
      '<td>' + (m.orderId || '-') + '</td>' +
      '<td>' + payDate + '</td>' +
      '<td>' + trialDate + '</td>' +
      '<td>' + devCount + '</td>' +
      '<td>' + (m.note || '-') + '</td>' +
      '<td style="white-space:nowrap">' +
        '<select onchange="adminChangeStatus(\'' + m.phone + '\',this.value)" style="padding:4px 6px;border:1px solid #ddd;border-radius:6px;font-size:12px;margin-bottom:4px;width:100%">' +
          '<option value="">修改状态 ▾</option>' +
          '<option value="paid">→ 已付费</option>' +
          '<option value="unpaid">→ 未付费</option>' +
          '<option value="banned">→ 风险封禁</option>' +
        '</select>' +
        '<button class="admin-action-btn" style="background:#E3F2FD;color:#1976D2;width:100%" onclick="adminEditMember(\'' + m.phone + '\')">备注</button>' +
      '</td>' +
    '</tr>';
  }).join('');
  return filterHtml + '<table class="admin-table"><thead><tr>' +
    '<th>手机号</th><th>会员状态</th><th>订单号</th><th>购买时间</th><th>体验起始</th><th>设备数</th><th>备注</th><th>操作</th>' +
    '</tr></thead><tbody>' + rows + '</tbody></table>';
}

function adminChangeStatus(phone, newStatus){
  if(!newStatus) return;
  const m = findMember(phone);
  if(!m) return;
  const statusNames = {trial:'体验中', paid:'已付费', unpaid:'未付费', banned:'风险封禁'};
  if(newStatus === 'paid'){
    m.status = 'paid';
    if(!m.purchaseTime) m.purchaseTime = Date.now();
    m.bannedReason = '';
    m.bannedTime = 0;
    const devs = getDevicesByPhone(phone).sort((a,b)=>b.lastLoginTime - a.lastLoginTime);
    if(devs.length > MAX_DEVICES){
      const toRemove = devs.slice(MAX_DEVICES);
      PERM.devices = PERM.devices.filter(d=> !toRemove.find(r=>r.deviceId===d.deviceId && r.phone===phone));
    }
    toast('✅ ' + phone + ' 已开通永久权限');
  } else if(newStatus === 'banned'){
    m.status = 'banned';
    m.bannedReason = '管理员手动封禁';
    m.bannedTime = Date.now();
    toast('🚫 ' + phone + ' 已标记为风险封禁');
  } else {
    m.status = newStatus;
    if(newStatus === 'unpaid'){ m.bannedReason = ''; m.bannedTime = 0; }
    toast('已将 ' + phone + ' 修改为' + statusNames[newStatus]);
  }
  savePerm();
  renderAdminPanel();
}

function renderAdminDevices(){
  if(!PERM.devices.length) return '<div style="text-align:center;color:#999;padding:40px">暂无设备记录</div>';
  let rows = PERM.devices.map(d=>{
    const firstDate = new Date(d.firstLoginTime).toLocaleString('zh-CN');
    const lastDate = new Date(d.lastLoginTime).toLocaleString('zh-CN');
    return '<tr>' +
      '<td>' + d.phone + '</td>' +
      '<td style="font-family:monospace;font-size:12px">' + d.deviceId.slice(0,20) + '...</td>' +
      '<td>' + firstDate + '</td>' +
      '<td>' + lastDate + '</td>' +
      '<td><button class="admin-action-btn" style="background:#FFEBEE;color:#C62828" onclick="adminRemoveDevice(\'' + d.phone + '\',\'' + d.deviceId + '\')">移除</button></td>' +
    '</tr>';
  }).join('');
  return '<table class="admin-table"><thead><tr>' +
    '<th>手机号</th><th>设备标识</th><th>首次登录</th><th>最近登录</th><th>操作</th>' +
    '</tr></thead><tbody>' + rows + '</tbody></table>';
}

function renderAdminQR(){
  let qrHtml = '';
  if(PERM.payQRCode){
    qrHtml = '<div class="admin-qr-preview"><img src="' + PERM.payQRCode + '" alt="当前二维码"></div>';
  } else {
    qrHtml = '<div style="color:#999;text-align:center;padding:20px">尚未上传二维码</div>';
  }
  return '<div class="admin-qr-upload">' +
    '<div style="font-size:15px;font-weight:600;margin-bottom:10px">💰 收款二维码管理</div>' +
    '<div style="font-size:13px;color:#999;margin-bottom:12px">上传或更换付费收款二维码，用户付费弹窗将实时显示此图片</div>' +
    qrHtml +
    '<input type="file" accept="image/*" onchange="adminUploadQR(event)" style="margin:12px 0">' +
    '<div style="font-size:12px;color:#ccc">支持 JPG / PNG，建议正方形图片</div>' +
    (PERM.payQRCode ? '<button class="admin-action-btn" style="background:#FFEBEE;color:#C62828;margin-top:8px" onclick="adminClearQR()">删除二维码</button>' : '') +
    '</div>';
}

function renderAdminRisk(){
  const banned = PERM.members.filter(m=>m.status==='banned');
  if(!banned.length) return '<div style="text-align:center;color:#999;padding:40px">暂无风险账号</div>';
  let rows = banned.map(m=>{
    const banDate = m.bannedTime ? new Date(m.bannedTime).toLocaleString('zh-CN') : '-';
    return '<tr>' +
      '<td>' + m.phone + '</td>' +
      '<td>' + (m.bannedReason || '-') + '</td>' +
      '<td>' + banDate + '</td>' +
      '<td>' + getDevicesByPhone(m.phone).length + '台</td>' +
      '<td>' +
        '<button class="admin-action-btn" style="background:#E8F5E9;color:#2E7D32" onclick="adminUnban(\'' + m.phone + '\')">人工解封</button>' +
        '<button class="admin-action-btn" style="background:#E3F2BD;color:#1976D2" onclick="adminSetPaid(\'' + m.phone + '\')">直接开通</button>' +
      '</td>' +
    '</tr>';
  }).join('');
  return '<div style="font-size:13px;color:#E65100;margin-bottom:12px;background:#FFF8E1;padding:10px;border-radius:8px">⚠️ 以下账号因异常登录行为被自动封禁，管理员可人工解封或直接开通付费权限</div>' +
    '<table class="admin-table"><thead><tr>' +
    '<th>手机号</th><th>封禁原因</th><th>封禁时间</th><th>设备数</th><th>操作</th>' +
    '</tr></thead><tbody>' + rows + '</tbody></table>';
}

// 管理员操作函数
function adminSetPaid(phone){
  const m = findMember(phone);
  if(!m) return;
  m.status = 'paid';
  if(!m.orderId) m.orderId = 'ADMIN-' + Date.now().toString(36).toUpperCase();
  m.purchaseTime = Date.now();
  m.bannedReason = '';
  m.bannedTime = 0;
  // 清理多余设备，只保留最近2台
  const devs = getDevicesByPhone(phone).sort((a,b)=>b.lastLoginTime - a.lastLoginTime);
  if(devs.length > MAX_DEVICES){
    const toRemove = devs.slice(MAX_DEVICES);
    PERM.devices = PERM.devices.filter(d=> !toRemove.find(r=>r.deviceId===d.deviceId && r.phone===phone));
  }
  savePerm();
  toast('✅ 已为 ' + phone + ' 开通永久权限（限' + MAX_DEVICES + '台设备）');
  renderAdminPanel();
}

function adminEditMember(phone){
  const m = findMember(phone);
  if(!m) return;
  const newNote = prompt('编辑备注信息：', m.note || '');
  if(newNote === null) return;
  m.note = newNote.trim();
  savePerm();
  toast('已更新备注');
  renderAdminPanel();
}

function adminUnban(phone){
  const m = findMember(phone);
  if(!m) return;
  m.status = 'unpaid';
  m.bannedReason = '';
  m.bannedTime = 0;
  // 清理该手机号所有设备记录
  PERM.devices = PERM.devices.filter(d=>d.phone !== phone);
  savePerm();
  toast('✅ 已解封 ' + phone + '，设备记录已清空');
  renderAdminPanel();
}

function adminRemoveDevice(phone, deviceId){
  PERM.devices = PERM.devices.filter(d=> !(d.phone===phone && d.deviceId===deviceId));
  savePerm();
  toast('已移除设备');
  renderAdminPanel();
}

function adminUploadQR(event){
  const file = event.target.files[0];
  if(!file) return;
  if(file.size > 2*1024*1024){ toast('图片不能超过2MB', 'red'); return; }
  const reader = new FileReader();
  reader.onload = function(e){
    // 直接覆盖旧资源
    PERM.payQRCode = e.target.result;
    savePerm();
    // 同步刷新所有可能打开的弹窗中的二维码
    // 1. 付费弹窗
    if(document.getElementById('permPayModal').classList.contains('show')){
      renderPayQRCode('payQRContainer');
    }
    // 2. 用户充值弹窗
    var userModal = document.getElementById('userRechargeModal');
    if(userModal && userModal.style.display === 'flex'){
      renderPayQRCode('userRechargeQR');
    }
    // 3. 管理员后台二维码预览（renderAdminPanel会刷新）
    // 弹窗提示
    toast('✅ 收款二维码更新完成');
    renderAdminPanel();
  };
  reader.readAsDataURL(file);
}

function adminClearQR(){
  if(!confirm('确认删除当前收款二维码？删除后将恢复为默认收款码。')) return;
  // 恢复为默认二维码
  PERM.payQRCode = '';
  savePerm();
  // 兼容：清空后重新加载，loadPerm会用默认图填充
  loadPerm();
  savePerm();
  // 同步刷新所有可能打开的弹窗
  if(document.getElementById('permPayModal').classList.contains('show')){
    renderPayQRCode('payQRContainer');
  }
  var userModal = document.getElementById('userRechargeModal');
  if(userModal && userModal.style.display === 'flex'){
    renderPayQRCode('userRechargeQR');
  }
  toast('已恢复为默认收款二维码');
  renderAdminPanel();
}

// ===== 管理员配置表 =====
function renderAdminConfig(){
  return '<div style="max-width:460px;margin:0 auto">' +
    '<div style="font-size:16px;font-weight:700;color:#2c3e50;margin-bottom:16px">⚙️ 管理员配置表</div>' +
    '<div style="background:#f8f9fa;border-radius:12px;padding:20px;margin-bottom:16px">' +
      '<div style="font-size:13px;color:#999;margin-bottom:6px">当前管理员密码</div>' +
      '<div style="font-size:18px;font-weight:600;color:#2c3e50;font-family:monospace;letter-spacing:2px">' + PERM.adminPwd + '</div>' +
      '<div style="font-size:12px;color:#ccc;margin-top:6px">仅存储一条数据，请妥善保管</div>' +
    '</div>' +
    '<div style="background:#fff;border:1px solid #e0e0e0;border-radius:12px;padding:20px">' +
      '<div style="font-size:14px;font-weight:600;margin-bottom:12px">🔑 修改管理员密码</div>' +
      '<input type="password" id="newAdminPwd1" class="alm-input" placeholder="请输入新密码" autocomplete="off" style="text-align:left;margin-bottom:10px" oninput="adminPwdValidate()">' +
      '<input type="password" id="newAdminPwd2" class="alm-input" placeholder="请再次确认新密码" autocomplete="off" style="text-align:left;margin-bottom:8px" oninput="adminPwdValidate()">' +
      '<div id="adminPwdHint" style="font-size:12px;color:#999;margin-bottom:12px;min-height:18px"></div>' +
      '<button id="adminPwdConfirmBtn" class="alm-confirm-btn" style="width:100%;opacity:.4;pointer-events:none" onclick="adminChangePwd()">确认修改</button>' +
      '<div style="font-size:12px;color:#ccc;margin-top:10px">⚠️ 修改密码后需要使用新密码登录管理后台</div>' +
    '</div>' +
    '<div style="background:#FFF8E1;border-radius:10px;padding:14px;margin-top:16px;font-size:13px;color:#E65100;line-height:1.7">' +
      '<b>管理员配置说明：</b><br>' +
      '· 管理员配置表仅存储一条数据（管理员密码）<br>' +
      '· 无正确密码，任何人不能进入管理后台<br>' +
      '· 修改密码后立即生效，下次登录需使用新密码' +
    '</div>' +
  '</div>';
}

// 实时校验密码输入
function adminPwdValidate(){
  var inp1 = document.getElementById('newAdminPwd1');
  var inp2 = document.getElementById('newAdminPwd2');
  var hint = document.getElementById('adminPwdHint');
  var btn = document.getElementById('adminPwdConfirmBtn');
  if(!inp1 || !inp2 || !hint || !btn) return;

  var pwd1 = inp1.value;
  var pwd2 = inp2.value;

  // 两个都为空
  if(!pwd1 && !pwd2){
    hint.textContent = '';
    btn.style.opacity = '.4';
    btn.style.pointerEvents = 'none';
    return;
  }
  // 只有第一个有值
  if(pwd1 && !pwd2){
    if(pwd1.length < 4){
      hint.textContent = '密码至少4位';
      hint.style.color = '#E65100';
      btn.style.opacity = '.4';
      btn.style.pointerEvents = 'none';
    } else {
      hint.textContent = '请再次输入确认密码';
      hint.style.color = '#999';
      btn.style.opacity = '.4';
      btn.style.pointerEvents = 'none';
    }
    return;
  }
  // 两个都有值但不一致
  if(pwd1 !== pwd2){
    hint.textContent = '⚠️ 两次密码输入不一致，请核对';
    hint.style.color = '#C62828';
    btn.style.opacity = '.4';
    btn.style.pointerEvents = 'none';
    return;
  }
  // 一致但太短
  if(pwd1.length < 4){
    hint.textContent = '密码至少4位';
    hint.style.color = '#E65100';
    btn.style.opacity = '.4';
    btn.style.pointerEvents = 'none';
    return;
  }
  // 校验通过
  hint.textContent = '✅ 密码一致，可以修改';
  hint.style.color = '#2E7D32';
  btn.style.opacity = '1';
  btn.style.pointerEvents = 'auto';
}

function adminChangePwd(){
  var inp1 = document.getElementById('newAdminPwd1');
  var inp2 = document.getElementById('newAdminPwd2');
  var pwd1 = inp1 ? inp1.value.trim() : '';
  var pwd2 = inp2 ? inp2.value.trim() : '';
  if(!pwd1 || !pwd2){
    toast('请输入新密码并确认', 'orange');
    return;
  }
  if(pwd1.length < 4){
    toast('密码至少4位', 'orange');
    return;
  }
  if(pwd1 !== pwd2){
    toast('两次密码输入不一致，请核对', 'red');
    return;
  }
  PERM.adminPwd = pwd1;
  savePerm();
  // 成功弹窗提示
  showAdminPwdSuccessModal();
  renderAdminPanel();
}

// 密码修改成功弹窗
function showAdminPwdSuccessModal(){
  var overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:10003;display:flex;align-items:center;justify-content:center;padding:20px';
  overlay.innerHTML = '<div style="background:#fff;border-radius:16px;padding:32px 28px 24px;width:320px;max-width:90vw;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,.2)">' +
    '<div style="font-size:48px;margin-bottom:12px">✅</div>' +
    '<div style="font-size:17px;font-weight:700;color:#2c3e50;margin-bottom:8px">管理员密码更新成功</div>' +
    '<div style="font-size:14px;color:#666;margin-bottom:20px">请妥善保管新密码</div>' +
    '<button onclick="this.parentElement.parentElement.remove()" style="width:100%;padding:12px;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:10px;font-size:15px;font-weight:600;cursor:pointer">我知道了</button>' +
  '</div>';
  document.body.appendChild(overlay);
}

